    "Sends each acknowledgement twice, so fewer of your contacts' messages show as not delivered. A little more airtime." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé potvrzení se posílá dvakrát, takže se méně zpráv vašich kontaktů zobrazí jako nedoručené. O něco víc vysílacího času."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyła każde potwierdzenie dwa razy, dzięki czemu mniej wiadomości od twoich kontaktów pokazuje się jako niedostarczone. Nieco więcej czasu nadawania."
          }
        }
      }
    },
