    "Up to %lld dBm on this radio. Lower saves battery and is kinder to neighbours; keep within your country's limit (in the EU, 27 dBm ERP on 869.4–869.65 MHz)." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tomto rádiu až %lld dBm. Nižší výkon šetří baterii a je ohleduplnější k sousedům; dodržujte limit své země (v EU 27 dBm ERP v pásmu 869,4–869,65 MHz)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tym radiu do %lld dBm. Niższa moc oszczędza baterię i mniej przeszkadza sąsiadom; trzymaj się limitu w swoim kraju (w UE 27 dBm ERP w paśmie 869,4–869,65 MHz)."
          }
        }
      }
    },
