    "Your radio adds %@ it hears by itself, so they come back with their next advert. Choose what it adds in Mesh behaviour." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše rádio samo přidává %@, které slyší, takže se vrátí s příštím advertem. Co přidává, zvolíte v Chování mesh sítě."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radio samo dodaje %@, gdy je usłyszy, więc wrócą po swoim następnym advercie. Wybierz, co dodaje, w Zachowaniu w sieci mesh."
          }
        }
      }
    },
    "Your radio adds new nodes heard at any distance, so far ones come back with their next advert." : {
      "localizations" : {
        "cs" : {
