@@ -0,0 +1,2932 @@
+// See WebUi.h. MeshChat on the radio: built-in companion app + history + HTTP/WebSocket API.
+#ifdef WEB_UI
+#include "WebUi.h"
+#include "MyMesh.h"
+#include "NodePrefs.h"
+#ifdef WIFI_PORTAL
+  #include "WifiPortal.h"
+#endif
+#include <Arduino.h>
+#include <ArduinoJson.h>
+#include <AsyncJson.h>
+#include <AsyncTCP.h>
+#include <ESPAsyncWebServer.h>
+#include <HTTPClient.h>
+#include <WiFiClientSecure.h>
+#include <SPIFFS.h>
+#include <Update.h>
+#include <esp_ota_ops.h>
+#include <Utils.h>
+#include <WiFi.h>
+#include <esp_heap_caps.h>
+#include <time.h>
+#include <algorithm>
+#include <deque>
+#include <memory>
+#include "WebUiAssets.h"
+#include "PublicCa.h"
+#include <esp32s3/rom/miniz.h>   // tinfl (inflate) is in the S3 ROM
+
+#ifndef WEBUI_HOME_LAT
+  #define WEBUI_HOME_LAT 0.0
+  #define WEBUI_HOME_LON 0.0
+#endif
+
+namespace webui {
+namespace {
+
+// ---------------------------------------------------------------- limits
+const int MAX_MSGS = 2000;          // kept in PSRAM, persisted to flash
+const int MAX_PKTS = 3000;          // RX log, PSRAM only (the browser derives repeater stats from it)
+const int MAX_HEARD = 400;
+const int RF_RING = 48;             // recent decrypted channel packets, to attach routes/SNR
+const size_t HIST_FILE_CAP = 160 * 1024;   // two rotating files -> at most ~320 KB on flash
+const uint32_t CHAN_RETRY_WAIT = 8000;
+const int MAX_TEXT = 150;
+
+// companion protocol codes (see MyMesh.cpp)
+enum : uint8_t {
+  CMD_SEND_TXT_MSG = 2, CMD_SEND_CHANNEL_TXT_MSG = 3, CMD_SET_DEVICE_TIME = 6, CMD_SEND_SELF_ADVERT = 7,
+  CMD_SET_ADVERT_NAME = 8, CMD_ADD_UPDATE_CONTACT = 9, CMD_SET_RADIO_PARAMS = 11, CMD_SYNC_NEXT_MESSAGE = 10, CMD_RESET_PATH = 13, CMD_DEVICE_QUERY = 22, CMD_SEND_LOGIN = 26,
+  CMD_SEND_STATUS_REQ = 27, CMD_LOGOUT = 29, CMD_SET_CHANNEL = 32, CMD_SEND_BINARY_REQ = 50,
+  RESP_OK = 0, RESP_ERR = 1, RESP_SENT = 6, RESP_CONTACT_MSG = 7, RESP_CHANNEL_MSG = 8, RESP_NO_MORE = 10,
+  RESP_CONTACT_MSG_V3 = 16, RESP_CHANNEL_MSG_V3 = 17,
+  PUSH_ADVERT = 0x80, PUSH_PATH = 0x81, PUSH_ACK = 0x82, PUSH_WAITING = 0x83, PUSH_LOGIN_OK = 0x85, PUSH_LOGIN_FAIL = 0x86,
+  PUSH_STATUS = 0x87, PUSH_RX_LOG = 0x88, PUSH_NEW_ADVERT = 0x8A, PUSH_BINARY = 0x8C,
+};
+enum Kind : uint8_t { K_NONE, K_SEND_DM, K_SEND_CH, K_NAME, K_CHANNEL, K_ADVERT, K_QUERY, K_RADIO, K_OTHER, K_CONTACT, K_CLI };
+enum : uint8_t { ST_RECEIVED, ST_SENDING, ST_SENT, ST_REPEATED, ST_NOT_HEARD, ST_DELIVERED, ST_NO_ACK, ST_FAILED };
+const char* ST_NAME[] = {"received", "sending", "sent", "repeated", "not heard", "delivered", "no ack", "failed"};
+const char* TYPE_NAME[] = {"unknown", "companion", "repeater", "room", "sensor"};
+const char* PKT_NAME[16] = {"REQ", "RESPONSE", "TXT_MSG", "ACK", "ADVERT", "GRP_TXT", "GRP_DATA", "ANON_REQ",
+                            "PATH", "TRACE", "MULTIPART", "CONTROL", "UNK12", "UNK13", "UNK14", "RAW_CUSTOM"};
+const char* ROUTE_NAME[4] = {"TRANSPORT_FLOOD", "FLOOD", "DIRECT", "TRANSPORT_DIRECT"};
+
+// ---------------------------------------------------------------- data
+struct Msg {
+  uint32_t id, ts, sender_ts;
+  uint8_t kind, chan, dir;          // kind 0 = channel, 1 = DM; dir 0 = in, 1 = out
+  int8_t hops;                      // -1 unknown
+  uint8_t key[32];                  // DM peer
+  uint8_t hash_size, path_n, path[32];
+  int16_t snr4, rssi;               // rssi 0 = unknown
+  uint8_t status, repeats, attempts, has_rf;
+  uint32_t acks[3], retry_at;
+  char sender[32];
+  char text[MAX_TEXT + 18];
+  uint16_t net;                     // the network (radio settings) it was on: channels are kept per network
+  uint8_t deleted;                  // deleted by the user: kept out of every view (the record says so in flash)
+  uint32_t fp;                      // its packet's fingerprint (payloadFp), shared by every copy heard; 0 unknown
+  // our DMs: per try, bit k = it went out by flood, bit 4+k = we saw it go out (older records: none);
+  // which try the ACK answered, and the radio's round trip for it
+  uint8_t flood_mask, ack_try; uint32_t rtt_ms;
+  uint8_t author[4], has_author;    // room posts: the first bytes of the author's key
+};
+struct Pkt {
+  uint32_t id, ts;
+  uint8_t route, type, hops, hash_size, path_n, path[32];
+  int16_t snr4;
+  int8_t rssi;
+  uint8_t node_type;                // adverts
+  char name[32];                    // advert name / channel name
+  char key[13];                     // advert key prefix / private channel hash
+  uint16_t net;
+  uint32_t fp, ms;                  // payload fingerprint (the same on every copy); millis() when heard
+  uint8_t raw_len, raw[255];        // the packet as received: header, transport codes, path, payload
+};
+struct Heard {
+  uint8_t key[32];
+  char name[32];
+  uint8_t type, has_loc, hops, hash_size, path_n, path[32];
+  int32_t lat, lon;                 // 1e-6 degrees
+  uint32_t first, last, count;
+  int16_t snr4;
+  int8_t rssi;
+  uint16_t net;                     // heard on this network (the map shows the current one's)
+};
+struct Rf { uint32_t h, at, ts, fp; uint8_t hops, hash_size, path_n, path[32]; int16_t snr4; int8_t rssi; };
+struct ChanInfo { uint8_t idx, hash; uint8_t secret[32]; char name[32]; };
+struct Cmd { uint8_t buf[MAX_FRAME_SIZE]; uint8_t len; Kind kind; uint32_t ctx; };
+enum ActType : uint8_t { A_SEND, A_RESEND, A_ADVERT, A_NAME, A_CH_SET, A_TIME, A_HOSTNAME, A_JOIN, A_PIN, A_HOME, A_REBOOT, A_QUERY, A_RADIO, A_NET_ADD, A_NET_REMOVE, A_NET_PREFER, A_DELETE, A_DELETE_CONV, A_CONTACT_ADD, A_RESET_PATH, A_ROOM_LEAVE, A_CLI };
