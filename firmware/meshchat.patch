 #endif
 }
 
+// Contacts and channels are rewritten whole on every change (contacts 5 s after any advert
+// updates one). Written in place, a reset or power cut mid-write cut the file short, and every
+// contact after that point was gone on the next boot. On ESP32 (MeshChat) they're written to a
+// side file and swapped in once complete; an interrupted swap is finished at the next load.
+#if defined(ESP32)
+  #define SAFE_SWAP 1
+#endif
+
+static String sideName(const char* filename) { return String(filename) + ".new"; }
+
+static File openWriteSafe(FILESYSTEM* fs, const char* filename) {
+#ifdef SAFE_SWAP
+  return openWrite(fs, sideName(filename).c_str());
+#else
+  return openWrite(fs, filename);
+#endif
+}
+
+static void commitSafe(FILESYSTEM* fs, const char* filename, File& file, bool ok) {
+  file.close();
+#ifdef SAFE_SWAP
+  String side = sideName(filename);
+  if (!ok) { fs->remove(side.c_str()); return; }   // keep the last good file
+  fs->remove(filename);
+  fs->rename(side.c_str(), filename);              // if this is cut short, recoverSafe() finishes it
+#endif
+}
+
+// Before reading: the main file wins while it exists (a side file next to it may be half-written);
+// a side file alone means the swap was interrupted after the old file was removed: finish it.
+static void recoverSafe(FILESYSTEM* fs, const char* filename) {
+#ifdef SAFE_SWAP
+  String side = sideName(filename);
+  if (!fs->exists(side.c_str())) return;
+  if (fs->exists(filename)) fs->remove(side.c_str());
+  else fs->rename(side.c_str(), filename);
+#endif
+}
+
