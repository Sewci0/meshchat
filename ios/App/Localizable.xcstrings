    "No saved route. The next message floods: every repeater that hears it passes it on once, and %@'s answer brings back the path it took." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádná uložená trasa. Další zpráva půjde floodem: každý repeater, který ji uslyší, ji jednou předá dál, a odpověď (%@) přinese zpět cestu, kterou prošla."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak zapisanej trasy. Następna wiadomość pójdzie floodem: każdy repeater, który ją usłyszy, przekaże ją raz, a odpowiedź (od: %@) przyniesie ścieżkę, którą przeszła."
          }
        }
      }
    },
