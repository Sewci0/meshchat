            "state" : "translated",
            "value" : "Szerokość pasma musi mieścić się między 7 a 500 kHz."
          }
        }
      }
    },
    "The broadcast didn't go out (%@). Pinging instead." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broadcast se neodeslal (%@). Místo něj se použije ping."
