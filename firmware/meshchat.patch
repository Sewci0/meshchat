+// ---------------------------------------------------------------- listening to channels we haven't joined
+// A hashtag channel's key is derived from its name, so the radio can read any channel whose name
+// it knows, without using one of MeshCore's channel slots (and without being able to send there:
+// that needs joining). Names come from the user and from a list of channels known to be used in
+// Poland, tried against every channel packet we can't read. Unreadable channels (private ones,
+// unknown names) are only counted, by their 1-byte channel hash.
+const int MAX_WATCH = 48;
+void recordListened(const char* name, uint8_t* plain, int dl, uint8_t hops, uint8_t hs, const uint8_t* path, uint8_t path_n,
+                    int16_t snr4, int8_t rssi, uint32_t heard_at, uint32_t fp);   // below, next to onRxLog
+struct Watch { char name[32]; uint8_t secret[32]; uint8_t hash, used, found; uint32_t count, last; };
+struct ChanStat { uint32_t count, last; };
+struct Cand { uint8_t secret[32]; uint8_t hash; };
+Watch* watches = nullptr;            // PSRAM
+// The latest unreadable channel packets, so a name added later is checked at once (and its
+// messages shown), and so names can be searched for offline.
+const int MAX_SAMPLES = 128;
+struct Sample { uint32_t ts; int16_t snr4; int8_t rssi; uint8_t used, len, hops, hs, path_n, path[32], pay[184]; };
+Sample* samples = nullptr; int sample_head = 0;
+ChanStat* chan_stats = nullptr;      // [256], by channel hash
+Cand* cands = nullptr;
+// Seen on Polish lists (forum, MeshCore Polska, Wielkopolska) plus likely regional and topical names.
+const char* const CANDIDATES[] = {
+  "#polska", "#bot", "#tech", "#hamradio", "#info", "#pogoda", "#sos", "#emergency", "#pomoc", "#help", "#random",
+  "#offtopic", "#off-topic", "#chat", "#ping", "#echo", "#meshcore", "#mesh", "#lora", "#repeater", "#repeatery",
+  "#test2", "#testy", "#ds-test", "#bots", "#news", "#ogolny", "#general", "#lokalny", "#local", "#nocna", "#sp",
+  "#aprs", "#sar", "#osp", "#ratownictwo", "#gory", "#hiking", "#rower", "#drony", "#dev", "#firmware", "#solar",
+  "#antena", "#anteny", "#slask", "#slaskie", "#silesia", "#gornyslask", "#katowice", "#gliwice", "#zabrze",
+  "#bytom", "#sosnowiec", "#tychy", "#bielsko", "#rybnik", "#opole", "#opolskie", "#czestochowa", "#cz-wa", "#jura",
+  "#zawiercie", "#myszkow", "#lubliniec", "#klobuck", "#radomsko", "#krakow", "#malopolska", "#malopolskie",
+  "#tatry", "#zakopane", "#podhale", "#beskidy", "#tarnow", "#rzeszow", "#podkarpacie", "#kielce", "#swietokrzyskie",
+  "#lodz", "#lodzkie", "#warszawa", "#waw", "#mazowsze", "#mazowieckie", "#wroclaw", "#wroc-tech", "#legnica",
+  "#dolnoslaskie", "#wlkp", "#poznan", "#bydgoszcz", "#torun", "#kujawy", "#gdansk", "#trojmiasto", "#pomorze",
+  "#szczecin", "#zachod", "#wschod", "#poludnie", "#polnoc", "#lublin", "#lubelskie", "#bialystok", "#podlasie",
+  "#warmia", "#mazury", "#lubuskie", "#czechy", "#cz", "#sk", "#slovakia", "#ukraina", "#de",
+  "#testing", "#jokes", "#sports", "#pixels", "#weather", "#traffic", "#ham", "#memes", "#music", "#games",
+};
+const int CAND_COUNT = sizeof(CANDIDATES) / sizeof(CANDIDATES[0]);
+
+void hashtagKey(const char* name, uint8_t* secret, uint8_t& hash) {
+  uint8_t h[32];
+  memset(secret, 0, 32);
+  mesh::Utils::sha256(h, 32, (const uint8_t*)name, strlen(name));
+  memcpy(secret, h, 16);
+  mesh::Utils::sha256(h, 32, secret, 16);
+  hash = h[0];
+}
+bool validChannelName(const char* s) {
+  size_t n = strlen(s);
+  if (n < 2 || n > 31 || s[0] != '#') return false;
+  for (size_t i = 1; i < n; i++) if ((uint8_t)s[i] <= 0x20 || s[i] == '"' || s[i] == '\\' || s[i] == '/') return false;
+  return true;
+}
+Watch* findWatch(const char* name) {
+  for (int i = 0; i < MAX_WATCH; i++) if (watches[i].used && strcmp(watches[i].name, name) == 0) return &watches[i];
+  return nullptr;
+}
+void saveWatches() {
+  Buf b;
+  b.raw("[");
+  bool first = true;
+  for (int i = 0; i < MAX_WATCH; i++) {
+    if (!watches[i].used) continue;
+    b.raw(first ? "{\"n\":" : ",{\"n\":"); first = false;
+    b.str(watches[i].name);
+    b.f(",\"f\":%u}", watches[i].found);
+  }
+  b.raw("]\n");
+  File f = SPIFFS.open("/wu_watch.json", FILE_WRITE);
+  if (f) { f.write((const uint8_t*)b.p, b.n); f.close(); }
+}
+Watch* addWatch(const char* name, bool found) {   // under Lock
+  Watch* w = findWatch(name);
+  if (w) return w;
+  for (int i = 0; i < chan_count; i++) if (strcmp(chans[i].name, name) == 0) return nullptr;   // already joined
+  for (int i = 0; i < MAX_WATCH && !w; i++) if (!watches[i].used) w = &watches[i];
+  if (!w) return nullptr;
+  memset(w, 0, sizeof(*w));
+  strlcpy(w->name, name, sizeof(w->name));
+  hashtagKey(w->name, w->secret, w->hash);
+  w->used = 1; w->found = found;
+  return w;
+}
+void loadWatches() {
+  watches = (Watch*)palloc(sizeof(Watch) * MAX_WATCH);
+  chan_stats = (ChanStat*)palloc(sizeof(ChanStat) * 256);
+  cands = (Cand*)palloc(sizeof(Cand) * CAND_COUNT);
+  samples = (Sample*)palloc(sizeof(Sample) * MAX_SAMPLES);
+  for (int i = 0; i < CAND_COUNT; i++) hashtagKey(CANDIDATES[i], cands[i].secret, cands[i].hash);
+  // open() of a missing file still returns a usable-looking handle on this core: check first
+  if (!SPIFFS.exists("/wu_watch.json")) { addWatch("#polska", false); addWatch("#bot", false); saveWatches(); return; }   // national channels
+  File f = SPIFFS.open("/wu_watch.json");
+  if (!f) return;
+  JsonDocument doc;
+  if (!deserializeJson(doc, f)) for (JsonObject o : doc.as<JsonArray>()) { const char* n = o["n"] | ""; if (validChannelName(n)) addWatch(n, o["f"] | 0); }
+  f.close();
+}
+void emitListening() { Buf b; b.raw("\"listening\""); broadcast("stale", b); }
+
+// A channel packet none of our joined channels could read (under Lock, in onRxLog).
+const char* tryListening(const uint8_t* pay, size_t plen, uint8_t* plain, int& dl, const Pkt* p) {
+  uint8_t h = pay[0];
+  for (int i = 0; i < MAX_WATCH; i++) {
+    Watch& w = watches[i];
+    if (!w.used || w.hash != h) continue;
+    dl = mesh::Utils::MACThenDecrypt(w.secret, plain, pay + 1, plen - 1);
+    if (dl > 5) { w.count++; w.last = wallNow(); return w.name; }
+  }
+  for (int i = 0; i < CAND_COUNT; i++) {   // a channel we didn't know about?
+    if (cands[i].hash != h) continue;
+    dl = mesh::Utils::MACThenDecrypt(cands[i].secret, plain, pay + 1, plen - 1);
+    if (dl <= 5) continue;
+    Watch* w = addWatch(CANDIDATES[i], true);
+    if (!w) return nullptr;
+    w->count = 1; w->last = wallNow();
+    saveWatches();
+    emitListening();
+    return w->name;
+  }
+  ChanStat& s = chan_stats[h];
+  s.count++; s.last = wallNow();
+  if (plen <= sizeof(Sample::pay)) {
+    Sample& x = samples[sample_head]; sample_head = (sample_head + 1) % MAX_SAMPLES;
+    x.used = 1; x.ts = p->ts; x.snr4 = p->snr4; x.rssi = p->rssi; x.len = plen; memcpy(x.pay, pay, plen);
+    x.hops = p->hops; x.hs = p->hash_size; x.path_n = p->path_n; memcpy(x.path, p->path, p->path_n);
+  }
+  return nullptr;
+}
+
+// A name was just added: read the stored packets it can decrypt (under Lock). Returns how many.
+int replaySamples(Watch* w) {
+  int n = 0;
+  for (int i = 0; i < MAX_SAMPLES; i++) {
+    Sample& x = samples[i];
+    if (!x.used || x.pay[0] != w->hash) continue;
+    uint8_t plain[MAX_FRAME_SIZE + 16];
+    int dl = mesh::Utils::MACThenDecrypt(w->secret, plain, x.pay + 1, x.len - 1);
+    if (dl <= 5) continue;
+    plain[dl < (int)sizeof(plain) ? dl : (int)sizeof(plain) - 1] = 0;
+    recordListened(w->name, plain, dl, x.hops, x.hs, x.path, x.path_n, x.snr4, x.rssi, x.ts, payloadFp(x.pay, x.len));
+    x.used = 0;
+    if (chan_stats[w->hash].count) chan_stats[w->hash].count--;
+    w->count++; if (x.ts > w->last) w->last = x.ts;
+    n++;
+  }
+  return n;
+}
+
+void recordListened(const char* name, uint8_t* plain, int dl, uint8_t hops, uint8_t hs, const uint8_t* path, uint8_t path_n,
+                    int16_t snr4, int8_t rssi, uint32_t heard_at, uint32_t fp) {
+  if (dl < 6) return;
+  uint32_t ts; memcpy(&ts, plain, 4);
+  char full[MAX_TEXT + 40];
+  copyText(full, sizeof(full), plain + 5, dl - 5);
+  const char* sep = strstr(full, ": ");
+  char sender[32] = {0};
+  const char* text = full;
+  if (sep && sep - full < 32) { memcpy(sender, full, sep - full); text = sep + 2; }
+  uint8_t key[32] = {0};
+  strlcpy((char*)key, name, sizeof(key));
+  if (seenAlready(2, 0, key, ts, text)) return;   // the same message via another repeater
+  Msg* m = newMsg();
+  m->ts = heard_at;
+  m->sender_ts = ts; m->kind = 2; m->dir = 0; memcpy(m->key, key, 32);
+  m->hops = hops; m->hash_size = hs; m->path_n = path_n; memcpy(m->path, path, path_n);
+  m->snr4 = snr4; m->rssi = rssi; m->has_rf = 1; m->fp = fp;
+  m->status = ST_RECEIVED;
+  strlcpy(m->sender, sender, sizeof(m->sender));
+  strlcpy(m->text, text, sizeof(m->text));
+  persistMsg(m);
+  emitMsg(m);
+}
+
+// One heard packet as JSON, for /api/packets and the live feed alike. "info" is itself JSON in a
+// string, as the Python server sends it.
+void pktJson(Buf& b, const Pkt* p) {
+  b.f("{\"id\":%u,\"ts\":%u,\"route\":\"%s\",\"type\":\"%s\",\"hops\":%u,\"path\":", p->id, p->ts, ROUTE_NAME[p->route], PKT_NAME[p->type], p->hops);
+  b.hex(p->path, p->path_n);
+  b.f(",\"hash_size\":%u,\"snr\":%.2f,\"rssi\":%d,\"info\":", p->hash_size, p->snr4 / 4.0, p->rssi);
+  Buf info;
+  if (p->type == 4) { info.raw("{\"name\":"); info.str(p->name); info.f(",\"node_type\":\"%s\",\"key\":\"%s\"}", TYPE_NAME[p->node_type <= 4 ? p->node_type : 0], p->key); }
+  else if (p->type == 5 && p->name[0]) { info.raw("{\"channel\":"); info.str(p->name); info.raw("}"); }
+  else if (p->type == 5) info.f("{\"channel_hash\":\"%s\"}", p->key);
+  else info.raw("{}");
+  b.str(info.p ? info.p : "{}");
+  b.raw("}");
+}
+
+void onRxLog(const uint8_t* f, size_t len) {
+  if (len < 5) return;
+  int16_t snr4 = (int8_t)f[1];
+  int8_t rssi = (int8_t)f[2];
+  const uint8_t* r = f + 3;
+  size_t n = len - 3, i = 1;
+  uint8_t route = r[0] & 3, type = (r[0] >> 2) & 0xF;
+  if (route == 0 || route == 3) i += 4;
+  if (i >= n) return;
+  uint8_t pl = r[i++];
+  uint8_t hs = (pl >> 6) + 1, hops = pl & 0x3F;
+  size_t pbytes = (size_t)hops * hs;
+  if (i + pbytes > n) return;
+  const uint8_t* path = &r[i];
+  i += pbytes;
+  const uint8_t* pay = &r[i];
+  size_t plen = n - i;
+
+  Lock l;
+  Pkt* p = &pkts[pkt_head];
+  memset(p, 0, sizeof(*p));
+  pkt_head = (pkt_head + 1) % MAX_PKTS;
+  if (pkt_count < MAX_PKTS) pkt_count++;
+  p->id = next_pkt_id++; p->ts = wallNow();
+  p->route = route; p->type = type; p->hops = hops; p->hash_size = hs;
+  p->path_n = pbytes > 32 ? 32 : pbytes; memcpy(p->path, path, p->path_n);
+  p->snr4 = snr4; p->rssi = rssi; p->net = curNet();
+  p->fp = payloadFp(pay, plen); p->ms = millis();
+  p->raw_len = n > sizeof(p->raw) ? sizeof(p->raw) : n; memcpy(p->raw, r, p->raw_len);
+
+  if (type == 4 && plen >= 101) {   // ADVERT: key, ts, sig, app data
+    const uint8_t* key = pay;
+    const uint8_t* app = pay + 100;
+    size_t alen = plen - 100, j = 1;
+    uint8_t flags = app[0];
+    int32_t lat = 0, lon = 0;
+    bool loc = false;
+    if ((flags & 0x10) && alen >= j + 8) { memcpy(&lat, &app[j], 4); memcpy(&lon, &app[j + 4], 4); j += 8; loc = lat || lon; }
+    if (flags & 0x20) j += 2;
+    if (flags & 0x40) j += 2;
+    char name[32] = {0};
+    if ((flags & 0x80) && alen > j) copyText(name, sizeof(name), &app[j], alen - j);
+    p->node_type = flags & 0x0F;
+    strlcpy(p->name, name, sizeof(p->name));
+    hexLower(p->key, key, 6);
+    Heard* hd = nullptr;
+    for (int k = 0; k < heard_count; k++) if (memcmp(heard[k].key, key, 32) == 0) { hd = &heard[k]; break; }
+    if (!hd) {
+      if (heard_count < MAX_HEARD) hd = &heard[heard_count++];
+      else { hd = &heard[0]; for (int k = 1; k < heard_count; k++) if (heard[k].last < hd->last) hd = &heard[k]; }
+      memset(hd, 0, sizeof(*hd));
+      memcpy(hd->key, key, 32);
+      hd->first = p->ts;
+    }
+    if (name[0]) strlcpy(hd->name, name, sizeof(hd->name));
+    hd->type = flags & 0x0F;
+    if (loc) { hd->lat = lat; hd->lon = lon; hd->has_loc = 1; }
+    hd->last = p->ts; hd->count++; hd->snr4 = snr4; hd->rssi = rssi; hd->hops = hops; hd->hash_size = hs; hd->net = curNet();
+    hd->path_n = p->path_n; memcpy(hd->path, p->path, p->path_n);
+    Buf b;
+    b.raw("{\"pubkey\":"); b.hex(hd->key, 32);
+    b.raw(",\"name\":"); b.str(hd->name);
+    b.f(",\"type\":%u,\"lat\":", hd->type);
+    if (hd->has_loc) b.f("%.6f,\"lon\":%.6f", hd->lat / 1e6, hd->lon / 1e6); else b.raw("null,\"lon\":null");
+    b.f(",\"first_heard\":%u,\"last_heard\":%u,\"snr\":%.2f,\"rssi\":%d,\"hops\":%u,\"path\":", hd->first, hd->last, hd->snr4 / 4.0, hd->rssi, hd->hops);
+    b.hex(hd->path, hd->path_n);
+    b.f(",\"hash_size\":%u,\"count\":%u}", hd->hash_size, hd->count);
+    broadcast("heard", b);
+  } else if (type == 5 && plen >= 3) {   // GRP_TXT: try our channels
+    snprintf(p->key, sizeof(p->key), "%02x", pay[0]);
+    for (int k = 0; k < chan_count; k++) {
+      if (chans[k].hash != pay[0]) continue;
+      uint8_t plain[MAX_FRAME_SIZE + 16];
+      int dl = mesh::Utils::MACThenDecrypt(chans[k].secret, plain, pay + 1, plen - 1);
+      if (dl <= 5) continue;
+      plain[dl < (int)sizeof(plain) ? dl : (int)sizeof(plain) - 1] = 0;
+      strlcpy(p->name, chans[k].name, sizeof(p->name));
+      uint32_t ts; memcpy(&ts, plain, 4);
+      const char* full = (const char*)&plain[5];
+      Rf& x = rf[rf_head]; rf_head = (rf_head + 1) % RF_RING;
+      x.h = fnv(ts, full); x.ts = ts; x.at = millis(); x.fp = p->fp; x.hops = hops; x.hash_size = hs; x.path_n = p->path_n;
+      memcpy(x.path, p->path, p->path_n); x.snr4 = snr4; x.rssi = rssi;
+      // one of ours coming back from a repeater?
+      for (int q = msg_count - 1, seen = 0; q >= 0 && seen < 50; q--, seen++) {
+        Msg* m = msgAt(q);
+        if (m->dir != 1 || m->kind != 0 || m->chan != chans[k].idx || m->sender_ts != ts) continue;
+        char mine[MAX_TEXT + 40];
+        snprintf(mine, sizeof(mine), "%s: %s", mesh->getNodePrefs()->node_name, m->text);
+        if (strcmp(mine, full) != 0) continue;
+        m->repeats++;
+        m->status = ST_REPEATED;
+        if (!m->fp) m->fp = p->fp;
+        if (!m->path_n) { m->path_n = p->path_n; memcpy(m->path, p->path, p->path_n); m->hash_size = hs; m->hops = hops; }
+        m->snr4 = snr4; m->rssi = rssi; m->has_rf = 1;
+        persistUpdate(m);
+        emitMsg(m);
+        break;
+      }
+      break;
+    }
+    if (!p->name[0]) {   // not one of ours: a channel we listen to, or one we can only count
+      uint8_t plain[MAX_FRAME_SIZE + 16];
+      int dl = 0;
+      const char* nm = tryListening(pay, plen, plain, dl, p);
+      if (nm) {
+        plain[dl < (int)sizeof(plain) ? dl : (int)sizeof(plain) - 1] = 0;
+        strlcpy(p->name, nm, sizeof(p->name));
+        recordListened(nm, plain, dl, p->hops, p->hash_size, p->path, p->path_n, snr4, rssi, p->ts, p->fp);
+      }
+    }
+  } else if (type == 2 && plen >= 4 && pay[1] == mesh->self_id.pub_key[0]) {   // TXT_MSG from us: one of our DMs, relayed
+    for (int q = msg_count - 1, seen = 0; q >= 0 && seen < 30; q--, seen++) {
+      Msg* m = msgAt(q);
+      if (m->dir != 1 || m->kind != 1 || m->fp || m->key[0] != pay[0] || p->ts - m->ts > 120) continue;
+      m->fp = p->fp;   // copies show who passed it on (an ACK still says whether it arrived)
+      break;
+    }
+  }
+  Buf b;
+  pktJson(b, p);
+  broadcast("packet", b);
+}
+
+// Already linked to a message? (two messages never share a packet)
+bool fpTaken(uint32_t fp) {
+  for (int q = msg_count - 1, seen = 0; q >= 0 && seen < 100; q--, seen++) if (msgAt(q)->fp == fp) return true;
+  return false;
+}
+
+void onSent(uint32_t id, const uint8_t* f, size_t len) {   // RESP_SENT for one of our DMs
+  if (len < 10) return;
+  Lock l;
+  Msg* m = findMsg(id);
+  if (!m) return;
+  uint32_t ack, timeout; memcpy(&ack, &f[2], 4); memcpy(&timeout, &f[6], 4);
+  uint8_t k = (m->attempts ? m->attempts - 1 : 0) % 3;
+  m->acks[k] = ack;
+  m->flood_mask = (m->flood_mask & ~(1 << k)) | (f[1] ? 1 << k : 0) | (0x10 << k);   // byte 1: sent by flood (no route)
+  m->retry_at = millis() + (timeout ? timeout * 6 / 5 : 15000);
+}
+
+void onAck(const uint8_t* f, size_t len) {
+  if (len < 5) return;
+  uint32_t code, trip = 0; memcpy(&code, &f[1], 4);
+  if (len >= 9) memcpy(&trip, &f[5], 4);   // the radio's own round trip: that try's send to this ACK
+  Lock l;
+  for (int i = msg_count - 1, n = 0; i >= 0 && n < 100; i--, n++) {
+    Msg* m = msgAt(i);
+    if (m->dir != 1 || m->kind != 1) continue;
+    for (int k = 0; k < 3; k++) {
+      if (!code || m->acks[k] != code) continue;
+      if (m->status != ST_DELIVERED) {
+        m->status = ST_DELIVERED; m->retry_at = 0; m->ack_try = k + 1; m->rtt_ms = trip;
+        persistUpdate(m); emitMsg(m);
+      }
+      return;
+    }
+  }
+}
+
+void onOkErr(Kind kind, uint32_t ctx, bool ok) {
+  if (kind == K_SEND_CH || kind == K_SEND_DM) {
+    Lock l;
+    Msg* m = findMsg(ctx);
+    if (!m) return;
+    if (!ok) { m->status = ST_FAILED; m->retry_at = 0; persistUpdate(m); emitMsg(m); return; }
+    if (kind == K_SEND_CH) {
+      if (m->status == ST_SENDING) m->status = ST_SENT;
+      if (m->status == ST_SENT) m->retry_at = millis() + CHAN_RETRY_WAIT * (m->attempts ? m->attempts : 1);
+      persistUpdate(m);
+      emitMsg(m);
+    }
+  } else if (kind == K_CHANNEL) { chans_dirty = true; contacts_dirty = true; }
+  else if (kind == K_RADIO && ok) {   // another network: its own channels, packets and heard nodes from now on
+    Lock l;
+    memset(chan_stats, 0, sizeof(ChanStat) * 256);
+    for (int i = 0; i < MAX_SAMPLES; i++) samples[i].used = 0;
+    for (int i = 0; i < MAX_WATCH; i++) { watches[i].count = 0; watches[i].last = 0; }
+    chans_dirty = true;
+    Buf b; b.raw("\"all\""); broadcast("stale", b);   // browsers reload everything
+  }
+  else if (kind == K_NAME || kind == K_CONTACT) { contacts_dirty = true; }
+  else if (kind == K_ADVERT && ok) { saveSmallState(); }
+}
+
+// ---------------------------------------------------------------- repeater queries
+// Log in (as a guest unless a password is given), ask for status and for the repeaters it hears,
+// log out: the same requests MeshChat's Python server makes. Replies take seconds, so this is a
+// small state machine in the main task; one query at a time. Results stay in RAM.
+const int MAX_LIVE = 8, MAX_NB = 48;
+struct Nb { uint8_t pk[4]; int32_t secs; int8_t snr4; };
+struct Live {
+  uint8_t key[32]; uint32_t ts;
+  uint8_t used, running, ok, login, perms, status_len, nb_n; int16_t nb_total;
+  uint8_t room, acl, fw; uint32_t srv_ts;   // a room server? the role, clock and firmware level its login reported
+  uint8_t status[64]; char error[128]; Nb nb[MAX_NB];
+};
+Live* lives = nullptr;
+enum QStep : uint8_t { Q_IDLE, Q_LOGIN, Q_STATUS, Q_NB };
+// flooded: this query already forgot the saved route and asked again by flood (once per query).
+// pwd: the login password, kept only while the query runs, for that retry
+struct Query { QStep step; Live* L; uint32_t deadline, tag; uint8_t pages, flooded; char pwd[16]; } qry = {};
+volatile bool query_busy = false;
+
+// ---- rooms: the room servers you've joined from here. Joining is a login (as a guest with no
+// password, if the room allows one) that also tells the room which posts you already have: it then
+// pushes you the newer ones, one at a time, and each new post as it arrives, for as long as your
+// radio acknowledges them (MeshCore has no "leave" message). Saved on flash.
+const int MAX_ROOMS = 24;
+const char* ROLE_NAME[] = {"guest", "read-only", "read-write", "admin"};
+struct Room { uint8_t key[32]; uint32_t joined, login_at, left_at; uint8_t used, left, role, admin; };
+Room rooms[MAX_ROOMS];
+
+Room* roomFind(const uint8_t* key) { for (int i = 0; i < MAX_ROOMS; i++) if (rooms[i].used && memcmp(rooms[i].key, key, 32) == 0) return &rooms[i]; return nullptr; }
+bool roomLeft(const uint8_t* key) { Room* r = roomFind(key); return r && r->left; }
+
+void saveRooms() {
+  JsonDocument doc;
+  JsonArray a = doc.to<JsonArray>();
+  for (int i = 0; i < MAX_ROOMS; i++) {
+    if (!rooms[i].used) continue;
+    char k[65]; hexLower(k, rooms[i].key, 32);
+    JsonObject o = a.add<JsonObject>();
+    o["k"] = k; o["j"] = rooms[i].joined; o["l"] = rooms[i].login_at; o["x"] = rooms[i].left_at;
+    o["q"] = rooms[i].left; o["r"] = rooms[i].role; o["a"] = rooms[i].admin;
+  }
+  File f = SPIFFS.open("/wu_rooms.json", FILE_WRITE);
+  if (f) { serializeJson(doc, f); f.close(); }
+}
+void loadRooms() {
+  File f = SPIFFS.open("/wu_rooms.json");
+  if (!f) return;
+  JsonDocument doc;
+  if (!deserializeJson(doc, f)) {
+    int n = 0;
+    for (JsonObject o : doc.as<JsonArray>()) {
+      if (n >= MAX_ROOMS) break;
+      Room& r = rooms[n];
+      if (!hexToBytes(o["k"] | "", r.key, 32)) continue;
+      r.used = 1; r.joined = o["j"] | 0u; r.login_at = o["l"] | 0u; r.left_at = o["x"] | 0u;
+      r.left = o["q"] | 0; r.role = o["r"] | 0xFF; r.admin = o["a"] | 0;
+      n++;
+    }
+  }
+  f.close();
+}
+void roomJoined(const Live* L) {   // main task, under the lock
+  Room* r = roomFind(L->key);
+  if (!r) {
+    for (int i = 0; i < MAX_ROOMS && !r; i++) if (!rooms[i].used) r = &rooms[i];
+    if (!r) { r = &rooms[0]; for (int i = 1; i < MAX_ROOMS; i++) if (rooms[i].login_at < r->login_at) r = &rooms[i]; }   // forget the oldest
+    memset(r, 0, sizeof(*r));
+    memcpy(r->key, L->key, 32); r->used = 1;
+  }
+  uint32_t now = wallNow();
+  if (!r->joined || r->left) r->joined = now;
+  r->login_at = now; r->left = 0; r->left_at = 0;
+  r->role = L->acl; r->admin = L->perms == 1;
+  saveRooms();
+}
+void roomsJson(Buf& b) {
+  b.raw("[");
+  bool first = true;
+  for (int i = 0; i < MAX_ROOMS; i++) {
+    const Room& r = rooms[i];
+    if (!r.used) continue;
+    char k[65]; hexLower(k, r.key, 32);
+    b.f("%s{\"key\":\"%s\",\"joined\":%u,\"login_at\":%u,\"left\":%s,\"left_at\":%u,\"role\":", first ? "" : ",", k, r.joined, r.login_at, r.left ? "true" : "false", r.left_at);
+    first = false;
+    if (r.role <= 3) b.f("\"%s\"", ROLE_NAME[r.role]); else b.raw("null");
+    b.f(",\"admin\":%s}", r.admin ? "true" : "false");
+  }
+  b.raw("]");
+}
+
+void liveJson(Buf& b, const Live* L) {
+  char k[65]; hexLower(k, L->key, 32);
+  b.f("{\"key\":\"%s\",\"ts\":%u,\"running\":%s,\"ok\":%s,", k, L->ts, L->running ? "true" : "false", L->ok ? "true" : "false");
+  if (L->error[0]) { b.raw("\"error\":"); b.str(L->error); b.raw(","); }
+  if (L->room) b.raw("\"room\":true,");
+  if (L->login) {
+    b.f("\"login\":{\"admin\":%s,\"permissions\":%u,\"role\":", L->perms == 1 ? "true" : "false", L->perms);
+    if (L->acl <= 3) b.f("\"%s\"", ROLE_NAME[L->acl]); else b.raw("null");
+    if (L->srv_ts) b.f(",\"server_time\":%u", L->srv_ts);
+    if (L->fw) b.f(",\"fw_level\":%u", L->fw);
+    b.raw("},");
+  } else b.raw("\"login\":null,");
+  if (L->status_len >= 48) {
+    const uint8_t* d = L->status;
+    auto u16 = [d](int o) { return (unsigned)(d[o] | d[o + 1] << 8); };
+    auto i16 = [d](int o) { return (int)(int16_t)(d[o] | d[o + 1] << 8); };
+    auto u32 = [d](int o) { uint32_t v; memcpy(&v, d + o, 4); return (unsigned long)v; };
+    b.f("\"status\":{\"bat\":%u,\"tx_queue_len\":%u,\"noise_floor\":%d,\"last_rssi\":%d,", u16(0), u16(2), i16(4), i16(6));
+    b.f("\"nb_recv\":%lu,\"nb_sent\":%lu,\"airtime\":%lu,\"uptime\":%lu,", u32(8), u32(12), u32(16), u32(20));
+    b.f("\"sent_flood\":%lu,\"sent_direct\":%lu,\"recv_flood\":%lu,\"recv_direct\":%lu,", u32(24), u32(28), u32(32), u32(36));
+    b.f("\"full_evts\":%u,\"last_snr\":%.2f,\"direct_dups\":%u,\"flood_dups\":%u", u16(40), i16(42) / 4.0, u16(44), u16(46));
+    // room servers: posts stored since it started, and posts pushed to members (repeaters put their RX airtime here)
+    if (L->room && L->status_len >= 52) b.f(",\"posted\":%u,\"post_pushes\":%u", u16(48), u16(50));
+    b.raw("},");
+  } else b.raw("\"status\":null,");
+  if (L->nb_total >= 0) {
+    b.raw("\"neighbours\":[");
+    for (int i = 0; i < L->nb_n; i++) {
+      char pk[9]; hexLower(pk, L->nb[i].pk, 4);
+      b.f("%s{\"pubkey\":\"%s\",\"secs_ago\":%d,\"snr\":%.2f}", i ? "," : "", pk, (int)L->nb[i].secs, L->nb[i].snr4 / 4.0);
+    }
+    b.f("],\"neighbours_total\":%d}", L->nb_total);
+  } else b.raw("\"neighbours\":null,\"neighbours_total\":null}");
+}
+
+void queryNext(uint8_t cmd) {   // status or neighbours request to qry.L
+  uint8_t f[1 + 32 + 11] = {cmd};
+  memcpy(&f[1], qry.L->key, 32);
+  size_t n = 33;
+  if (cmd == CMD_SEND_BINARY_REQ) {
+    uint16_t off = qry.L->nb_n; uint32_t r = esp_random();
+    uint8_t req[11] = {0x06 /* neighbours */, 0 /* version */, 255 /* count */, (uint8_t)off, (uint8_t)(off >> 8), 0 /* newest first */, 4 /* prefix bytes */};
+    memcpy(&req[7], &r, 4);
+    memcpy(&f[33], req, 11); n += 11;
+  }
+  qry.deadline = millis() + 10000;   // until the radio says it sent it
+  queueCmd(K_QUERY, 0, f, n);
+}
+
+void queryLogin() {   // log in to qry.L (as a guest with no password)
+  uint8_t f[1 + 32 + 16] = {CMD_SEND_LOGIN};
+  memcpy(&f[1], qry.L->key, 32);
+  size_t pn = strnlen(qry.pwd, 15); memcpy(&f[33], qry.pwd, pn);
+  qry.deadline = millis() + 10000;   // until the radio says it sent it
+  queueCmd(K_QUERY, 0, f, 33 + pn);
+  memset(f, 0, sizeof(f));
+}
+
+void queryDone(const char* error) {
+  Lock l;   // the web task reads lives[]
+  Live* L = qry.L;
+  memset(qry.pwd, 0, sizeof(qry.pwd));
+  // repeaters: log out again. Rooms: stay (that's what joining is); a logout only stops keep-alives
+  if (L->login && !L->room) { uint8_t f[33] = {CMD_LOGOUT}; memcpy(&f[1], L->key, 32); queueCmd(K_OTHER, 0, f, 33); }
+  L->ok = L->status_len >= 48 || L->nb_total >= 0 || (L->room && L->login);
+  if (error) strlcpy(L->error, error, sizeof(L->error));
+  else if (!L->ok) strlcpy(L->error, "Logged in, but the repeater didn't send its status or neighbours back in time.", sizeof(L->error));
+  if (L->room && L->login) { roomJoined(L); emitStale(); }
+  L->running = 0;
+  L->ts = wallNow();
+  qry.step = Q_IDLE; qry.L = nullptr; query_busy = false;
+  Buf b; liveJson(b, L); broadcast("live", b);
+}
+
+void queryStart(const uint8_t* key, const char* pwd) {
+  Lock l;   // the web task reads lives[]
+  Live* L = nullptr;
+  for (int i = 0; i < MAX_LIVE && !L; i++) if (lives[i].used && memcmp(lives[i].key, key, 32) == 0) L = &lives[i];
+  for (int i = 0; i < MAX_LIVE && !L; i++) if (!lives[i].used) L = &lives[i];
+  if (!L) { L = &lives[0]; for (int i = 1; i < MAX_LIVE; i++) if (lives[i].ts < L->ts) L = &lives[i]; }   // forget the oldest
+  memset(L, 0, sizeof(*L));
+  memcpy(L->key, key, 32); L->used = 1; L->running = 1; L->nb_total = -1; L->acl = 0xFF;
+  ContactInfo* c = mesh->lookupContactByPubKey(key, 32);
+  L->room = c && c->type == ADV_TYPE_ROOM;   // a room: logging in is joining (see roomJoined)
+  L->ts = wallNow();
+  qry.L = L; qry.step = Q_LOGIN; qry.pages = 0; qry.flooded = 0;
+  strlcpy(qry.pwd, pwd, sizeof(qry.pwd));
+  queryLogin();
+  Buf b; liveJson(b, L); broadcast("live", b);
+}
+
+void querySent(const uint8_t* f, size_t len) {   // RESP_SENT: the request went out, now wait for the reply
+  if (qry.step == Q_IDLE || len < 10) return;
+  uint32_t tag, est; memcpy(&tag, &f[2], 4); memcpy(&est, &f[6], 4);
+  qry.tag = tag;
+  uint32_t wait = est * 5 / 4;
+  if (wait < 8000) wait = 8000;
+  // a room that was just joined is busy pushing posts (one every second or two, each waiting for our
+  // receipt), and its status reply queues behind them
+  if (qry.L && qry.L->room && qry.step == Q_STATUS && wait < 25000) wait = 25000;
+  if (wait > 45000) wait = 45000;
+  qry.deadline = millis() + wait;
+}
+
+void queryErr(const uint8_t* f, size_t len) {
+  if (qry.step == Q_IDLE) return;
+  uint8_t code = len > 1 ? f[1] : 0;
+  queryDone(code == 2 ? "Your radio doesn't have this repeater as a contact yet, so it can't address it."
+                      : "The radio couldn't send the request right now. Try again in a minute.");
+}
+
+void queryPush(uint8_t code, const uint8_t* f, size_t len) {
+  if (qry.step == Q_IDLE) return;
+  Lock l;   // the web task reads lives[]
+  Live* L = qry.L;
+  if (qry.step == Q_LOGIN && (code == PUSH_LOGIN_OK || code == PUSH_LOGIN_FAIL) && len >= 8 && memcmp(&f[2], L->key, 6) == 0) {
+    if (code == PUSH_LOGIN_FAIL) { queryDone(L->room ? "Login refused by the room." : "Login refused: this repeater needs a password (or a different one)."); return; }
+    L->login = 1; L->perms = f[1];
+    if (len >= 12) memcpy(&L->srv_ts, &f[8], 4);   // newer firmware: its clock, your role, its firmware level
+    if (len >= 13) L->acl = f[12] & 3;
+    if (len >= 14) L->fw = f[13];
+    qry.step = Q_STATUS; queryNext(CMD_SEND_STATUS_REQ);
+  } else if (qry.step == Q_STATUS && code == PUSH_STATUS && len >= 8 && memcmp(&f[2], L->key, 6) == 0) {
+    L->status_len = len - 8 > sizeof(L->status) ? sizeof(L->status) : len - 8;
+    memcpy(L->status, &f[8], L->status_len);
+    if (L->room) queryDone(nullptr);   // room servers don't list neighbours
+    else { qry.step = Q_NB; queryNext(CMD_SEND_BINARY_REQ); }
+  } else if (qry.step == Q_NB && code == PUSH_STATUS && len >= 8 && memcmp(&f[2], L->key, 6) == 0) {
+    // the status answer, late: we'd already moved on to the neighbours. Keep it
+    L->status_len = len - 8 > sizeof(L->status) ? sizeof(L->status) : len - 8;
+    memcpy(L->status, &f[8], L->status_len);
+  } else if (qry.step == Q_NB && code == PUSH_BINARY && len >= 10 && memcmp(&f[2], &qry.tag, 4) == 0) {
+    const uint8_t* d = &f[6];
+    int total = (int16_t)(d[0] | d[1] << 8), n = (int16_t)(d[2] | d[3] << 8);
+    L->nb_total = total;
+    for (int i = 0; i < n && 4 + (i + 1) * 9 <= (int)len - 6; i++) {
+      if (L->nb_n >= MAX_NB) break;
+      const uint8_t* e = d + 4 + i * 9;
+      Nb& nb = L->nb[L->nb_n++];
+      memcpy(nb.pk, e, 4); memcpy(&nb.secs, e + 4, 4); nb.snr4 = (int8_t)e[8];
+    }
+    if (n > 0 && L->nb_n < total && L->nb_n < MAX_NB && ++qry.pages < 4) queryNext(CMD_SEND_BINARY_REQ);   // more pages
+    else queryDone(nullptr);
+  }
+}
+
+void queryTick() {
+  if (qry.step == Q_IDLE || (int32_t)(millis() - qry.deadline) < 0) return;
+  // No answer on the saved route: it may work one way only (the answer comes back through repeaters
+  // that don't hear each other well), or a repeater on it is gone. Forget it and ask again by flood,
+  // once per query, as a DM's last try does; the answer brings a fresh route. Not a room's status,
+  // which is only slow while the room pushes posts.
+  bool room_status = qry.L->room && qry.step == Q_STATUS;
+  ContactInfo* c = mesh->lookupContactByPubKey(qry.L->key, 32);
+  if (!qry.flooded && !room_status && c && c->out_path_len != OUT_PATH_UNKNOWN) {
+    qry.flooded = 1;
+    uint8_t f[33] = {CMD_RESET_PATH};
+    memcpy(&f[1], qry.L->key, 32);
+    queueCmd(K_OTHER, 0, f, 33);   // K_OTHER: the route history records it as reset by "retry"
+    if (qry.step == Q_LOGIN) queryLogin();
+    else queryNext(qry.step == Q_STATUS ? CMD_SEND_STATUS_REQ : CMD_SEND_BINARY_REQ);
+    return;
+  }
+  if (qry.step == Q_LOGIN) queryDone(qry.L->room ? "No answer from the room, on the saved route or by flood. It needs a password for you (a wrong one gets no reply), or the request or its answer was lost on the way. Try again in a minute."
+                                                 : "No login reply, on the saved route or by flood. It may need a password (a wrong one gets no reply), or the request or its answer was lost on the way. Try again in a minute.");
+  else if (qry.step == Q_STATUS && qry.L->room) queryDone(nullptr);   // joined; it just didn't send its status
+  else if (qry.step == Q_STATUS) { qry.step = Q_NB; queryNext(CMD_SEND_BINARY_REQ); }   // no status: still ask for neighbours
+  else queryDone(nullptr);
+}
+
+// ---------------------------------------------------------------- repeater admin: its command line
+// Logged in with the admin password, you can run a repeater's (or room server's) command line from
+// here: each command is a TXT_MSG of type CLI_DATA (no ACK), and the node answers with one of the same
+// type, up to about 160 characters. Commands and answers per node, in RAM (gone after a restart).
+// Passwords and keys in commands, and the "password now:" echo, are masked before they're kept.
+const int MAX_CLI_NODES = 4, MAX_CLI_LINES = 40, CLI_TEXT = 168;
+struct CliLine { uint32_t id, ts; uint8_t cmd, status; char text[CLI_TEXT]; };   // status (commands): 0 sending, 1 sent, 2 failed
+struct CliLog { uint8_t key[32]; uint8_t used; uint32_t touched; int head, count; CliLine lines[MAX_CLI_LINES]; };
+CliLog* clis = nullptr;
+uint32_t next_cli_id = 1;
+
+CliLog* cliFind(const uint8_t* key, size_t n) {
+  for (int i = 0; i < MAX_CLI_NODES; i++) if (clis[i].used && memcmp(clis[i].key, key, n) == 0) return &clis[i];
+  return nullptr;
+}
+CliLog* cliGet(const uint8_t* key) {   // find or make one; when full, forget the one untouched longest
+  CliLog* g = cliFind(key, 32);
+  if (g) return g;
+  for (int i = 0; i < MAX_CLI_NODES && !g; i++) if (!clis[i].used) g = &clis[i];
+  if (!g) { g = &clis[0]; for (int i = 1; i < MAX_CLI_NODES; i++) if ((int32_t)(clis[i].touched - g->touched) < 0) g = &clis[i]; }
+  memset(g, 0, sizeof(*g));
+  memcpy(g->key, key, 32); g->used = 1;
+  return g;
+}
+void cliMask(char* t) {   // passwords and keys never sit in the log
+  static const char* const secret[] = {"password now: ", "password ", "set guest.password ", "set prv.key ", "set bridge.secret "};   // "password now:" before "password "
+  for (const char* p : secret) {
+    size_t n = strlen(p);
+    if (strncmp(t, p, n) == 0 && t[n]) { strlcpy(t + n, "\u2022\u2022\u2022\u2022", CLI_TEXT - n); return; }
+  }
+}
+CliLine* cliAdd(CliLog* g, bool cmd, const char* text, size_t len) {
+  if (g->count == MAX_CLI_LINES) { g->head = (g->head + 1) % MAX_CLI_LINES; g->count--; }
+  CliLine& l = g->lines[(g->head + g->count++) % MAX_CLI_LINES];
+  l.id = next_cli_id++; l.ts = wallNow(); l.cmd = cmd; l.status = cmd ? 0 : 1;
+  copyText(l.text, sizeof(l.text), (const uint8_t*)text, len);
+  cliMask(l.text);
+  g->touched = millis();
+  return &l;
+}
+void cliLineJson(Buf& b, const CliLine& l) {
+  b.f("{\"id\":%u,\"ts\":%u,\"dir\":\"%s\",\"status\":\"%s\",\"text\":", l.id, l.ts, l.cmd ? "command" : "answer",
+      !l.cmd ? "received" : l.status == 0 ? "sending" : l.status == 1 ? "sent" : "failed");
+  b.str(l.text); b.raw("}");
+}
+void cliJson(Buf& b, const uint8_t* key) {   // web task, under the lock
+  char k[65]; hexLower(k, key, 32);
+  b.f("{\"key\":\"%s\",\"lines\":[", k);
+  CliLog* g = cliFind(key, 32);
+  for (int i = 0; g && i < g->count; i++) { if (i) b.raw(","); cliLineJson(b, g->lines[(g->head + i) % MAX_CLI_LINES]); }
+  b.raw("]}");
+}
+void cliEmit(const CliLog* g, const CliLine& l) {
+  char k[65]; hexLower(k, g->key, 32);
+  Buf b; b.f("{\"key\":\"%s\",\"line\":", k); cliLineJson(b, l); b.raw("}");
+  broadcast("cli", b);
+}
+void cliSend(const uint8_t* key, const char* text) {   // main task
+  Lock l;
+  CliLog* g = cliGet(key);
+  size_t tl = strnlen(text, 159);
+  CliLine* ln = cliAdd(g, true, text, tl);
+  if (!mesh->lookupContactByPubKey(key, 32)) { ln->status = 2; cliEmit(g, *ln); return; }
+  uint8_t f[1 + 1 + 1 + 4 + 6 + 160];
+  size_t i = 0;
+  f[i++] = CMD_SEND_TXT_MSG; f[i++] = 1;   // TXT_TYPE_CLI_DATA
+  f[i++] = 0;                              // attempt
+  uint32_t ts = now_s(); memcpy(&f[i], &ts, 4); i += 4;   // (the radio stamps commands with its own clock)
+  memcpy(&f[i], key, 6); i += 6;
+  memcpy(&f[i], text, tl); i += tl;
+  queueCmd(K_CLI, ln->id, f, i);
+  memset(f, 0, sizeof(f));
+  cliEmit(g, *ln);
+}
+void cliSent(uint32_t id, bool ok) {   // the radio sent the command (RESP_SENT) or couldn't (RESP_ERR)
+  Lock l;
+  for (int i = 0; i < MAX_CLI_NODES; i++) {
+    CliLog& g = clis[i];
+    for (int j = 0; g.used && j < g.count; j++) {
+      CliLine& ln = g.lines[(g.head + j) % MAX_CLI_LINES];
+      if (ln.id == id && ln.cmd) { ln.status = ok ? 1 : 2; cliEmit(&g, ln); return; }
+    }
+  }
+}
+void cliAnswer(const uint8_t* prefix, const uint8_t* text, size_t len) {   // a node's CLI_DATA answer
+  ContactInfo* c = mesh->lookupContactByPubKey(prefix, 6);
+  Lock l;
+  CliLog* g = c ? cliGet(c->id.pub_key) : cliFind(prefix, 6);
+  if (!g) return;
+  CliLine* ln = cliAdd(g, false, (const char*)text, len);
+  cliEmit(g, *ln);
+}
+
+// ---------------------------------------------------------------- saved routes: their history
+// MeshCore keeps one route per contact (in the contact record) and nothing about where it came
+// from. This keeps, per contact: when the route was learned and last confirmed, the one before it,
+// how often it changed, the PATH packet that brought it, and when it was last reset (and by whom).
+// RAM, saved to flash a few seconds after a change. Main task only (the web task reads the
+// contacts snapshot, which carries it).
+const int MAX_ROUTES = 96, ROUTE_BYTES = 24;   // 24 bytes: 8 hops of 3-byte IDs, 12 of 2, 24 of 1
+enum : uint8_t { RESET_NONE, RESET_YOU, RESET_RETRY, RESET_APP };
+const char* RESET_BY[] = {"", "you", "retry", "app"};
+struct RouteRec {
+  uint8_t key[8];
+  uint32_t learned, confirmed, prev_since, reset;   // wall times; 0 = not known
+  uint16_t learns, changes;
+  uint8_t len, path[ROUTE_BYTES];                   // as last learned (an out_path_len byte; 0xFF none)
+  uint8_t prev_len, prev[ROUTE_BYTES];              // the one before
+  uint8_t reset_by;
+  uint32_t pkt_id;                                  // the PATH packet that brought it (0: not in the log)
+  int16_t snr4; int8_t rssi; uint8_t in_len;        // its signal, and its own path length byte
+};
+RouteRec routes[MAX_ROUTES]; int route_count = 0;
+uint32_t routes_dirty_at = 0;
+const char* ROUTES_FILE = "/wu_routes.bin";
+const uint32_t ROUTES_MAGIC = 0x31525557;   // "WUR1"
+
+size_t routeBytes(uint8_t len) {
+  if (len == OUT_PATH_UNKNOWN) return 0;
+  size_t n = (size_t)(len & 63) * ((len >> 6) + 1);
+  return n > ROUTE_BYTES ? ROUTE_BYTES : n;
+}
+bool sameRoute(uint8_t la, const uint8_t* pa, uint8_t lb, const uint8_t* pb) { return la == lb && memcmp(pa, pb, routeBytes(la)) == 0; }
+RouteRec* routeFind(const uint8_t* key) {
+  for (int i = 0; i < route_count; i++) if (memcmp(routes[i].key, key, 8) == 0) return &routes[i];
+  return nullptr;
+}
+RouteRec* routeGet(const uint8_t* key) {   // find or make one; when full, forget the one untouched longest
+  RouteRec* r = routeFind(key);
+  if (r) return r;
+  auto touched = [](const RouteRec& x) { return std::max(x.confirmed, x.reset); };
+  if (route_count < MAX_ROUTES) r = &routes[route_count++];
+  else { r = &routes[0]; for (int i = 1; i < MAX_ROUTES; i++) if (touched(routes[i]) < touched(*r)) r = &routes[i]; }
+  memset(r, 0, sizeof(*r));
+  memcpy(r->key, key, 8);
+  r->len = r->prev_len = OUT_PATH_UNKNOWN;
+  return r;
+}
+void routesChanged() { routes_dirty_at = millis() | 1; }
+
+void loadRoutes() {
+  File f = SPIFFS.open(ROUTES_FILE);
+  if (!f) return;
+  uint32_t magic = 0; int32_t n = 0;
+  if (f.read((uint8_t*)&magic, 4) == 4 && magic == ROUTES_MAGIC && f.read((uint8_t*)&n, 4) == 4 && n >= 0 && n <= MAX_ROUTES &&
+      f.read((uint8_t*)routes, n * sizeof(RouteRec)) == n * sizeof(RouteRec)) route_count = n;
+  f.close();
+}
+void saveRoutes() {
+  File f = SPIFFS.open(ROUTES_FILE, FILE_WRITE);
+  if (!f) return;
+  int32_t n = route_count;
+  f.write((const uint8_t*)&ROUTES_MAGIC, 4); f.write((const uint8_t*)&n, 4);
+  f.write((const uint8_t*)routes, n * sizeof(RouteRec));
+  f.close();
+}
+
+// PUSH_PATH: the radio has just stored a route to this contact (a PATH packet: the answer to a flood)
+void routeLearned(const uint8_t* key) {
+  ContactInfo* c = mesh->lookupContactByPubKey(key, 32);
+  if (!c || c->out_path_len == OUT_PATH_UNKNOWN) return;
+  Lock l;   // the snapshot builder reads routes[] in this task, but messages are read under the lock
+  RouteRec* r = routeGet(key);
+  uint32_t now = wallNow();
+  if (sameRoute(r->len, r->path, c->out_path_len, c->out_path)) {   // the same one again
+    if (!r->learned) r->learned = now;
+    r->confirmed = now;
+  } else {
+    if (r->len != OUT_PATH_UNKNOWN) { r->prev_len = r->len; memcpy(r->prev, r->path, ROUTE_BYTES); r->prev_since = r->learned; }
+    // a change: it differs from the last route we knew (the one it replaces, or the one reset before it)
+    if (r->prev_len != OUT_PATH_UNKNOWN && !sameRoute(r->prev_len, r->prev, c->out_path_len, c->out_path)) r->changes++;
+    r->len = c->out_path_len; memset(r->path, 0, ROUTE_BYTES); memcpy(r->path, c->out_path, routeBytes(r->len));
+    r->learned = r->confirmed = now;
+  }
+  if (r->learns < 0xFFFF) r->learns++;
+  // the PATH packet itself: the RX log entry just before this
+  r->pkt_id = 0;
+  for (int q = 0; q < pkt_count && q < 16; q++) {
+    Pkt* p = &pkts[(pkt_head - 1 - q + MAX_PKTS) % MAX_PKTS];
+    if (millis() - p->ms > 3000) break;
+    if (p->type != 8) continue;
+    r->pkt_id = p->id; r->snr4 = p->snr4; r->rssi = p->rssi; r->in_len = ((p->hash_size - 1) << 6) | p->hops;
+    break;
+  }
+  routesChanged();
+}
+
+// CMD_RESET_PATH from us or another app, just before the radio forgets the route
+void routeReset(const uint8_t* key, uint8_t by) {
+  ContactInfo* c = mesh->lookupContactByPubKey(key, 32);
+  if (!c || c->out_path_len == OUT_PATH_UNKNOWN) return;
+  Lock l;
+  RouteRec* r = routeGet(key);
+  bool tracked = sameRoute(r->len, r->path, c->out_path_len, c->out_path);
+  r->prev_len = c->out_path_len; memset(r->prev, 0, ROUTE_BYTES); memcpy(r->prev, c->out_path, routeBytes(r->prev_len));
+  r->prev_since = tracked ? r->learned : 0;
+  r->len = OUT_PATH_UNKNOWN; memset(r->path, 0, ROUTE_BYTES);
+  r->learned = 0; r->pkt_id = 0;
+  r->reset = wallNow(); r->reset_by = by;
+  routesChanged();
+}
+
+// ,"route":{...} in a contact's JSON (none if we know nothing about it)
+void routeJson(Buf& b, const ContactInfo& c) {
+  RouteRec* r = routeFind(c.id.pub_key);
+  if (!r) return;
+  // what we recorded applies only if the radio still has that route (another app may have replaced it)
+  bool cur = c.out_path_len != OUT_PATH_UNKNOWN && sameRoute(r->len, r->path, c.out_path_len, c.out_path);
+  b.raw(",\"route\":{");
+  if (cur) b.f("\"learned\":%u,\"confirmed\":%u,", r->learned, r->confirmed); else b.raw("\"learned\":null,\"confirmed\":null,");
+  b.f("\"learns\":%u,\"changes\":%u,\"previous\":", r->learns, r->changes);
+  if (r->prev_len != OUT_PATH_UNKNOWN) {
+    b.f("{\"out_path_len\":%u,\"hash_mode\":%u,\"out_path\":", r->prev_len & 63, r->prev_len >> 6);
+    b.hex(r->prev, routeBytes(r->prev_len));
+    if (r->prev_since) b.f(",\"since\":%u}", r->prev_since); else b.raw(",\"since\":null}");
+  } else b.raw("null");
+  if (r->reset) b.f(",\"reset\":{\"at\":%u,\"by\":\"%s\"}", r->reset, RESET_BY[r->reset_by <= 3 ? r->reset_by : 0]); else b.raw(",\"reset\":null");
+  if (cur && r->pkt_id)
+    b.f(",\"via\":{\"pkt_id\":%u,\"snr\":%.2f,\"rssi\":%d,\"hops\":%u,\"hash_size\":%u}}", r->pkt_id, r->snr4 / 4.0, r->rssi, r->in_len & 63, (r->in_len >> 6) + 1);
+  else b.raw(",\"via\":null}");
+}
+
+void appDmSent(const uint8_t* f, size_t len);   // below, with the other-app hooks
+
+void onFrame(const uint8_t* f, size_t len) {
+  if (!len) return;
+  uint8_t code = f[0];
+  Kind kind = K_NONE; uint32_t ctx = 0;
+  if (code < 0x80 && awaiting != K_NONE) { kind = awaiting; ctx = awaiting_ctx; awaiting = K_NONE; }
+  switch (code) {
+    // PUSH_WAITING and RESP_*_MSG: another app fetching the offline queue. We recorded those
+    // messages when they were queued (onQueued), so there's nothing to do.
+    case RESP_SENT:
+      if (kind == K_SEND_DM) onSent(ctx, f, len);
+      else if (kind == K_QUERY) querySent(f, len);
+      else if (kind == K_CLI) cliSent(ctx, true);
+      else if (kind == K_NONE && app_dm) appDmSent(f, len);
+      break;
+    case RESP_OK: case RESP_ERR:
+      if (kind == K_QUERY) { if (code == RESP_ERR) queryErr(f, len); }
+      else if (kind == K_CLI) cliSent(ctx, code == RESP_OK);
+      else onOkErr(kind, ctx, code == RESP_OK);
+      break;
+    case PUSH_LOGIN_OK: case PUSH_LOGIN_FAIL: case PUSH_STATUS: case PUSH_BINARY: queryPush(code, f, len); break;
+    case PUSH_ACK: onAck(f, len); break;
+    case PUSH_RX_LOG: onRxLog(f, len); break;
+    case PUSH_PATH: if (len >= 33) routeLearned(&f[1]); contacts_dirty = true; break;
+    case PUSH_ADVERT: case PUSH_NEW_ADVERT: contacts_dirty = true; break;
+    default: break;
+  }
+}
+
+// ---------------------------------------------------------------- other apps (Bluetooth, WiFi, USB)
+void onQueuedFrame(const uint8_t* f, int len) {
+  if (len < 1) return;
+  if (f[0] == RESP_CONTACT_MSG_V3 || f[0] == RESP_CONTACT_MSG) onContactMsg(f, len, f[0] == RESP_CONTACT_MSG_V3);
+  else if (f[0] == RESP_CHANNEL_MSG_V3 || f[0] == RESP_CHANNEL_MSG) onChannelMsg(f, len, f[0] == RESP_CHANNEL_MSG_V3);
+}
+
+// Another app is sending a text message: record it like one of ours, without retries (the app
+// does its own). Our own sends are recognisable because we're waiting for their reply.
+void onAppSendCmd(const uint8_t* c, int len) {
+  if (c[0] == CMD_RESET_PATH && len >= 33) {   // ours (Reset path, or a DM's last try) or another app's
+    routeReset(&c[1], awaiting == K_CONTACT ? RESET_YOU : awaiting == K_OTHER ? RESET_RETRY : RESET_APP);
+    contacts_dirty = true;
+    return;
+  }
+  if (awaiting == K_SEND_CH || awaiting == K_SEND_DM) return;
+  NodePrefs* np = mesh->getNodePrefs();
+  uint32_t ts;
+  Lock l;
+  if (c[0] == CMD_SEND_CHANNEL_TXT_MSG && len > 7 && c[1] == 0) {
+    memcpy(&ts, &c[3], 4);
+    if (!chanByIdx(c[2])) return;
+    Msg* m = newMsg();
+    m->ts = wallNow();
+    m->sender_ts = ts; m->kind = 0; m->chan = c[2]; m->dir = 1;
+    m->status = ST_SENT; m->attempts = 1; m->hash_size = 1;
+    strlcpy(m->sender, np->node_name, sizeof(m->sender));
+    copyText(m->text, sizeof(m->text), &c[7], len - 7);
+    persistMsg(m);
+    emitMsg(m);
+  } else if (c[0] == CMD_SEND_TXT_MSG && len > 13 && c[1] == 0) {
+    uint8_t attempt = c[2];
+    memcpy(&ts, &c[3], 4);
+    ContactInfo* ct = mesh->lookupContactByPubKey(&c[7], 6);
+    if (!ct) return;
+    Msg* m = nullptr;
+    if (attempt) {   // the app retrying one it sent before: same timestamp
+      for (int i = msg_count - 1, n = 0; i >= 0 && n < 100 && !m; i--, n++) {
+        Msg* o = msgAt(i);
+        if (o->dir == 1 && o->kind == 1 && o->sender_ts == ts && memcmp(o->key, ct->id.pub_key, 32) == 0) m = o;
+      }
+    }
+    if (!m) {
+      m = newMsg();
+      m->ts = wallNow();
+      m->sender_ts = ts; m->kind = 1; m->dir = 1; memcpy(m->key, ct->id.pub_key, 32);
+      m->hash_size = 1;
+      strlcpy(m->sender, np->node_name, sizeof(m->sender));
+      copyText(m->text, sizeof(m->text), &c[13], len - 13);
+      persistMsg(m);
+    }
+    m->attempts = attempt + 1; m->status = ST_SENDING; m->retry_at = 0;
+    app_dm = m->id;
+    persistUpdate(m);
+    emitMsg(m);
+  }
+}
+
+void appDmSent(const uint8_t* f, size_t len) {   // RESP_SENT for another app's DM: keep its ACK code
+  uint32_t id = app_dm;
+  app_dm = 0;
+  if (len < 10) return;
+  Lock l;
+  Msg* m = findMsg(id);
+  if (!m) return;
+  uint32_t ack; memcpy(&ack, &f[2], 4);
+  uint8_t k = (m->attempts ? m->attempts - 1 : 0) % 3;
+  m->acks[k] = ack;
+  m->flood_mask = (m->flood_mask & ~(1 << k)) | (f[1] ? 1 << k : 0) | (0x10 << k);
+  m->status = ST_SENT;   // "sent" until the ACK arrives (onAck), retries are up to the app
+  persistUpdate(m);
+  emitMsg(m);
+}
+
+// ---------------------------------------------------------------- the built-in app link
+class AppLink : public BaseSerialInterface {
+  bool en = true;
+public:
+  void enable() override { en = true; }
+  void disable() override { en = false; }
+  bool isEnabled() const override { return en; }
+  bool isConnected() const override { return true; }   // always "connected": the radio keeps logging for us
+  bool isWriteBusy() const override { return false; }
+  size_t writeFrame(const uint8_t src[], size_t len) override { onFrame(src, len); return len; }
+  size_t checkRecvFrame(uint8_t dest[]) override {
+    if (cmds.empty() || awaiting != K_NONE) return 0;   // one at a time: the next frame written is our reply
+    Cmd& c = cmds.front();
+    memcpy(dest, c.buf, c.len);
+    size_t n = c.len;
+    awaiting = c.kind == K_NONE ? K_OTHER : c.kind;
+    awaiting_ctx = c.ctx;
+    awaiting_since = millis();
+    cmds.pop_front();
+    return n;
+  }
+};
+AppLink app_link;
+
+// ---------------------------------------------------------------- snapshots for the web task
+void rebuildContacts() {
+  Buf b;
+  b.raw("{");
+  // The iterator skips MeshCore's 8 reserved slots for transient contacts at the start of the
+  // table. (getNumContacts() leaves them out but getContactByIdx() counts them, so looping over
+  // the two together listed those 8 slots and missed the last 8 real contacts.)
+  bool first = true;
+  ContactsIterator it = mesh->startContactsIterator();
+  ContactInfo c;
+  while (it.hasNext(mesh, c)) {
+    char k[65]; hexLower(k, c.id.pub_key, 32);
+    b.f("%s\"%s\":{\"pubkey\":\"%s\",\"name\":", first ? "" : ",", k, k);
+    first = false;
+    b.str(c.name);
+    b.f(",\"type\":\"%s\",\"lat\":", TYPE_NAME[c.type <= 4 ? c.type : 0]);
+    if (c.gps_lat || c.gps_lon) b.f("%.6f,\"lon\":%.6f", c.gps_lat / 1e6, c.gps_lon / 1e6); else b.raw("null,\"lon\":null");
+    // the saved route to them: hops in the low 6 bits, ID size - 1 in the top 2 (unknown: flood)
+    bool known = c.out_path_len != OUT_PATH_UNKNOWN;
+    uint8_t hops = known ? (c.out_path_len & 0x3F) : 0, mode = known ? (c.out_path_len >> 6) : 0;
+    size_t pbytes = (size_t)hops * (mode + 1);
+    b.f(",\"last_advert\":%u,\"out_path_len\":%d,\"hash_mode\":%u,\"out_path\":", c.last_advert_timestamp, known ? hops : -1, mode);
+    b.hex(c.out_path, pbytes <= sizeof(c.out_path) ? pbytes : sizeof(c.out_path));
+    routeJson(b, c);
+    if (c.type == 3) b.f(",\"sync_since\":%u", c.sync_since);   // rooms: posts up to this time are here
+    b.raw("}");
+  }
+  b.raw("}");
+  Lock l;
+  if (snap_contacts) free(snap_contacts);
+  snap_contacts = b.p; snap_contacts_len = b.n;
+  b.p = nullptr;
+  contacts_dirty = false;
+}
+
+// ---------------------------------------------------------------- public map (map.meshcore.io)
+// A browser can't load it (CORS only allows map.meshcore.dev, and it's 55 MB), so the radio fetches
+// it in a background task: stream the JSON one node at a time, keep the ones near home that were
+// seen recently, save that (tens of KB) to flash. Same filter as MeshChat's Python server.
+const char* PUBLIC_URL = "https://map.meshcore.io/api/v1/nodes?binary=0&short=1";
+const double PUBLIC_RADIUS_KM = 90;
+const uint32_t PUBLIC_MAX_AGE = 30 * 86400;
+const uint32_t PUBLIC_REFRESH_MS = 12UL * 3600 * 1000, PUBLIC_RETRY_MS = 30UL * 60 * 1000;
+const int MAX_PUBLIC = 800;
+char* snap_public = nullptr; size_t snap_public_len = 0;   // {"fetched":..,"nodes":[..]}, PSRAM
+uint32_t public_fetched = 0, public_next_ms = 90000, public_took_s = 0;
+volatile bool public_running = false;
+char public_error[96] = "";
+
+double kmBetween(double la1, double lo1, double la2, double lo2) {
+  const double r = 0.017453292519943295;
+  double a = 0.5 - cos((la2 - la1) * r) / 2 + cos(la1 * r) * cos(la2 * r) * (1 - cos((lo2 - lo1) * r)) / 2;
+  return 12742 * asin(sqrt(a));
+}
+
+uint32_t parseIso(const char* s) {   // "2026-10-17T21:28:21.000Z" -> unix seconds (UTC)
+  int y, mo, d, h, mi, se;
+  if (!s || sscanf(s, "%d-%d-%dT%d:%d:%d", &y, &mo, &d, &h, &mi, &se) != 6) return 0;
+  y -= mo <= 2;
+  int era = (y >= 0 ? y : y - 399) / 400, yoe = y - era * 400;
+  int doy = (153 * (mo + (mo > 2 ? -3 : 9)) + 2) / 5 + d - 1, doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  long days = (long)era * 146097 + doe - 719468;
+  return (uint32_t)(days * 86400 + h * 3600 + mi * 60 + se);
+}
+
+// The TLS client, read in chunks (byte-at-a-time TLS reads are slow).
+class Source {
+  Client& c;
+public:
+  size_t total = 0;
+  explicit Source(Client& client) : c(client) {}
+  int read(uint8_t* buf, int max) {   // > 0 bytes, or 0 at the end / after 20 s without data
+    uint32_t start = millis();
+    while (true) {
+      int k = c.read(buf, max);
+      if (k > 0) { total += k; return k; }
+      if (!c.connected() && c.available() <= 0) return 0;
+      if (millis() - start > 20000) return 0;
+      vTaskDelay(1);
+    }
+  }
+};
+
+// The body as a Stream for ArduinoJson: inflated from gzip with the ROM's tinfl into a 32 KB ring,
+// or passed through as is. gzip is a third of the size, and lwIP's 5.7 KB receive window makes
+// the transfer, not the parsing, the slow part.
+class BodyStream : public Stream {
+  Source& src; bool gz; uint8_t* in; uint8_t* dict; tinfl_decompressor* inf;
+  size_t in_i = 0, in_n = 0, out_i = 0, out_n = 0, dict_ofs = 0;
+  bool header = false, done = false;
+  static const size_t IN_SZ = 4096;
+  int inByte() {
+    if (in_i >= in_n) { in_n = src.read(in, IN_SZ); in_i = 0; if (!in_n) return -1; }
+    return in[in_i++];
+  }
+  bool skipGzipHeader() {
+    uint8_t h[10];
+    for (int i = 0; i < 10; i++) { int b = inByte(); if (b < 0) return false; h[i] = b; }
+    if (h[0] != 0x1f || h[1] != 0x8b || h[2] != 8) return false;
+    int b;
+    if (h[3] & 4) { int lo = inByte(), hi = inByte(); if (hi < 0) return false; for (int n = lo | hi << 8; n > 0; n--) if (inByte() < 0) return false; }
+    if (h[3] & 8) { while ((b = inByte()) > 0) {} if (b < 0) return false; }    // file name
+    if (h[3] & 16) { while ((b = inByte()) > 0) {} if (b < 0) return false; }   // comment
+    if (h[3] & 2) { inByte(); inByte(); }                                        // header CRC
+    return true;
+  }
+  bool more() {   // the next run of body bytes into [out_i, out_n)
+    if (done) return false;
+    if (!gz) {
+      int k = src.read(dict, TINFL_LZ_DICT_SIZE);
+      if (k <= 0) { done = true; return false; }
+      out_i = 0; out_n = k; inflated += k;
+      return true;
+    }
+    if (!header) { header = true; if (!skipGzipHeader()) { failed = done = true; return false; } }
+    while (true) {
+      if (in_i >= in_n) { in_n = src.read(in, IN_SZ); in_i = 0; }
+      size_t avail_in = in_n - in_i, avail_out = TINFL_LZ_DICT_SIZE - dict_ofs;
+      tinfl_status st = tinfl_decompress(inf, in + in_i, &avail_in, dict, dict + dict_ofs, &avail_out, in_n ? TINFL_FLAG_HAS_MORE_INPUT : 0);
+      in_i += avail_in;
+      if (avail_out) {
+        out_i = dict_ofs; out_n = dict_ofs + avail_out; inflated += avail_out;
+        dict_ofs = (dict_ofs + avail_out) & (TINFL_LZ_DICT_SIZE - 1);
+        if (st == TINFL_STATUS_DONE) done = true;
+        return true;
+      }
+      if (st == TINFL_STATUS_DONE) { done = true; return false; }
+      if (st < 0 || !in_n) { failed = done = true; return false; }   // corrupt or cut short
+    }
+  }
+public:
+  size_t inflated = 0; bool failed = false;
+  BodyStream(Source& s, bool gzip, uint8_t* inbuf, uint8_t* ring, tinfl_decompressor* d) : src(s), gz(gzip), in(inbuf), dict(ring), inf(d) {
+    tinfl_init(inf);
+    setTimeout(20000);
+  }
+  int available() override { return out_i < out_n ? out_n - out_i : done ? 0 : 1; }
+  int read() override { if (out_i >= out_n && !more()) return -1; return dict[out_i++]; }
+  int peek() override { if (out_i >= out_n && !more()) return -1; return dict[out_i]; }
+  size_t write(uint8_t) override { return 0; }
+};
+
+volatile uint32_t public_rx = 0, public_size = 0, public_seen = 0;   // progress, for the UI
+
+void publicTask(void*) {
+  uint32_t t0 = millis(), now = time(nullptr);
+  double hl, ho;
+  { Lock l; hl = home_lat; ho = home_lon; }
+  const char* err = nullptr;
+  int kept = 0, seen = 0;
+  Buf out;
+  uint8_t* inbuf = (uint8_t*)palloc(4096);
+  uint8_t* ring = (uint8_t*)palloc(TINFL_LZ_DICT_SIZE);
+  tinfl_decompressor* inf = (tinfl_decompressor*)palloc(sizeof(tinfl_decompressor));
+  WiFiClientSecure* tls = new WiFiClientSecure();
+  HTTPClient http;
+  public_rx = public_size = public_seen = 0;
+  tls->setCACert(ISRG_ROOT_X1);
+  http.useHTTP10(true);   // no chunked encoding
+  http.setTimeout(20000);
+  http.setUserAgent("meshchat-radio/0.1");
+  const char* want[] = {"Content-Encoding"};
+  http.collectHeaders(want, 1);
+  if (!inbuf || !ring || !inf || !http.begin(*tls, PUBLIC_URL)) err = "out of memory";
+  else {
+    http.addHeader("Accept-Encoding", "gzip");
+    int code = http.GET();
+    if (code != 200) { static char e[48]; snprintf(e, sizeof(e), "map.meshcore.io answered %d", code); err = code < 0 ? "couldn't connect to map.meshcore.io" : e; }
+    else {
+      public_size = http.getSize() > 0 ? http.getSize() : 0;
+      Source src(*http.getStreamPtr());
+      BodyStream in(src, http.header("Content-Encoding") == "gzip", inbuf, ring, inf);
+      JsonDocument filter;
+      for (const char* k : {"public_key", "type", "adv_name", "last_advert", "adv_lat", "adv_lon"}) filter[k] = true;
+      filter["params"] = true;
+      out.f("{\"fetched\":%u,\"nodes\":[", now);
+      if (!in.find("[")) err = "unexpected answer from map.meshcore.io";
+      else do {
+        JsonDocument d;
+        if (deserializeJson(d, in, DeserializationOption::Filter(filter))) { if (!seen) err = "couldn't read the map data"; break; }
+        seen++;
+        if ((seen & 127) == 0) { public_rx = src.total; public_seen = seen; vTaskDelay(1); }   // let the web server and WiFi breathe
+        if (d["adv_lat"].isNull() || d["adv_lon"].isNull()) continue;
+        double la = d["adv_lat"], lo = d["adv_lon"];
+        if (la == 0 && lo == 0) continue;
+        double km = kmBetween(hl, ho, la, lo);
+        uint32_t ts = parseIso(d["last_advert"] | "");
+        const char* pk = d["public_key"] | "";
+        if (km > PUBLIC_RADIUS_KM || ts + PUBLIC_MAX_AGE < now || strlen(pk) != 64 || kept >= MAX_PUBLIC) continue;
+        int t = d["type"] | 0;
+        out.f("%s{\"pubkey\":\"%s\",\"name\":", kept ? "," : "", pk);
+        out.str(d["adv_name"] | "");
+        out.f(",\"type\":\"%s\",\"lat\":%.5f,\"lon\":%.5f,\"last_advert\":%u,\"km\":%.1f,\"radio\":", TYPE_NAME[t >= 0 && t <= 4 ? t : 0], la, lo, ts, km);
+        JsonObject prm = d["params"];
+        if (prm.isNull()) out.raw("null");
+        else out.f("\"%g/%g/SF%d/CR%d\"", prm["freq"] | 0.0, prm["bw"] | 0.0, prm["sf"] | 0, prm["cr"] | 0);
+        out.raw("}");
+        kept++;
+      } while (in.findUntil(",", "]"));
+      out.raw("]}");
+      if (!err && in.failed) err = "the download was cut short";
+      public_rx = src.total; public_seen = seen;
+      log_i("public map: %d of %d nodes kept, %u bytes in, %u out, %lus", kept, seen, (unsigned)src.total, (unsigned)in.inflated, (millis() - t0) / 1000);
+    }
+  }
+  http.end();
+  delete tls;
+  free(inbuf); free(ring); free(inf);
+  if (!err && seen < 100) err = "the map data ended early";
+  if (!err && out.p) {
+    // SPIFFS is safe to use from two tasks. One big write straight from PSRAM writes nothing,
+    // so copy it through a small internal buffer.
+    File f = SPIFFS.open("/wu_public.json", FILE_WRITE);
+    size_t w = 0;
+    if (f) {
+      uint8_t tmp[1024];
+      while (w < out.n) {
+        size_t k = out.n - w < sizeof(tmp) ? out.n - w : sizeof(tmp);
+        memcpy(tmp, out.p + w, k);
+        if (f.write(tmp, k) != k) break;
+        w += k;
+      }
+      f.close();
+    }
+    Lock l;
+    if (w != out.n) snprintf(public_error, sizeof(public_error), "downloaded, but saving it failed (%u of %u bytes)", (unsigned)w, (unsigned)out.n);
+    if (snap_public) free(snap_public);
+    snap_public = out.p; snap_public_len = out.n; out.p = nullptr;
+    public_fetched = now;
+    if (w == out.n) public_error[0] = 0;
+    public_took_s = (millis() - t0) / 1000;
+    public_next_ms = millis() + PUBLIC_REFRESH_MS;
+  } else {
+    Lock l;
+    strlcpy(public_error, err ? err : "out of memory", sizeof(public_error));
+    public_next_ms = millis() + PUBLIC_RETRY_MS;
+  }
+  if (!err) { Buf b; b.raw("\"public\""); broadcast("stale", b); }
+  public_running = false;
+  vTaskDelete(nullptr);
+}
+
+void loadPublic() {
+  File f = SPIFFS.open("/wu_public.json");
+  if (!f) return;
+  size_t n = f.size();
+  char* p = n ? (char*)palloc(n + 1) : nullptr;
+  if (p && f.read((uint8_t*)p, n) == n) {
+    p[n] = 0;
+    unsigned fetched = 0;
+    if (sscanf(p, "{\"fetched\":%u", &fetched) == 1) { snap_public = p; snap_public_len = n; public_fetched = fetched; p = nullptr; }
+  }
+  free(p);
+  f.close();
+}
+
+void publicTick() {
+  if (public_running || (int32_t)(millis() - public_next_ms) < 0 || WiFi.status() != WL_CONNECTED || time(nullptr) < 1700000000) return;
+  uint32_t age = public_fetched ? time(nullptr) - public_fetched : UINT32_MAX;
+  if (age < PUBLIC_REFRESH_MS / 1000) { public_next_ms = millis() + (PUBLIC_REFRESH_MS / 1000 - age) * 1000; return; }   // the saved copy is fresh
+  // TLS needs ~45 KB of internal RAM; don't starve WiFi, Bluetooth and the web server for it
+  if (heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT) < 40000 || heap_caps_get_free_size(MALLOC_CAP_INTERNAL) < 60000) {
+    strlcpy(public_error, "not enough free memory right now", sizeof(public_error));
+    public_next_ms = millis() + PUBLIC_RETRY_MS;
+    return;
+  }
+  public_running = true;
+  if (xTaskCreatePinnedToCore(publicTask, "pubmap", 12288, nullptr, 1, nullptr, 0) != pdPASS) {
+    public_running = false;
+    strlcpy(public_error, "couldn't start the download", sizeof(public_error));
+    public_next_ms = millis() + PUBLIC_RETRY_MS;
+  }
+}
+
+// ---------------------------------------------------------------- web helpers
+bool hostAllowed(AsyncWebServerRequest* r) {
+  String h = r->host();
+  int c = h.indexOf(':');
+  if (c >= 0) h = h.substring(0, c);
+  h.toLowerCase();
+  if (h == WiFi.localIP().toString() || h == WiFi.softAPIP().toString()) return true;
+#ifdef WIFI_PORTAL
+  if (h.endsWith(".local") && wifinet::isOwnName(h.substring(0, h.length() - 6).c_str())) return true;   // incl. the built-in name
+#endif
+  return false;
+}
+// DNS-rebinding and CSRF protection, like MeshChat's Python server
+bool guard(AsyncWebServerRequest* r, bool write) {
+  if (!hostAllowed(r)) { r->send(403, "text/plain", "unexpected Host header"); return false; }
+  if (write && r->hasHeader("Origin")) {
+    String o = r->header("Origin");
+    if (o != "http://" + r->host()) { r->send(403, "text/plain", "cross-origin request refused"); return false; }
+  }
+  return true;
+}
+void sendBuf(AsyncWebServerRequest* r, std::shared_ptr<Buf> b, const char* type = "application/json") {
+  AsyncWebServerResponse* res = r->beginResponse(type, b->n, [b](uint8_t* out, size_t max, size_t index) -> size_t {
+    size_t n = b->n - index < max ? b->n - index : max;
+    memcpy(out, b->p + index, n);
+    return n;
+  });
+  res->addHeader("Cache-Control", "no-store");
+  r->send(res);
+}
+void queueAction(const Action& a) { Lock l; actions.push_back(a); }
+
+void stateJson(Buf& b) {
+  NodePrefs* np = mesh->getNodePrefs();
+  char pk[65]; hexLower(pk, mesh->self_id.pub_key, 32);
+  b.raw("{\"device\":true,\"connected\":true,\"port\":\"built-in\",");
+  b.raw("\"features\":{\"repeaters\":true,\"public_map\":true,\"transport\":false,\"ble_pin\":true,\"local_analysis\":true,\"listening\":true,\"networks\":true,\"add_contact\":true,\"ota\":true,\"rooms\":true,\"route_history\":true},");
+  b.raw("\"connection\":{\"transport\":\"device\",\"serial_port\":\"\",\"tcp_host\":\"\",\"tcp_port\":5000},");
+  b.raw("\"self\":{\"name\":"); b.str(np->node_name);
+  b.f(",\"pubkey\":\"%s\",\"tx_power\":%d,\"radio\":{\"freq\":%.3f,\"bw\":%g,\"sf\":%u,\"cr\":%u},", pk, np->tx_power_dbm, np->freq, np->bw, np->sf, np->cr);
+  b.f("\"fw\":\"%s-meshchat\",\"model\":\"%s\",\"path_hash_mode\":%u,\"loc_policy\":%u},", FIRMWARE_VERSION, board.getManufacturerName(), np->path_hash_mode, np->advert_loc_policy);
+  b.raw("\"channels\":[");
+  for (int i = 0; i < chan_count; i++) {
+    b.f("%s{\"idx\":%u,\"name\":", i ? "," : "", chans[i].idx);
+    b.str(chans[i].name);
+    b.f(",\"hash\":\"%02x\"}", chans[i].hash);
+  }
+  b.raw("],\"rooms\":");
+  roomsJson(b);
+  b.raw(",\"contacts\":");
+  if (snap_contacts) b.raw(snap_contacts, snap_contacts_len); else b.raw("{}");
+  b.raw(",\"heard\":{");
+  uint16_t net = curNet();
+  for (int i = 0, shown = 0; i < heard_count; i++) {
+    Heard& hd = heard[i];
+    if (hd.net != net) continue;   // heard on another network
+    char k[65]; hexLower(k, hd.key, 32);
+    b.f("%s\"%s\":{\"pubkey\":\"%s\",\"name\":", shown++ ? "," : "", k, k);
+    b.str(hd.name);
+    b.f(",\"type\":%u,\"lat\":", hd.type);
+    if (hd.has_loc) b.f("%.6f,\"lon\":%.6f", hd.lat / 1e6, hd.lon / 1e6); else b.raw("null,\"lon\":null");
+    b.f(",\"first_heard\":%u,\"last_heard\":%u,\"snr\":%.2f,\"rssi\":%d,\"hops\":%u,\"path\":", hd.first, hd.last, hd.snr4 / 4.0, hd.rssi, hd.hops);
+    b.hex(hd.path, hd.path_n);
+    b.f(",\"hash_size\":%u,\"count\":%u}", hd.hash_size, hd.count);
+  }
+  b.raw("},\"conversations\":{");
+  // newest message per conversation
+  bool first = true;
+  for (int i = msg_count - 1; i >= 0; i--) {
+    Msg* m = msgAt(i);
+    if (!visible(m)) continue;
+    bool later = false;
+    for (int j = i + 1; j < msg_count && !later; j++) if (sameConv(msgAt(j), m->kind, m->chan, m->key) && visible(msgAt(j))) later = true;
+    if (later) continue;
+    int n = 0;
+    for (int j = 0; j <= i; j++) if (sameConv(msgAt(j), m->kind, m->chan, m->key) && visible(msgAt(j))) n++;
+    b.raw(first ? "" : ","); first = false;
+    convId(b, m);
+    b.raw(":{\"conv\":"); convId(b, m);
+    b.f(",\"last_id\":%u,\"n\":%d,\"last_ts\":%u}", m->id, n, m->ts);
+  }
+  b.f("},\"home\":{\"lat\":%.6f,\"lon\":%.6f,\"label\":\"Home\"},", home_lat, home_lon);
+  if (advert_ts) { b.f("\"advertised\":{\"ts\":%u,\"flood\":%s,\"name\":", advert_ts, advert_flood ? "true" : "false"); b.str(advert_name); b.raw("},"); }
+  else b.raw("\"advertised\":null,");
+  b.f("\"limits\":{\"max_text_bytes\":%d,\"min_send_interval\":0,\"flood_advert_cooldown\":0,\"flood_advert_wait\":0}}", MAX_TEXT);
+}
+
+int parseConv(const String& conv, uint8_t& kind, uint8_t& chan, uint8_t* key) {
+  if (conv.startsWith("chan:")) { kind = 0; chan = conv.substring(5).toInt(); return chanByIdx(chan) ? 1 : 0; }
+  if (conv.startsWith("dm:") && conv.length() == 67) { kind = 1; return hexToBytes(conv.c_str() + 3, key, 32) ? 1 : 0; }
+  if (conv.startsWith("watch:") && conv.length() <= 6 + 31) { kind = 2; memset(key, 0, 32); strlcpy((char*)key, conv.c_str() + 6, 32); return 1; }
+  return 0;
+}
+
+void setupRoutes() {
+  DefaultHeaders::Instance().addHeader("Content-Security-Policy",
+    "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; "
+    "font-src 'self' data:; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'");
+  DefaultHeaders::Instance().addHeader("X-Content-Type-Options", "nosniff");
+  DefaultHeaders::Instance().addHeader("Referrer-Policy", "strict-origin-when-cross-origin");
+
+  ws.setFilter([](AsyncWebServerRequest* r) {
+    if (!hostAllowed(r)) return false;
+    return !r->hasHeader("Origin") || r->header("Origin") == "http://" + r->host();
+  });
+  server.addHandler(&ws);
+
+  server.on("/api/state", HTTP_GET, [](AsyncWebServerRequest* r) {
+    if (!guard(r, false)) return;
+    auto b = std::make_shared<Buf>();
+    { Lock l; stateJson(*b); }
+    sendBuf(r, b);
+  });
+  server.on("/api/messages", HTTP_GET, [](AsyncWebServerRequest* r) {
+    if (!guard(r, false)) return;
+    uint8_t kind = 0, chan = 0, key[32] = {0};
+    String conv = r->hasParam("conv") ? r->getParam("conv")->value() : "";
+    auto b = std::make_shared<Buf>();
+    b->raw("[");
+    if (conv.startsWith("chan:") || conv.startsWith("dm:") || conv.startsWith("watch:")) {
+      if (conv.startsWith("chan:")) { kind = 0; chan = conv.substring(5).toInt(); }
+      else if (conv.startsWith("watch:")) { kind = 2; strlcpy((char*)key, conv.c_str() + 6, 32); }
+      else { kind = 1; hexToBytes(conv.c_str() + 3, key, 32); }
+      Lock l;
+      int start = 0, n = 0;
+      for (int i = msg_count - 1; i >= 0; i--) if (sameConv(msgAt(i), kind, chan, key) && visible(msgAt(i)) && ++n == 300) { start = i; break; }   // last 300
+      bool first = true;
+      for (int i = start; i < msg_count; i++) {
+        Msg* m = msgAt(i);
+        if (!sameConv(m, kind, chan, key) || !visible(m)) continue;
+        if (!first) b->raw(",");
+        first = false;
+        msgJson(*b, m);
+      }
+    }
+    b->raw("]");
+    sendBuf(r, b);
+  });
+  server.on("/api/packets", HTTP_GET, [](AsyncWebServerRequest* r) {
+    if (!guard(r, false)) return;
+    auto b = std::make_shared<Buf>();
+    int limit = r->hasParam("limit") ? r->getParam("limit")->value().toInt() : 300;
+    if (limit < 1 || limit > MAX_PKTS) limit = MAX_PKTS;
+    b->raw("[");
+    Lock l;
+    uint16_t net = curNet();
