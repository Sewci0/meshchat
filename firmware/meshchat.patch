+}  // namespace
+
+void onQueued(const uint8_t* frame, int len) { if (mesh) onQueuedFrame(frame, len); }
+void onAppSend(const uint8_t* cmd, int len) { if (mesh) onAppSendCmd(cmd, len); }
+
+BaseSerialInterface* begin(MyMesh* m) {
+  mesh = m;
+  mtx = xSemaphoreCreateRecursiveMutex();
+  msgs = (Msg*)palloc(sizeof(Msg) * MAX_MSGS);
+  pkts = (Pkt*)palloc(sizeof(Pkt) * MAX_PKTS);
+  heard = (Heard*)palloc(sizeof(Heard) * MAX_HEARD);
+  lives = (Live*)palloc(sizeof(Live) * MAX_LIVE);
+  clis = (CliLog*)palloc(sizeof(CliLog) * MAX_CLI_NODES);
+  loadSmallState();
+  if (!legacy_net) { legacy_net = curNet(); saveSmallState(); }   // first start with networks: earlier history was on this one
+  loadPublic();
+  loadHistory();
+  loadRoutes();
+  loadRooms();
+  reloadChannels();
+  loadWatches();
+  uint8_t q[2] = {CMD_DEVICE_QUERY, 3};   // ask for v3 message frames (with SNR)
+  queueCmd(K_OTHER, 0, q, 2);
+  setupRoutes();
+  return &app_link;
+}
+
+void loop() {
+  uint32_t ms = millis();
+  if (awaiting != K_NONE && ms - awaiting_since > 3000) awaiting = K_NONE;   // never stall on a lost reply
+  if (restart_at && (int32_t)(ms - restart_at) > 0) { mesh->flushToFlash(); ESP.restart(); }
+
+  // actions from the web task
+  std::deque<Action> todo;
+  { Lock l; todo.swap(actions); }
+  for (Action& a : todo) {
+    switch (a.type) {
+      case A_SEND: case A_RESEND: {
+        Lock l;
+        Msg* m = findMsg(a.id);
+        if (!m) break;
+        if (a.type == A_SEND) { m->sender_ts = mesh->getRTCClock()->getCurrentTimeUnique(); persistMsg(m); }
+        else persistUpdate(m);
+        if (m->kind == 0) sendChan(m); else sendDm(m, false);
+        break;
+      }
+      case A_ADVERT: {
+        uint8_t f[2] = {CMD_SEND_SELF_ADVERT, (uint8_t)a.a};
+        queueCmd(K_ADVERT, 0, f, 2);
+        advert_ts = wallNow();
+        advert_flood = advert_flood || a.a;
+        strlcpy(advert_name, mesh->getNodePrefs()->node_name, sizeof(advert_name));
+        break;
+      }
+      case A_NAME: {
+        uint8_t f[33] = {CMD_SET_ADVERT_NAME};
+        size_t n = strlen(a.s1); memcpy(&f[1], a.s1, n);
+        queueCmd(K_NAME, 0, f, 1 + n);
+        break;
+      }
+      case A_CH_SET: {
+        uint8_t f[2 + 32 + 16] = {CMD_SET_CHANNEL, (uint8_t)a.a};
+        strncpy((char*)&f[2], a.s1, 32);
+        if (a.s1[0]) memcpy(&f[34], a.secret, 16);
+        queueCmd(K_CHANNEL, 0, f, sizeof(f));
+        break;
+      }
+      case A_RESET_PATH: {   // forget the saved route: the next message floods and learns a fresh one
+        uint8_t f[1 + 32] = {CMD_RESET_PATH};
+        memcpy(&f[1], a.key, 32);
+        queueCmd(K_CONTACT, 0, f, sizeof(f));
+        break;
+      }
+      case A_CONTACT_ADD: {   // the same command the MeshCore apps send for a scanned contact
+        // the whole record, position included (0, 0: none): for a new contact the radio starts from
+        // uninitialised memory, so a field left out of the frame comes out as garbage
+        uint8_t f[1 + 32 + 3 + MAX_PATH_SIZE + 32 + 4 + 8] = {CMD_ADD_UPDATE_CONTACT};
+        size_t i = 1;
+        memcpy(&f[i], a.key, 32); i += 32;
+        f[i++] = (uint8_t)a.a;           // type
+        f[i++] = 0;                      // flags
+        f[i++] = OUT_PATH_UNKNOWN;       // no route yet: flood until one is learnt
+        i += MAX_PATH_SIZE;
+        strncpy((char*)&f[i], a.s1, 32); i += 32;
+        // last advert 0 (we haven't heard one), then latitude and longitude 0: all still zero
+        queueCmd(K_CONTACT, 0, f, sizeof(f));
+        break;
+      }
+      case A_TIME: {
+        if ((uint32_t)a.a > now_s() + 5) { uint8_t f[5] = {CMD_SET_DEVICE_TIME}; memcpy(&f[1], &a.a, 4); queueCmd(K_OTHER, 0, f, 5); }
+        break;
+      }
+      case A_HOME: home_lat = a.lat; home_lon = a.lon; saveSmallState(); public_fetched = 0; public_next_ms = millis() + 5000; break;
+      case A_QUERY: queryStart(a.key, a.s2); memset(a.s2, 0, sizeof(a.s2)); break;
+      case A_CLI: cliSend(a.key, a.text); memset(a.text, 0, sizeof(a.text)); break;
+      case A_ROOM_LEAVE: {   // stop showing its posts; tell the radio to stop any keep-alives
+        Lock l;
+        Room* r = roomFind(a.key);
+        if (r && !r->left) { r->left = 1; r->left_at = wallNow(); saveRooms(); }
+        uint8_t f[33] = {CMD_LOGOUT}; memcpy(&f[1], a.key, 32); queueCmd(K_OTHER, 0, f, 33);
+        emitStale();
+        break;
+      }
+      case A_RADIO: {   // another network: MeshCore applies it at once and saves it
+        uint8_t f[11] = {CMD_SET_RADIO_PARAMS};
+        uint32_t khz = (uint32_t)(a.lat * 1000 + 0.5), hz = (uint32_t)(a.lon * 1000 + 0.5);
+        memcpy(&f[1], &khz, 4); memcpy(&f[5], &hz, 4); f[9] = (uint8_t)(a.a >> 8); f[10] = (uint8_t)a.a;
+        queueCmd(K_RADIO, 0, f, sizeof(f));
+        break;
+      }
+#ifdef WIFI_PORTAL
+      case A_HOSTNAME: {
+        NodePrefs* np = mesh->getNodePrefs();
+        strlcpy(np->wifi_hostname, a.s1, sizeof(np->wifi_hostname));
+        mesh->savePrefs();
+        wifinet::hostnameChanged();
+        break;
+      }
+      case A_JOIN: {
+        char err[96];
+        if (!wifinet::applySetup(a.s1, a.s2, "", err, sizeof(err))) { /* invalid input was rejected by the API already */ }
+        memset(a.s2, 0, sizeof(a.s2));
+        break;
+      }
+      case A_NET_ADD: {   // a = 1: make it preferred and restart to join it now
+        char err[96];
+        bool ok = wifinet::addNetwork(a.s1, a.s2, a.a != 0, err, sizeof(err));
+        memset(a.s2, 0, sizeof(a.s2));
+        if (ok && a.a) restart_at = millis() + 1500;
+        emitWifi();
+        break;
+      }
+      case A_NET_REMOVE: wifinet::removeNetwork(a.s1); emitWifi(); break;
+      case A_DELETE: persistDelete(a.id); break;
+      case A_DELETE_CONV: persistDeleteConv((uint8_t)(a.a >> 8), (uint8_t)a.a, a.key, a.net, a.id); break;
+      case A_NET_PREFER: wifinet::preferNetwork(a.s1); emitWifi(); break;
+#endif
+      case A_PIN: mesh->getNodePrefs()->ble_pin = a.a; mesh->savePrefs(); break;
+      case A_REBOOT: restart_at = millis() + 500; break;
+      default: break;
+    }
+  }
+
+  // retries
+  {
+    Lock l;
+    for (int i = msg_count - 1, n = 0; i >= 0 && n < 60; i--, n++) {
+      Msg* m = msgAt(i);
+      if (m->dir != 1 || !m->retry_at || (int32_t)(ms - m->retry_at) < 0) continue;
+      m->retry_at = 0;
+      if (m->kind == 1 && m->status == ST_SENDING) {          // DM without ACK: direct twice, then flood
+        if (m->attempts < 3) { m->attempts++; sendDm(m, m->attempts == 3); persistUpdate(m); emitMsg(m); }
+        else { m->status = ST_NO_ACK; persistUpdate(m); emitMsg(m); }
+      } else if (m->kind == 0 && m->status == ST_SENT) {      // nobody repeated it: send the identical packet again
+        if (m->attempts < 3) { m->attempts++; sendChan(m); persistUpdate(m); emitMsg(m); }
+        else { m->status = ST_NOT_HEARD; persistUpdate(m); emitMsg(m); }
+      }
+    }
+  }
+
+  queryTick();
+  publicTick();
+  if (routes_dirty_at && ms - routes_dirty_at > 5000) { routes_dirty_at = 0; saveRoutes(); }
+
+  // snapshots, clock, housekeeping
+  if (chans_dirty) { reloadChannels(); emitStale(); }
+  if ((contacts_dirty && ms - last_snapshot > 3000) || ms - last_snapshot > 120000 || !snap_contacts) {
+    last_snapshot = ms;
+    rebuildContacts();
+    emitStale();
+  }
+  if (!sntp_started && WiFi.status() == WL_CONNECTED) { configTime(0, 0, "pool.ntp.org", "time.google.com"); sntp_started = true; }
+  static uint32_t last_clock = 0;
+  if (ms - last_clock > 60000) {
+    last_clock = ms;
+    time_t t = time(nullptr);
+    if (t > 1700000000 && (uint32_t)t > now_s() + 5) { uint8_t f[5] = {CMD_SET_DEVICE_TIME}; uint32_t tt = t; memcpy(&f[1], &tt, 4); queueCmd(K_OTHER, 0, f, 5); }
+    ws.cleanupClients();
+  }
+}
+
+}  // namespace webui
+#endif
diff --git a/examples/companion_radio/WebUi.h b/examples/companion_radio/WebUi.h
new file mode 100644
index 0000000..7a465cc
--- /dev/null
+++ b/examples/companion_radio/WebUi.h
@@ -0,0 +1,28 @@
+#pragma once
+// MeshChat on the radio itself (MeshChat addition, not upstream MeshCore).
+//
+// The web UI is a *built-in app*: it plugs into the interface manager like the USB/WiFi/BLE
+// links and speaks the normal companion protocol, so MeshCore handles sending, ACKs, saving and
+// adverts exactly as for any app. Every frame the firmware writes is broadcast to all links,
+// so other apps (USB, WiFi, Bluetooth) keep working alongside it and see the same messages.
+//
+// Incoming messages: MeshCore keeps them in its offline queue until an app fetches them. The web
+// UI records each one as it's queued (onQueued) and leaves the queue to the phone/desktop apps,
+// so they still get everything that arrived while they were away. Messages those apps send are
+// recorded too (onAppSend), so the web history has the whole conversation.
+//
+// Threads: the mesh, this module's loop() and the app link run in the Arduino main task.
+// HTTP/WebSocket handlers run in the async TCP task: they only read this module's own data
+// (behind a mutex) and queue actions that loop() performs.
+#ifdef WEB_UI
+#include <helpers/BaseSerialInterface.h>
+
+class MyMesh;
+
+namespace webui {
+  BaseSerialInterface* begin(MyMesh* mesh);   // returns the link to register with the interface manager
+  void loop();
+  void onQueued(const uint8_t* frame, int len);    // MyMesh::addToOfflineQueue
+  void onAppSend(const uint8_t* cmd, int len);     // MyMesh::handleCmdFrame, before a text send or a path reset
+}
+#endif
diff --git a/examples/companion_radio/WifiPortal.cpp b/examples/companion_radio/WifiPortal.cpp
new file mode 100644
index 0000000..45dda95
--- /dev/null
+++ b/examples/companion_radio/WifiPortal.cpp
@@ -0,0 +1,650 @@
+// See WifiPortal.h. MeshChat addition to the MeshCore companion firmware.
+#ifdef WIFI_PORTAL
+#include "WifiPortal.h"
+#include "NodePrefs.h"
+#include <Arduino.h>
+#include <DNSServer.h>
+#include <ESPmDNS.h>
+#include <mdns.h>
+#include <SPIFFS.h>
+#include <WebServer.h>
+#include <WiFi.h>
+
+namespace wifinet {
+namespace {
+
+const uint32_t JOIN_TIMEOUT = 45000;          // no IP this long after boot -> open the hotspot
+const uint32_t LOST_TIMEOUT = 10UL * 60000;   // network gone this long -> open the hotspot
+const uint32_t AUTO_SETUP_LIMIT = 10UL * 60000; // an automatic hotspot nobody uses closes and retries
+const uint32_t RETRY_EVERY = 15000;
+const uint32_t SETUP_RETRY_EVERY = 60000;      // with the hotspot up: try the saved network this often, when nobody's on it
+const uint8_t AUTH_GIVE_UP = 3;               // a network refused the password this many times in a row: stop trying it
+const char* AP_PASSWORD = "meshcore";         // WPA2 needs 8+ chars; documented in MeshChat's README
+
+enum Mode { OFF, STATION, SETUP };
+
+NodePrefs* prefs = nullptr;
+void (*save)() = nullptr;
+uint16_t port = 5000;
+char host[33] = {0};
+char default_host[33] = {0};   // built-in "meshcore-xxxx": always answered, so renaming never breaks bookmarks or the home-screen app
+char prev_host[33] = {0};      // the name before the last rename: answered until restart, so open pages keep working
+char ap_name[33] = {0};
+Mode mode = OFF;
+bool forced = false;           // opened by button/CLI: stays until settings are saved
+bool requested = false;
+bool ever_connected = false;
+// mDNS is started once per boot and never stopped. mdns_free() followed by mdns_init() (MDNS.end()
+// then MDNS.begin()) leaves the responder answering nothing, not even unicast queries, until the
+// next reboot: so a WiFi drop, a rename or the quick reconnect after a power-on used to kill
+// <hostname>.local. The mdns component follows WiFi up/down (and the hotspot) by itself; renames
+// change the name in place, and the aliases are re-pointed at our current addresses.
+bool mdns_up = false;
+char mdns_host[33] = {0};      // the name the responder currently answers as
+char aliases[2][33] = {{0}};   // delegated names currently registered
+uint32_t boot_ms = 0, setup_since = 0, last_retry = 0, lost_since = 0, restart_at = 0;
+volatile bool ev_got_ip = false, ev_lost = false;
+volatile uint8_t ev_auth_fails = 0;   // disconnects where the network refused our password (event task -> loop)
+char trying[33] = {0};                // the network the station is joining (what ev_auth_fails is about)
+WebServer* web = nullptr;
+
+// Time since t, with millis() read now. Not loop()'s `now`: these stamps can be set later in the same
+// pass (pickFromScan() -> beginNet() sets last_retry), and `now - last_retry` then wrapped to ~49 days,
+// so the retry fired at once: with several saved networks every join was cut off by a new scan 3 s
+// later, the radio never connected, and the setup hotspot was off its channel most of the time.
+uint32_t since(uint32_t t) { return millis() - t; }
+DNSServer* dns = nullptr;
+
+// ---- saved networks --------------------------------------------------------
+// Up to MAX_NETS, most preferred first, in their own file (one per line: hex(ssid) hex(password)).
+// The first is mirrored into MeshCore's prefs, so the wifi.ssid / wifi.pwd CLI keeps working.
+const int MAX_NETS = 8;
+const int MIN_RSSI = -85;   // weaker than this, a less preferred but stronger network wins
+const char* NETS_FILE = "/wifi_nets";
+// auth_fails: refusals in a row since the last success or password change (this boot only, not saved)
+struct Net { char ssid[33]; char pwd[64]; uint8_t auth_fails; };
+Net nets[MAX_NETS];
+int net_count = 0, rr_next = 0;
+bool scan_to_join = false;
+
+bool haveSaved() { return net_count > 0; }
+
+// A wrong password never fixes itself, and every attempt takes the radio off the hotspot's channel
+// (the station scans all channels, then joins the network's), so the phone meant to fix the password
+// may fail to join the hotspot. Once a network has refused it a few times, it's left alone (until
+// its password is changed, or the hotspot's periodic retry) and the hotspot opens right away.
+bool rejected(int i) { return nets[i].auth_fails >= AUTH_GIVE_UP; }
+int usableCount() {
+  int n = 0;
+  for (int i = 0; i < net_count; i++) if (!rejected(i)) n++;
+  return n;
+}
+bool passwordRefused(uint8_t reason) {
+  return reason == WIFI_REASON_AUTH_FAIL || reason == WIFI_REASON_4WAY_HANDSHAKE_TIMEOUT ||
+         reason == WIFI_REASON_HANDSHAKE_TIMEOUT || reason == WIFI_REASON_MIC_FAILURE ||
+         reason == WIFI_REASON_802_1X_AUTH_FAILED;
+}
+
+int findNet(const char* ssid) {
+  for (int i = 0; i < net_count; i++) if (strcmp(nets[i].ssid, ssid) == 0) return i;
+  return -1;
+}
+
+void hexOut(File& f, const char* s) { for (const char* c = s; *c; c++) f.printf("%02x", (uint8_t)*c); }
+void hexIn(const String& h, char* out, size_t cap) {
+  size_t n = 0;
+  for (size_t i = 0; i + 1 < h.length() && n < cap - 1; i += 2) out[n++] = (char)strtol(h.substring(i, i + 2).c_str(), nullptr, 16);
+  out[n] = 0;
+}
+
+void saveNets() {
+  File f = SPIFFS.open(NETS_FILE, FILE_WRITE);
+  if (f) {
+    for (int i = 0; i < net_count; i++) { hexOut(f, nets[i].ssid); f.print(' '); hexOut(f, nets[i].pwd); f.print('\n'); }
+    f.close();
+  }
+  // mirror the preferred one into MeshCore's prefs
+  strncpy(prefs->wifi_ssid, net_count ? nets[0].ssid : "", sizeof(prefs->wifi_ssid) - 1);
+  strncpy(prefs->wifi_pwd, net_count ? nets[0].pwd : "", sizeof(prefs->wifi_pwd) - 1);
+  save();
+}
+
+void loadNets() {
+  net_count = 0;
+  if (SPIFFS.exists(NETS_FILE)) {
+    File f = SPIFFS.open(NETS_FILE);
+    while (f && f.available() && net_count < MAX_NETS) {
+      String line = f.readStringUntil('\n');
+      int sp = line.indexOf(' ');
+      if (sp <= 0) continue;
+      Net& n = nets[net_count];
+      hexIn(line.substring(0, sp), n.ssid, sizeof(n.ssid));
+      hexIn(line.substring(sp + 1), n.pwd, sizeof(n.pwd));
+      if (n.ssid[0]) net_count++;
+    }
+    if (f) f.close();
+  }
+  // a network set another way (CLI, older firmware) becomes the preferred one
+  if (prefs->wifi_ssid[0] && findNet(prefs->wifi_ssid) != 0) {
+    int i = findNet(prefs->wifi_ssid);
+    if (i < 0) i = net_count < MAX_NETS ? net_count++ : MAX_NETS - 1;
+    for (int k = i; k > 0; k--) nets[k] = nets[k - 1];
+    strncpy(nets[0].ssid, prefs->wifi_ssid, sizeof(nets[0].ssid) - 1); nets[0].ssid[32] = 0;
+    strncpy(nets[0].pwd, prefs->wifi_pwd, sizeof(nets[0].pwd) - 1); nets[0].pwd[63] = 0;
+    saveNets();
+  }
+}
+
+void macSuffix(char* out, size_t n, bool upper) {
+  uint8_t mac[6];
+  WiFi.macAddress(mac);
+  snprintf(out, n, upper ? "%02X%02X" : "%02x%02x", mac[4], mac[5]);
+}
+
+void loadHostname() {
+  char sfx[8];
+  macSuffix(sfx, sizeof(sfx), false);
+  snprintf(default_host, sizeof(default_host), "meshcore-%s", sfx);
+  if (prefs->wifi_hostname[0] && validHostname(prefs->wifi_hostname)) strncpy(host, prefs->wifi_hostname, sizeof(host) - 1);
+  else strncpy(host, default_host, sizeof(host) - 1);
+  host[sizeof(host) - 1] = 0;
+}
+
+// Our current address(es), for the aliases: the home network's and, while it's up, the hotspot's.
+int ourAddrs(mdns_ip_addr_t a[2]) {
+  int n = 0;
+  memset(a, 0, 2 * sizeof(mdns_ip_addr_t));
+  if (WiFi.status() == WL_CONNECTED) { a[n].addr.type = ESP_IPADDR_TYPE_V4; a[n].addr.u_addr.ip4.addr = (uint32_t)WiFi.localIP(); n++; }
+  if (WiFi.getMode() & WIFI_MODE_AP) { a[n].addr.type = ESP_IPADDR_TYPE_V4; a[n].addr.u_addr.ip4.addr = (uint32_t)WiFi.softAPIP(); n++; }
+  if (n == 2) a[0].next = &a[1];
+  return n;
+}
+
+// Answer for other names too, at our address(es): mDNS "delegated" host names. Wanted: the
+// built-in name and the one before the last rename, unless it's the name we answer as anyway.
+void syncAliases() {
+  const char* want[2] = {default_host, prev_host};
+  for (auto& w : want) if (!w[0] || strcmp(w, host) == 0) w = "";
+  if (strcmp(want[0], want[1]) == 0) want[1] = "";
+  mdns_ip_addr_t a[2];
+  int n = ourAddrs(a);
+  for (int i = 0; i < 2; i++) {   // drop the ones no longer wanted (or with nowhere to point)
+    if (!aliases[i][0]) continue;
+    bool keep = n && (strcmp(aliases[i], want[0]) == 0 || strcmp(aliases[i], want[1]) == 0);
+    if (!keep) { mdns_delegate_hostname_remove(aliases[i]); aliases[i][0] = 0; }
+  }
+  if (!n) return;
+  for (const char* w : want) {   // (re)register each at our current addresses
+    if (!w[0]) continue;
+    int slot = -1;
+    for (int i = 0; i < 2; i++) if (strcmp(aliases[i], w) == 0) slot = i;
+    if (slot >= 0) mdns_delegate_hostname_remove(w);   // this core has no set_address: re-add
+    for (int i = 0; i < 2 && slot < 0; i++) if (!aliases[i][0]) slot = i;
+    if (slot < 0) continue;
+    if (mdns_delegate_hostname_add(w, a) == ESP_OK) strlcpy(aliases[slot], w, sizeof(aliases[slot]));
+    else aliases[slot][0] = 0;
+  }
+}
+
+// Start mDNS (once), or bring it up to date: our name, the node name in the TXT record, aliases.
+void startMdns() {
+  if (!mdns_up) {
+    mdns_up = MDNS.begin(host);
+    if (!mdns_up) return;
+    strlcpy(mdns_host, host, sizeof(mdns_host));
+    MDNS.addService("meshcore", "tcp", port);
+  } else if (strcmp(mdns_host, host) != 0 && mdns_hostname_set(host) == ESP_OK) {
+    strlcpy(mdns_host, host, sizeof(mdns_host));
+  }
+  MDNS.addServiceTxt("meshcore", "tcp", "node", (const char*)prefs->node_name);
+  syncAliases();
+}
+
+void beginNet(int i) {
+  strlcpy(trying, nets[i].ssid, sizeof(trying));
+  WiFi.begin(nets[i].ssid, nets[i].pwd[0] ? nets[i].pwd : nullptr);
+  last_retry = millis();
+}
+
+void joinSaved() {
+  if (!haveSaved()) return;
+  last_retry = millis();
+  int usable = usableCount();
+  if (!usable) return;   // each saved network refused its password: the setup hotspot is how to fix that
+  if (usable == 1) {
+    for (int i = 0; i < net_count; i++) if (!rejected(i)) { beginNet(i); return; }
+  }
+  // several: look around first (finished in pickFromScan)
+  if (WiFi.scanComplete() != WIFI_SCAN_RUNNING) { WiFi.disconnect(false); WiFi.scanNetworks(true); }
+  scan_to_join = true;
+}
+
+void pickFromScan() {
+  int n = WiFi.scanComplete();
+  if (!scan_to_join || n == WIFI_SCAN_RUNNING) return;
+  scan_to_join = false;
+  int best = -1, strongest = -1, strongest_rssi = -1000;
+  for (int i = 0; i < net_count && best < 0; i++) {
+    if (rejected(i)) continue;
+    for (int k = 0; k < n; k++) {
+      if (WiFi.SSID(k) != nets[i].ssid) continue;
+      int r = WiFi.RSSI(k);
+      if (r >= MIN_RSSI) { best = i; break; }
+      if (r > strongest_rssi) { strongest_rssi = r; strongest = i; }
+    }
+  }
+  if (best < 0) best = strongest;
+  for (int t = 0; t < net_count && best < 0; t++) {   // none in sight (or hidden): take turns
+    int i = rr_next++ % net_count;
+    if (!rejected(i)) best = i;
+  }
+  if (best >= 0) beginNet(best);
+}
+
+// ---- setup page ------------------------------------------------------------
+// Nearby network names are attacker-controlled: always escape before putting them in HTML.
+String esc(const String& s) {
+  String o;
+  o.reserve(s.length() + 8);
+  for (size_t i = 0; i < s.length(); i++) {
+    char c = s[i];
+    switch (c) {
+      case '&': o += F("&amp;"); break;
+      case '<': o += F("&lt;"); break;
+      case '>': o += F("&gt;"); break;
+      case '"': o += F("&quot;"); break;
+      case '\'': o += F("&#39;"); break;
+      default: o += c;
+    }
+  }
+  return o;
+}
+
+String formAction();   // defined after the page builder
+
+const char PAGE_HEAD[] PROGMEM = R"(<!doctype html><html lang="en"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1"><title>MeshCore WiFi setup</title><style>
+:root{color-scheme:light dark;--b:#e5e5e5;--m:#737373;--a:#171717;--af:#fff}
+@media(prefers-color-scheme:dark){:root{--b:#333;--m:#a3a3a3;--a:#fafafa;--af:#171717}}
+body{font:15px/1.45 system-ui,sans-serif;margin:0;padding:24px 16px;max-width:440px;margin-inline:auto}
+h1{font-size:20px;margin:0 0 4px}p{color:var(--m);margin:0 0 16px}label{display:block;font-weight:600;margin:14px 0 6px}
+.n{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1px solid var(--b);border-radius:10px;margin:6px 0;cursor:pointer}
+.n span{margin-left:auto;color:var(--m);font-size:13px}input[type=text],input[type=password]{width:100%;box-sizing:border-box;
+padding:10px 12px;border:1px solid var(--b);border-radius:10px;font:inherit;background:transparent;color:inherit}
+button{margin-top:20px;width:100%;padding:12px;border:0;border-radius:10px;background:var(--a);color:var(--af);font:inherit;font-weight:600}
+small{color:var(--m)}a{color:inherit}.err{color:#dc2626;font-weight:600}</style></head><body>)";
+
+String networkList() {
+  String o;
+  int n = WiFi.scanComplete();
+  if (n == WIFI_SCAN_RUNNING) return F("<p>Scanning for networks… <a href=\"/\">refresh</a></p>");
+  if (n <= 0) {
+    if (n != WIFI_SCAN_RUNNING) WiFi.scanNetworks(true);
+    return F("<p>No networks found yet. <a href=\"/\">Scan again</a></p>");
+  }
+  // strongest first, skip duplicates and hidden networks
+  int idx[40], m = 0;
+  for (int i = 0; i < n && m < 40; i++) {
+    if (WiFi.SSID(i).length() == 0) continue;
+    bool dup = false;
+    for (int j = 0; j < m; j++) if (WiFi.SSID(idx[j]) == WiFi.SSID(i)) { dup = true; break; }
+    if (!dup) idx[m++] = i;
+  }
+  for (int a = 0; a < m; a++)
+    for (int b = a + 1; b < m; b++)
+      if (WiFi.RSSI(idx[b]) > WiFi.RSSI(idx[a])) { int t = idx[a]; idx[a] = idx[b]; idx[b] = t; }
+  for (int k = 0; k < m && k < 15; k++) {
+    int i = idx[k];
+    String ssid = esc(WiFi.SSID(i));
+    bool open = WiFi.encryptionType(i) == WIFI_AUTH_OPEN;
+    bool saved = findNet(WiFi.SSID(i).c_str()) >= 0;
+    o += F("<label class=n><input type=radio name=ssid value=\"");
+    o += ssid;
+    o += saved ? F("\" checked>") : F("\">");
+    o += ssid;
+    o += F("<span>");
+    o += saved ? F("saved · ") : F("");
+    o += open ? F("open · ") : F("");
+    o += String(WiFi.RSSI(i));
+    o += F(" dBm</span></label>");
+  }
+  o += F("<small><a href=\"");
+#ifdef WEB_UI
+  o += F("/wifi/rescan");
+#else
+  o += F("/rescan");
+#endif
+  o += F("\">Scan again</a></small>");
+  return o;
+}
+
+String buildPage(const String& error) {
+  String o = FPSTR(PAGE_HEAD);
+  o += F("<h1>Connect your MeshCore radio to WiFi</h1><p>Node <b>");
+  o += esc(prefs->node_name);
+  o += F("</b>. After saving it restarts, joins your network and can be reached as <b>");
+  o += esc(host);
+  o += F(".local</b>.</p>");
+  if (error.length()) { o += F("<p class=err>"); o += esc(error); o += F("</p>"); }
+  for (int i = 0; i < net_count; i++) {
+    if (!rejected(i)) continue;
+    o += F("<p class=err>");
+    o += esc(nets[i].ssid);
+    o += F(" refused the saved password. Choose it below and enter the right one.</p>");
+  }
+  if (net_count) {   // the radio joins whichever of these it can find; this adds one (or updates it) as the preferred
+    o += F("<p>Saved: ");
+    for (int i = 0; i < net_count; i++) {
+      o += i ? F(", ") : F("");
+      o += esc(nets[i].ssid);
+      if (rejected(i)) o += F(" (password refused)");
+    }
+    o += F(". Choosing one here makes it the preferred network.</p>");
+  }
+  o += F("<form method=post action=\"");
+  o += formAction();
+  o += F("\"><label>Network</label>");
+  o += networkList();
+  o += F("<label for=m>Or type a network name</label><input type=text id=m name=ssid_manual maxlength=32 autocomplete=off>"
+         "<label for=p>Password</label><input type=password id=p name=pwd maxlength=63 autocomplete=off>"
+         "<small>");
+  o += haveSaved() ? F("For a saved network, leave it empty to keep its password. ") : F("");
+  o += F("Leave empty for an open network.</small><label for=h>Hostname</label><input type=text id=h name=host maxlength=32 "
+         "pattern=\"[a-z0-9]([a-z0-9-]*[a-z0-9])?\" value=\"");
+  o += esc(host);
+  o += F("\"><small>Lowercase letters, digits and dashes. MeshChat finds the radio at this name plus .local</small>"
+         "<button>Save and connect</button></form></body></html>");
+  return o;
+}
+
+String formAction() {
+#ifdef WEB_UI
+  return F("/wifi/save");
+#else
+  return F("/save");
+#endif
+}
+
+// returns "" on success (and schedules the restart), otherwise the error to show
+String saveSettings(String ssid, String ssid_manual, String pwd, String h) {
+  ssid_manual.trim();
+  if (ssid_manual.length()) ssid = ssid_manual;
+  h.trim();
+  h.toLowerCase();
+  if (!ssid.length() || ssid.length() > 32) return F("Choose a network or type its name.");
+  if (h.length() && !validHostname(h.c_str())) return F("Hostname: lowercase letters, digits and dashes, up to 32.");
+  char err[80];
+  if (!addNetwork(ssid.c_str(), pwd.c_str(), true, err, sizeof(err))) return String(err);   // added (or updated) as the preferred one
+  if (h.length()) strncpy(prefs->wifi_hostname, h.c_str(), sizeof(prefs->wifi_hostname) - 1);
+  prefs->wifi_hostname[sizeof(prefs->wifi_hostname) - 1] = 0;
+  prefs->wifi_enabled = 1;
+  save();
+  loadHostname();
+  restart_at = millis() + 1500;   // let the reply reach the phone first
+  return "";
+}
+
+String savedPage(const String& ssid) {
+  String o = FPSTR(PAGE_HEAD);
+  o += F("<h1>Saved</h1><p>Restarting and joining <b>");
+  o += esc(ssid);
+  o += F("</b>. Reconnect this device to your usual WiFi. MeshChat can then reach the radio at <b>http://");
+  o += esc(host);
+  o += F(".local</b>.</p><p>If it can't join, the setup hotspot comes back within a minute.</p></body></html>");
+  return o;
+}
+
+#ifndef WEB_UI
+void sendPage(const String& error) {
+  web->sendHeader("Cache-Control", "no-store");
+  web->send(200, "text/html; charset=utf-8", buildPage(error));
+}
+#endif
+
+#ifndef WEB_UI
+void handleSave() {
+  String err = saveSettings(web->arg("ssid"), web->arg("ssid_manual"), web->arg("pwd"), web->arg("host"));
+  if (err.length()) return sendPage(err);
+  web->sendHeader("Connection", "close");
+  web->send(200, "text/html; charset=utf-8", savedPage(prefs->wifi_ssid));
+}
+#endif
+
+void startSetup(bool by_user) {
+  if (mode == SETUP) { forced = forced || by_user; return; }
+  char sfx[8];
+  macSuffix(sfx, sizeof(sfx), true);
+  snprintf(ap_name, sizeof(ap_name), "MeshCore-Setup-%s", sfx);
+  WiFi.mode(haveSaved() ? WIFI_AP_STA : WIFI_AP);   // keep trying the saved network meanwhile
+  if (haveSaved() && !usableCount()) WiFi.disconnect(false);   // wrong password: stop the attempt under way, so the hotspot keeps its channel
+  WiFi.softAP(ap_name, AP_PASSWORD);
+  // One radio for both: a station hunting for an out-of-range network drags the hotspot from
+  // channel to channel, and phones fail to join it. So no automatic reconnects while the hotspot
+  // is up; loop() tries the saved network once a minute, and only while nobody is on the hotspot.
+  // (An attempt already under way, e.g. the first one at boot, still finishes.)
+  WiFi.setAutoReconnect(false);
+  last_retry = millis();
+  delay(100);
+  dns = new DNSServer();
+  dns->setErrorReplyCode(DNSReplyCode::NoError);
+  dns->start(53, "*", WiFi.softAPIP());   // every name resolves to us: phones show the setup page
+  startMdns();   // and <hostname>.local keeps working here (mDNS answers on the hotspot too)
+#ifndef WEB_UI
+  web = new WebServer(80);
+  web->on("/", HTTP_GET, []() { sendPage(""); });
+  web->on("/rescan", HTTP_GET, []() { WiFi.scanDelete(); WiFi.scanNetworks(true); web->sendHeader("Location", "/"); web->send(302); });
+  web->on("/save", HTTP_POST, handleSave);
+  web->onNotFound([]() {   // captive-portal probes (/generate_204, /hotspot-detect.html, …)
+    web->sendHeader("Location", String("http://") + WiFi.softAPIP().toString() + "/");
+    web->send(302);
+  });
+  web->begin();
+#endif
+  WiFi.scanNetworks(true);
+  mode = SETUP;
+  forced = by_user;
+  setup_since = millis();
+}
+
+void stopSetup() {
+  if (mode != SETUP) return;
+  if (web) { web->stop(); delete web; web = nullptr; }
+  if (dns) { dns->stop(); delete dns; dns = nullptr; }
+  WiFi.softAPdisconnect(true);
+  WiFi.mode(WIFI_STA);
+  WiFi.setAutoReconnect(true);
+  mode = STATION;
+  forced = false;
+  if (WiFi.status() == WL_CONNECTED) startMdns(); else joinSaved();
+}
+
+}  // namespace
+
+bool validHostname(const char* h) {
+  size_t n = strlen(h);
+  if (n < 1 || n > 32 || h[0] == '-' || h[n - 1] == '-') return false;
+  for (size_t i = 0; i < n; i++) {
+    char c = h[i];
+    if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-')) return false;
+  }
+  return true;
+}
+
+const char* hostname() { return host; }
+const char* defaultHostname() { return default_host; }
+
+bool isOwnName(const char* h) {   // h without ".local"
+  return strcasecmp(h, host) == 0 || strcasecmp(h, default_host) == 0 || (prev_host[0] && strcasecmp(h, prev_host) == 0);
+}
+
+const char* modeName() {
+  if (mode == SETUP) return "setup";
+  if (mode == OFF) return "off";
+  return WiFi.status() == WL_CONNECTED ? "connected" : "connecting";
+}
+
+int rssi() { return WiFi.status() == WL_CONNECTED ? WiFi.RSSI() : 0; }
+
+void requestSetup() { requested = true; }
+
+bool inSetup() { return mode == SETUP; }
+
+int networkCount() { return net_count; }
+const char* networkSsid(int i) { return i >= 0 && i < net_count ? nets[i].ssid : ""; }
+bool networkHasPassword(int i) { return i >= 0 && i < net_count && nets[i].pwd[0]; }
+const char* connectedSsid() {
+  static char s[33];
+  strncpy(s, WiFi.status() == WL_CONNECTED ? WiFi.SSID().c_str() : "", sizeof(s) - 1);
+  return s;
+}
+
+bool addNetwork(const char* ssid, const char* pwd, bool preferred, char* error, size_t cap) {
+  size_t sl = strlen(ssid), pl = strlen(pwd);
+  if (!sl || sl > 32) { strncpy(error, "Network names are 1-32 bytes.", cap); return false; }
+  if (pl && (pl < 8 || pl > 63)) { strncpy(error, "WiFi passwords are 8 to 63 characters.", cap); return false; }
+  int i = findNet(ssid);
+  if (i < 0) {
+    if (net_count >= MAX_NETS) { strncpy(error, "Eight networks are saved already. Remove one first.", cap); return false; }
+    i = net_count++;
+    strncpy(nets[i].ssid, ssid, sizeof(nets[i].ssid) - 1); nets[i].ssid[32] = 0;
+    nets[i].pwd[0] = 0;
+    nets[i].auth_fails = 0;
+  }
+  if (pl) { strncpy(nets[i].pwd, pwd, sizeof(nets[i].pwd) - 1); nets[i].pwd[63] = 0; nets[i].auth_fails = 0; }   // empty: keep the saved one
+  if (preferred && i > 0) { Net t = nets[i]; for (int k = i; k > 0; k--) nets[k] = nets[k - 1]; nets[0] = t; }
+  prefs->wifi_enabled = 1;
+  saveNets();
+  return true;
+}
+
+bool removeNetwork(const char* ssid) {
+  int i = findNet(ssid);
+  if (i < 0) return false;
+  memset(nets[i].pwd, 0, sizeof(nets[i].pwd));
+  for (int k = i; k < net_count - 1; k++) nets[k] = nets[k + 1];
+  net_count--;
+  memset(&nets[net_count], 0, sizeof(Net));
+  saveNets();
+  return true;
+}
+
+bool preferNetwork(const char* ssid) {
+  int i = findNet(ssid);
+  if (i <= 0) return i == 0;
+  Net t = nets[i];
+  for (int k = i; k > 0; k--) nets[k] = nets[k - 1];
+  nets[0] = t;
+  saveNets();
+  return true;
+}
+bool hasSavedNetwork() { return haveSaved(); }
+
+#ifdef WEB_UI
+void setupPage(char* out, size_t cap, const char* error) {
+  String o = buildPage(error ? String(error) : String());
+  strncpy(out, o.c_str(), cap - 1);
+  out[cap - 1] = 0;
+}
+
+void rescan() { WiFi.scanDelete(); WiFi.scanNetworks(true); }
+
+bool applySetup(const char* ssid, const char* pwd, const char* host_in, char* error, size_t error_cap) {
+  String err = saveSettings(String(ssid), String(""), String(pwd), String(host_in));
+  strncpy(error, err.c_str(), error_cap - 1);
+  error[error_cap - 1] = 0;
+  return err.length() == 0;
+}
+#endif   // acted on in loop(), not inside the CLI handler
+
+void hostnameChanged() {
+  if (strcmp(prev_host, host) != 0) strncpy(prev_host, host, sizeof(prev_host) - 1);   // keep the old name answering until restart
+  loadHostname();
+  WiFi.setHostname(host);   // DHCP name: used from the next (re)connect
+  if (mode == SETUP || WiFi.status() == WL_CONNECTED) startMdns();   // on the hotspot too
+}
+
+void begin(NodePrefs* p, void (*save_prefs)(), uint16_t tcp_port, bool force_setup) {
+  prefs = p;
+  save = save_prefs;
+  port = tcp_port;
+  boot_ms = millis();
+  WiFi.persistent(false);   // credentials live in our file and MeshCore's prefs, not the ESP32's NVS
+  loadHostname();
+  loadNets();
+  WiFi.onEvent([](WiFiEvent_t e, WiFiEventInfo_t info) {
+    if (e == ARDUINO_EVENT_WIFI_STA_GOT_IP) ev_got_ip = true;
+    else if (e == ARDUINO_EVENT_WIFI_STA_DISCONNECTED || e == ARDUINO_EVENT_WIFI_STA_LOST_IP) {
+      ev_lost = true;
+      if (e == ARDUINO_EVENT_WIFI_STA_DISCONNECTED && passwordRefused(info.wifi_sta_disconnected.reason) && ev_auth_fails < 255) ev_auth_fails++;
+    }
+  });
+  if (!prefs->wifi_enabled && !force_setup) { mode = OFF; return; }
+  WiFi.setHostname(host);   // must precede WiFi.mode()/begin()
+  WiFi.mode(WIFI_STA);
+  WiFi.setAutoReconnect(true);
+  mode = STATION;
+  joinSaved();
+  if (force_setup || !haveSaved()) startSetup(force_setup);
+}
+
+void loop() {
+  if (mode == OFF && !requested) return;
+  uint32_t now = millis();
+  if (restart_at && (int32_t)(now - restart_at) > 0) ESP.restart();
+
+  if (ev_auth_fails) {
+    uint8_t n = ev_auth_fails;
+    ev_auth_fails = 0;
+    int i = findNet(trying);
+    if (i >= 0) nets[i].auth_fails = (uint8_t)min(255, nets[i].auth_fails + n);
+  }
+  if (ev_got_ip) {
+    ev_got_ip = false;
+    ever_connected = true;
+    lost_since = 0;
+    int i = findNet(WiFi.SSID().c_str());
+    if (i >= 0) nets[i].auth_fails = 0;
+    if (mode == SETUP && !forced) stopSetup();   // the saved network came back: no need for setup
+    else if (mode != SETUP) startMdns();
+  }
+  if (ev_lost) {
+    ev_lost = false;
+    if (!lost_since) lost_since = now;
+    // mDNS keeps running: the component stops answering on the lost interface by itself
+  }
+  if (requested) {
+    requested = false;
+    if (mode == OFF) { WiFi.setHostname(host); WiFi.mode(WIFI_STA); mode = STATION; }
+    startSetup(true);
+  }
+
+  pickFromScan();   // a scan for joining finished: pick the network
+
+  if (mode == SETUP) {
+    dns->processNextRequest();
+    if (web) web->handleClient();
+    if (haveSaved() && WiFi.status() != WL_CONNECTED && WiFi.softAPgetStationNum() == 0 && since(last_retry) > SETUP_RETRY_EVERY) {
+      joinSaved();   // back in range? (ev_got_ip then closes an automatic hotspot)
+    }
+    if (!forced && haveSaved() && since(setup_since) > AUTO_SETUP_LIMIT && WiFi.softAPgetStationNum() == 0) {
+      // nobody came to set it up: go back to trying the saved networks, refused ones included (the
+      // router's password may be back, or those were handshake timeouts on a weak signal). A wrong
+      // password is refused again within seconds and the hotspot comes straight back.
+      for (int i = 0; i < net_count; i++) nets[i].auth_fails = 0;
+      stopSetup();
+      setup_since = now;
+      boot_ms = now; ever_connected = false;
+    }
+    return;
+  }
+
+  if (mode == STATION && WiFi.status() != WL_CONNECTED) {
+    if (haveSaved() && !usableCount()) { startSetup(false); return; }   // wrong password: no point waiting out the timeouts
+    if (!ever_connected && since(boot_ms) > JOIN_TIMEOUT) { startSetup(false); return; }
+    if (lost_since && ever_connected && since(lost_since) > LOST_TIMEOUT) { startSetup(false); return; }
+    if (since(last_retry) > RETRY_EVERY) joinSaved();
+  }
+}
+
+}  // namespace wifinet
+#endif
