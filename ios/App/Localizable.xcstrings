    "Leaves the channel on your radio, freeing its slot, and deletes its messages from this iPhone. You can join it again any time." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opustí kanál ve vašem rádiu, uvolní jeho slot a smaže jeho zprávy z tohoto iPhonu. Kdykoli se můžete připojit znovu."
          }
        },
        "pl" : {
          "stringUnit" : {
