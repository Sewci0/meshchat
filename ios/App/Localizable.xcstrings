    "Erases its identity key, contacts, channels and settings. Others will see you as a new node and must add you again, and the Bluetooth PIN goes back to 123456. This can't be undone." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vymaže jeho identitní klíč, kontakty, kanály a nastavení. Ostatní vás uvidí jako nový uzel a budou si vás muset přidat znovu a PIN pro Bluetooth se vrátí na 123456. Tuto akci nelze vrátit zpět."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymazuje klucz tożsamości, kontakty, kanały i ustawienia. Inni zobaczą cię jako nowy węzeł i będą musieli dodać cię ponownie, a PIN Bluetooth wróci do 123456. Tego nie da się cofnąć."
          }
        }
      }
    },
    "Erase…" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vymazat…"
          }
        },
