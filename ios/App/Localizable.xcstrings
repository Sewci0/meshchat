    "Login refused: it needs a password (or a different one)." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlášení odmítnuto: je potřeba heslo (nebo jiné heslo)."
          }
