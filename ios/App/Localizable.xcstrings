          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od %@ nic nie słychać bezpośrednio od niego, a dotarło w tym czasie pakietów: %lld (zwykle około %lld byłoby jego). Twoje wiadomości mogą nie docierać."
          }
        }
