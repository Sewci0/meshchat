    "It isn't adding new nodes it hears. Let it replace the ones unheard longest, or tidy the list now." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rádio nepřidává nové uzly, které slyší. Nechte ho nahrazovat ty nejdéle neslyšené, nebo seznam ukliďte hned."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radio nie dodaje nowych usłyszanych węzłów. Pozwól mu zastępować te najdłużej niesłyszane albo uporządkuj listę teraz."
          }
        }
      }
    },
    "It shares your name and key. Your position is not included." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílí vaše jméno a klíč. Poloha v něm není."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
