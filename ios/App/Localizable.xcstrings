    "Bigger hashes tell repeaters apart better but fit fewer hops in a packet. Everyone on your network should use the same." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Větší hashe lépe rozliší repeatery, ale do paketu se vejde méně hopů. Všichni ve vaší síti by měli používat stejnou velikost."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większe hashe lepiej rozróżniają repeatery, ale w pakiecie mieści się mniej hopów. Wszyscy w twojej sieci powinni używać tego samego rozmiaru."
          }
        }
      }
    },
