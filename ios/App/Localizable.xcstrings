          }
        }
      }
    },
    "With %lld-byte IDs a route can hold %lld hops (%lld bytes of path); only 256 IDs, so repeaters often share one." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
