    "With %lld-byte IDs a route can hold %lld hops (%lld bytes of path)." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S %lldbajtovými ID se do trasy vejde až %lld hopů (%lld B cesty)."
          }
        },
        "en" : {
          "stringUnit" : {
