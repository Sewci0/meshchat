@@ -0,0 +1,47 @@
+#pragma once
+// WiFi for the companion radio with runtime setup (MeshChat addition, not upstream MeshCore).
+//  - joins the saved network and announces <hostname>.local (mDNS, _meshcore._tcp)
+//  - opens a "MeshCore-Setup-XXXX" hotspot with a setup page when there is no saved network,
+//    when it can't be joined, when the user button is held at power-up, or on request (CLI)
+//  - <hostname>.local keeps answering on the hotspot too, so bookmarks and the home-screen app work there
+#ifdef WIFI_PORTAL
+#include <stddef.h>
+#include <stdint.h>
+
+class NodePrefs;
+
+namespace wifinet {
+  // force_setup: open the setup hotspot now (button held at boot); it stays until saved
+  void begin(NodePrefs* prefs, void (*save_prefs)(), uint16_t tcp_port, bool force_setup);
+  void loop();
+  void requestSetup();           // CLI "set wifi.setup"
+  void hostnameChanged();        // re-announce with the new name
+  bool validHostname(const char* h);
+  const char* hostname();
+  const char* defaultHostname();   // built-in meshcore-xxxx, always answered as well (bookmarks survive renames)
+  bool isOwnName(const char* h);   // h (without .local) is one of the names this radio answers to
+  const char* modeName();        // "connected", "connecting", "setup", "off"
+  int rssi();                    // dBm, 0 when not connected
+  bool inSetup();
+  bool hasSavedNetwork();        // a home network is configured (the hotspot is then a fallback, not first setup)
+
+  // Saved networks: up to 8, most preferred first. The radio joins the most preferred one in range
+  // with a usable signal, otherwise the strongest one in range. Passwords never leave the radio.
+  // Changes: main task only.
+  int networkCount();
+  const char* networkSsid(int i);
+  bool networkHasPassword(int i);
+  const char* connectedSsid();   // "" when not connected
+  // adds or updates (an empty password keeps the saved one); preferred: move it to the top
+  bool addNetwork(const char* ssid, const char* pwd, bool preferred, char* error, size_t error_cap);
+  bool removeNetwork(const char* ssid);
+  bool preferNetwork(const char* ssid);
+#ifdef WEB_UI
+  // In web-UI builds the setup page is served by the web UI's server at /wifi (one server on :80)
+  void setupPage(char* out, size_t cap, const char* error);   // full HTML page
+  void rescan();
+  // validates; on success stores ssid/password/hostname, saves and restarts shortly. Main task only.
+  bool applySetup(const char* ssid, const char* pwd, const char* host, char* error, size_t error_cap);
+#endif
+}
+#endif
