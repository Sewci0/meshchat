    },
    "MeshChat disconnects from the radio in use and connects to this one." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat se odpojí od používaného rádia a připojí se k tomuto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat rozłączy się z używanym radiem i połączy z tym."
          }
        }
      }
    },
    "MeshChat isn't allowed to use Bluetooth." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat nemá povoleno používat Bluetooth."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat nie ma pozwolenia na używanie Bluetooth."
          }
        }
      }
    },
    "MeshChat isn't allowed to use Bluetooth. Turn it on in Settings → MeshChat." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat nemá povoleno používat Bluetooth. Zapněte ho v Nastavení → MeshChat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat nie ma pozwolenia na Bluetooth. Włącz je w Ustawienia → MeshChat."
          }
        }
      }
    },
    "MeshChat keeps its history on this iPhone and needs no internet: everything comes from your radio. Only map tiles you haven't kept offline are fetched online." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat uchovává historii v tomto iPhonu a nepotřebuje internet: všechno přichází z vašeho rádia. Online se stahují jen mapové dlaždice, které nemáte uložené offline."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat trzyma historię na tym iPhonie i nie potrzebuje internetu: wszystko pochodzi z twojego radia. Z internetu pobierane są tylko kafelki mapy, których nie masz zapisanych offline."
          }
        }
      }
    },
    "MeshChat sets it when it connects. Messages carry the time they were sent, so a wrong clock shows them out of order for others." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat je nastavuje při připojení. Zprávy nesou čas odeslání, takže se při špatně jdoucích hodinách ostatním zobrazí mimo pořadí."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat ustawia go przy połączeniu. Wiadomości niosą czas wysłania, więc przy złym zegarze inni widzą je w złej kolejności."
          }
        }
      }
    },
    "MeshCore has no “leave” message: the room keeps sending new posts while your radio confirms them, so after leaving MeshChat ignores them." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshCore nemá zprávu „odejít“: místnost posílá nové příspěvky dál, dokud je vaše rádio potvrzuje, takže je MeshChat po opuštění ignoruje."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshCore nie ma wiadomości „opuść”: pokój wysyła nowe wpisy, dopóki radio je potwierdza, więc po opuszczeniu MeshChat je ignoruje."
          }
        }
      }
    },
