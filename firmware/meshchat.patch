+      Lock l;
+      actions.push_back(a);
+      for (int i = 0; i < chan_count; i++) if (chans[i].idx == idx) { chans[i] = chans[--chan_count]; break; }
+      stateJson(*b);
+    }
+    sendBuf(r, b);
+  });
+  json("/api/home", [](AsyncWebServerRequest* r, JsonObject o) {
+    double lat = o["lat"] | 999.0, lon = o["lon"] | 999.0;
+    if (lat < -90 || lat > 90 || lon < -180 || lon > 180) { r->send(400, "text/plain", "bad coordinates"); return; }
+    Action a = {}; a.type = A_HOME; a.lat = lat; a.lon = lon;
+    queueAction(a);
+    char out[96]; snprintf(out, sizeof(out), "{\"lat\":%.6f,\"lon\":%.6f,\"label\":\"Home\"}", lat, lon);
+    r->send(200, "application/json", out);
+  });
+  json("/api/time", [](AsyncWebServerRequest* r, JsonObject o) {   // the browser's clock, if the radio's is behind
+    uint32_t t = o["now"] | 0u;
+    if (t > 1700000000) { Action a = {}; a.type = A_TIME; a.a = t; queueAction(a); }
+    r->send(200, "application/json", "{\"ok\":true}");
+  });
+  // registered before /api/listening: routes match by prefix and the first one registered wins
+  server.on("/api/listening/samples", HTTP_GET, [](AsyncWebServerRequest* r) {   // unreadable channel packets, raw
+    if (!guard(r, false)) return;
+    auto b = std::make_shared<Buf>();
+    b->raw("[");
+    Lock l;
+    bool first = true;
+    for (int i = 0; i < MAX_SAMPLES; i++) {
+      Sample& x = samples[i];
+      if (!x.used) continue;
+      b->f("%s{\"ts\":%u,\"hash\":\"%02x\",\"payload\":", first ? "" : ",", x.ts, x.pay[0]);
+      first = false;
+      b->hex(x.pay, x.len);
+      b->raw("}");
+    }
+    b->raw("]");
+    sendBuf(r, b);
+  });
+  server.on("/api/listening", HTTP_GET, [](AsyncWebServerRequest* r) {
+    if (!guard(r, false)) return;
+    auto b = std::make_shared<Buf>();
+    b->raw("{\"listening\":[");
+    Lock l;
+    bool first = true;
+    for (int i = 0; i < MAX_WATCH; i++) {
+      Watch& w = watches[i];
+      if (!w.used) continue;
+      b->raw(first ? "{\"name\":" : ",{\"name\":"); first = false;
+      b->str(w.name);
+      b->f(",\"hash\":\"%02x\",\"found\":%s,\"count\":%u,\"last\":%u}", w.hash, w.found ? "true" : "false", w.count, w.last);
+    }
+    b->raw("],\"unreadable\":[");
+    first = true;
+    for (int h = 0; h < 256; h++) {
+      if (!chan_stats[h].count) continue;
+      b->f("%s{\"hash\":\"%02x\",\"count\":%u,\"last\":%u}", first ? "" : ",", h, chan_stats[h].count, chan_stats[h].last);
+      first = false;
+    }
+    b->f("],\"since\":%u,\"max\":%d}", (unsigned)(time(nullptr) > 1700000000 ? time(nullptr) - millis() / 1000 : 0), MAX_WATCH);
+    sendBuf(r, b);
+  });
+  json("/api/listening", [](AsyncWebServerRequest* r, JsonObject o) {   // POST {name, remove?}
+    String n = o["name"] | "";
+    n.trim();
+    bool remove = o["remove"] | false;
+    if (!validChannelName(n.c_str())) { r->send(400, "text/plain", "Hashtag channel names start with # and have no spaces (up to 31 bytes)."); return; }
+    int matched = 0;
+    {
+      Lock l;
+      if (remove) { Watch* w = findWatch(n.c_str()); if (w) w->used = 0; }
+      else {
+        Watch* w = addWatch(n.c_str(), false);
+        if (!w) {
+          bool joined = false;
+          for (int i = 0; i < chan_count; i++) if (strcmp(chans[i].name, n.c_str()) == 0) joined = true;
+          r->send(409, "text/plain", joined ? "You've already joined that channel." : "The listening list is full."); return;
+        }
+        matched = replaySamples(w);
+      }
+      saveWatches();
+    }
+    emitListening();
+    char out[48]; snprintf(out, sizeof(out), "{\"ok\":true,\"matched\":%d}", matched);
+    r->send(200, "application/json", out);
+  });
+  json("/api/radio", [](AsyncWebServerRequest* r, JsonObject o) {   // POST {freq MHz, bw kHz, sf, cr}: switch network
+    double freq = o["freq"] | 0.0, bw = o["bw"] | 0.0;
+    int sf = o["sf"] | 0, cr = o["cr"] | 0;
+    // 863-870 MHz (EU SRD band) only, whole channel inside it; the radio's own limits for the rest
+    if (freq - bw / 2000 < 863.0 || freq + bw / 2000 > 870.0 || (bw != 62.5 && bw != 125 && bw != 250) || sf < 5 || sf > 12 || cr < 5 || cr > 8) {
+      r->send(400, "text/plain", "Use a channel inside 863-870 MHz, bandwidth 62.5, 125 or 250 kHz, SF5-12, CR 5-8."); return;
+    }
+    Action a = {}; a.type = A_RADIO; a.lat = freq; a.lon = bw; a.a = (sf << 8) | cr;
+    queueAction(a);
+    r->send(200, "application/json", "{\"ok\":true}");
+  });
+  json("/api/repeaters", [](AsyncWebServerRequest* r, JsonObject o) {   // POST /api/repeaters/<key>/query or /cli
+    String u = r->url();
+    const size_t pre = strlen("/api/repeaters/");
+    if (u.endsWith("/cli")) {   // {command}: run one of its CLI commands (needs an admin login)
+      Action a = {}; a.type = A_CLI;
+      if (u.length() != pre + 64 + strlen("/cli") || !hexToBytes(u.substring(pre, pre + 64).c_str(), a.key, 32)) { r->send(404, "text/plain", "not found"); return; }
+      String c = o["command"] | "";
+      c.trim();
+      if (c.isEmpty() || c.length() > 150 || c.indexOf('\n') >= 0) { r->send(400, "text/plain", "A command is one line, up to 150 characters."); return; }
+      strlcpy(a.text, c.c_str(), sizeof(a.text));
+      c = "";
+      queueAction(a);
+      memset(a.text, 0, sizeof(a.text));
+      r->send(202, "application/json", "{\"ok\":true}");
+      return;
+    }
+    Action a = {}; a.type = A_QUERY;
+    // the key is the 64 hex digits between the prefix and "/query" (hexToBytes wants exactly those)
+    if (!u.endsWith("/query") || u.length() != pre + 64 + strlen("/query") || !hexToBytes(u.substring(pre, pre + 64).c_str(), a.key, 32)) {
+      r->send(404, "text/plain", "not found"); return;
+    }
+    String pwd = o["password"] | "";
+    if (pwd.length() > 15) { r->send(400, "text/plain", "Repeater passwords are up to 15 characters."); return; }
+    if (query_busy) { r->send(409, "text/plain", "Another repeater query is still running. Try again when it's done."); return; }
+    query_busy = true;
+    strlcpy(a.s2, pwd.c_str(), sizeof(a.s2));
+    queueAction(a);
+    r->send(202, "application/json", "{\"started\":true}");
+  });
+  // POST /api/rooms/<key>/join {password?}: log in to a room server (a guest with no password, if it
+  // allows that); the result arrives as a "live" event, like a repeater query.
+  // POST /api/rooms/<key>/leave {}: stop showing its posts.
+  json("/api/rooms", [](AsyncWebServerRequest* r, JsonObject o) {
+    String u = r->url();
+    const size_t pre = strlen("/api/rooms/");
+    Action a = {};
+    bool join = u.endsWith("/join") && u.length() == pre + 64 + strlen("/join");
+    bool leave = u.endsWith("/leave") && u.length() == pre + 64 + strlen("/leave");
+    if ((!join && !leave) || !hexToBytes(u.substring(pre, pre + 64).c_str(), a.key, 32)) { r->send(404, "text/plain", "not found"); return; }
+    {
+      Lock l;
+      char k[65]; hexLower(k, a.key, 32);
+      String needle = String("\"") + k + "\":";
+      const char* at = snap_contacts ? strstr(snap_contacts, needle.c_str()) : nullptr;
+      const char* next = at ? strstr(at + needle.length(), "},\"") : nullptr;
+      const char* type = at ? strstr(at, "\"type\":\"") : nullptr;
+      if (!at || !type || (next && type > next) || strncmp(type + 8, "room\"", 5) != 0) {
+        r->send(404, "text/plain", "That isn't a room server in your contacts."); return;
+      }
+    }
+    if (leave) { a.type = A_ROOM_LEAVE; queueAction(a); r->send(202, "application/json", "{\"ok\":true}"); return; }
+    String pwd = o["password"] | "";
+    if (pwd.length() > 15) { r->send(400, "text/plain", "Room passwords are up to 15 characters."); return; }
+    if (query_busy) { r->send(409, "text/plain", "A repeater or room login is still running. Try again when it's done."); return; }
+    query_busy = true;
+    a.type = A_QUERY;
+    strlcpy(a.s2, pwd.c_str(), sizeof(a.s2));
+    queueAction(a);
+    pwd = "";
+    r->send(202, "application/json", "{\"started\":true}");
+  });
+  json("/api/device/wifi/hostname", [](AsyncWebServerRequest* r, JsonObject o) {
+    String h = o["hostname"] | "";
+    h.trim(); h.toLowerCase();
+#ifdef WIFI_PORTAL
+    if (!wifinet::validHostname(h.c_str())) { r->send(400, "text/plain", "Use lowercase letters, digits and dashes (up to 32), not starting or ending with a dash."); return; }
+#endif
+    Action a = {}; a.type = A_HOSTNAME; strlcpy(a.s1, h.c_str(), sizeof(a.s1));
+    queueAction(a);
+    char out[160]; snprintf(out, sizeof(out), "{\"supported\":true,\"mode\":\"connected\",\"hostname\":\"%s\"}", a.s1);
+    r->send(200, "application/json", out);
+  });
+  // POST /api/device/wifi/networks {ssid, password, connect} · …/networks/remove {ssid} · …/networks/prefer {ssid}
+  json("/api/device/wifi/networks", [](AsyncWebServerRequest* r, JsonObject o) {
+    String u = r->url(), ssid = o["ssid"] | "", pwd = o["password"] | "";
+    Action a = {};
+    if (!ssid.length() || ssid.length() > 32) { r->send(400, "text/plain", "Network names are 1-32 bytes."); return; }
+    strlcpy(a.s1, ssid.c_str(), sizeof(a.s1));
+    if (u.endsWith("/remove")) a.type = A_NET_REMOVE;
+    else if (u.endsWith("/prefer")) a.type = A_NET_PREFER;
+    else if (u == "/api/device/wifi/networks") {
+      if (pwd.length() && (pwd.length() < 8 || pwd.length() > 63)) { r->send(400, "text/plain", "WiFi passwords are 8 to 63 characters."); return; }
+      bool known = false;
+      for (int i = 0; i < wifinet::networkCount(); i++) if (ssid == wifinet::networkSsid(i)) known = true;
+      if (!known && wifinet::networkCount() >= 8) { r->send(409, "text/plain", "Eight networks are saved already. Remove one first."); return; }
+      a.type = A_NET_ADD; a.a = (o["connect"] | false) ? 1 : 0;
+      strlcpy(a.s2, pwd.c_str(), sizeof(a.s2));
+    } else { r->send(404, "text/plain", "not found"); return; }
+    queueAction(a);
+    r->send(200, "application/json", a.type == A_NET_ADD && a.a ? "{\"ok\":true,\"rebooting\":true}" : "{\"ok\":true}");
+  });
+  json("/api/device/wifi/join", [](AsyncWebServerRequest* r, JsonObject o) {
+    String ssid = o["ssid"] | "", pwd = o["password"] | "";
+    ssid.trim();
+    if (!ssid.length() || ssid.length() > 32) { r->send(400, "text/plain", "Network name must be 1-32 bytes."); return; }
+    if (pwd.length() && (pwd.length() < 8 || pwd.length() > 63)) { r->send(400, "text/plain", "WiFi passwords are 8 to 63 characters."); return; }
+    Action a = {}; a.type = A_JOIN; strlcpy(a.s1, ssid.c_str(), sizeof(a.s1)); strlcpy(a.s2, pwd.c_str(), sizeof(a.s2));
+    queueAction(a);
+    r->send(200, "application/json", "{\"ok\":true,\"rebooting\":true}");
+  });
+  json("/api/device/wifi/setup", [](AsyncWebServerRequest* r, JsonObject) {
+#ifdef WIFI_PORTAL
+    wifinet::requestSetup();
+#endif
+    r->send(200, "application/json", "{\"ok\":true}");
+  });
+  json("/api/device/ble-pin", [](AsyncWebServerRequest* r, JsonObject o) {
+    String pin = o["pin"] | "";
+    if (pin.length() != 6 || pin.toInt() < 100000) { r->send(400, "text/plain", "The Bluetooth PIN is 6 digits and can't start with 0."); return; }
+    Action a = {}; a.type = A_PIN; a.a = pin.toInt();
+    queueAction(a);
+    r->send(200, "application/json", "{\"ok\":true,\"note\":\"applies after the radio restarts\"}");
+  });
+  // GET /api/device/firmware: what's running, and where an update would go.
+  // POST /api/device/firmware (multipart, one .bin file): written into the spare app slot while the
+  // radio keeps working. At the end ESP-IDF checks the image (magic byte, chip, SHA-256 digest) and
+  // only then makes it the one to boot, so an interrupted or broken upload leaves the current
+  // firmware running. On success the radio restarts into it (contacts flushed first).
+  server.on("/api/device/firmware", HTTP_GET, [](AsyncWebServerRequest* r) {
+    if (!guard(r, false)) return;
+    const esp_partition_t* run = esp_ota_get_running_partition();
+    const esp_partition_t* next = esp_ota_get_next_update_partition(nullptr);
+    auto b = std::make_shared<Buf>();
+    b->raw("{\"build\":"); b->str(MESHCHAT_BUILD + 15);
+    b->raw(",\"running\":"); b->str(run ? run->label : "?");
+    b->raw(",\"next\":"); b->str(next ? next->label : "?");
+    b->f(",\"slot_size\":%u,\"uploading\":%s,\"received\":%u}", next ? (unsigned)next->size : 0, ota.active ? "true" : "false", (unsigned)ota.bytes);
+    sendBuf(r, b);
+  });
+  server.on("/api/device/firmware", HTTP_POST,
+    [](AsyncWebServerRequest* r) {   // the whole body is in: report how it went
+      Ota done = ota; ota = {};
+      if (done.refused) { r->send(403, "text/plain", "refused: open the radio's own page to update it"); return; }
+      if (!done.ok) { r->send(400, "text/plain", done.error[0] ? done.error : "no firmware received"); return; }
+      char out[96]; snprintf(out, sizeof(out), "{\"ok\":true,\"bytes\":%u,\"ms\":%u}", (unsigned)done.bytes, (unsigned)(millis() - done.started));
+      r->send(200, "application/json", out);
+      Action a = {}; a.type = A_REBOOT; queueAction(a);
+    },
+    [](AsyncWebServerRequest* r, const String&, size_t index, uint8_t* data, size_t len, bool final) {
+      if (index == 0) {
+        ota = {};
+        // same rule as every other change: this page's own origin only (a website can't flash it)
+        if (!hostAllowed(r) || (r->hasHeader("Origin") && r->header("Origin") != "http://" + r->host())) { ota.refused = true; return; }
+        if (Update.isRunning()) Update.abort();
+        if (!Update.begin(UPDATE_SIZE_UNKNOWN, U_FLASH)) { snprintf(ota.error, sizeof(ota.error), "couldn't start: %s", Update.errorString()); return; }
+        ota.active = true; ota.started = millis();
+      }
+      if (!ota.active) return;
+      if (len && Update.write(data, len) != len) {
+        snprintf(ota.error, sizeof(ota.error), "write failed at %u bytes: %s", (unsigned)ota.bytes, Update.errorString());
+        Update.abort(); ota.active = false; return;
+      }
+      ota.bytes += len;
+      if (final) {
+        ota.active = false;
+        if (Update.end(true)) ota.ok = true;   // verified, and set to boot next
+        else snprintf(ota.error, sizeof(ota.error), "Not installed: the file didn't check out (incomplete or damaged). The radio kept its firmware.");
+      }
+    });
+  json("/api/device/reboot", [](AsyncWebServerRequest* r, JsonObject) {
+    Action a = {}; a.type = A_REBOOT; queueAction(a);
+    r->send(200, "application/json", "{\"ok\":true}");
+  });
+
+  // WiFi setup page (on the hotspot, phones land here)
+#ifdef WIFI_PORTAL
+  server.on("/wifi", HTTP_GET, [](AsyncWebServerRequest* r) {
+    std::unique_ptr<char[]> page(new char[12000]);
+    wifinet::setupPage(page.get(), 12000, nullptr);
+    AsyncWebServerResponse* res = r->beginResponse(200, "text/html; charset=utf-8", String(page.get()));
+    res->addHeader("Cache-Control", "no-store");
+    r->send(res);
+  });
+  server.on("/wifi/rescan", HTTP_GET, [](AsyncWebServerRequest* r) { wifinet::rescan(); r->redirect("/wifi"); });
+  server.on("/wifi/save", HTTP_POST, [](AsyncWebServerRequest* r) {
+    if (r->hasHeader("Origin") && r->header("Origin") != "http://" + r->host()) { r->send(403, "text/plain", "cross-origin request refused"); return; }
+    String ssid = r->hasArg("ssid_manual") && r->arg("ssid_manual").length() ? r->arg("ssid_manual") : r->arg("ssid");
+    Action a = {}; a.type = A_JOIN;
+    strlcpy(a.s1, ssid.c_str(), sizeof(a.s1)); strlcpy(a.s2, r->arg("pwd").c_str(), sizeof(a.s2));
+    String h = r->arg("host"); h.trim(); h.toLowerCase();
+    if (h.length() && h != wifinet::hostname()) {
+      if (!wifinet::validHostname(h.c_str())) { r->send(400, "text/plain", "Hostname: lowercase letters, digits and dashes, up to 32."); return; }
+      Action hn = {}; hn.type = A_HOSTNAME; strlcpy(hn.s1, h.c_str(), sizeof(hn.s1)); queueAction(hn);
+    }
+    queueAction(a);
+    r->send(200, "text/html; charset=utf-8",
+      "<!doctype html><meta name=viewport content='width=device-width,initial-scale=1'><body style='font:16px system-ui;padding:24px'>"
+      "<h1>Saved</h1><p>The radio restarts and joins your network. Reconnect this device to your usual WiFi, then open "
+      "<b>http://" + String(h.length() ? h : String(wifinet::hostname())) + ".local</b>.</p>");
+  });
+#endif
+
+  // the app itself: embedded, gzip-compressed, content-hashed assets
+  server.onNotFound([](AsyncWebServerRequest* r) {
+    String url = r->url();
+#ifdef WIFI_PORTAL
+    // Captive portal: a phone joining the hotspot opens this. First setup → the WiFi setup page.
+    // A home network is already saved (the radio is away from it) → MeshChat itself.
+    if (wifinet::inSetup() && !hostAllowed(r)) {
+      r->redirect("http://" + WiFi.softAPIP().toString() + (wifinet::hasSavedNetwork() ? "/" : "/wifi"));
+      return;
+    }
+#endif
+    if (!hostAllowed(r)) { r->send(403, "text/plain", "unexpected Host header"); return; }
+    if (url.startsWith("/api/") || url == "/ws") { r->send(404, "text/plain", "not found"); return; }
+    const WebAsset* a = nullptr;
+    for (size_t i = 0; i < WEB_ASSET_COUNT; i++) if (url == WEB_ASSETS[i].path) { a = &WEB_ASSETS[i]; break; }
+    if (!a && url.substring(url.lastIndexOf('/')).indexOf('.') >= 0) { r->send(404, "text/plain", "not found"); return; }   // a missing file
+    if (!a) a = &WEB_ASSETS[0];   // client-side routes (/c/..., /map, ...) load the app shell (index.html)
+    AsyncWebServerResponse* res = r->beginResponse(200, a->type, a->data, a->len);
+    res->addHeader("Content-Encoding", "gzip");
+    res->addHeader("Cache-Control", a->immutable ? "public, max-age=31536000, immutable" : "no-cache");
+    r->send(res);
+  });
+  server.begin();
+}
