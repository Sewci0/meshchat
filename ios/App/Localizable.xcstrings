    "Radio hears nothing" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rádio nic neslyší"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radio nic nie słyszy"
          }
        }
      }
    },
    "Radio restarting. MeshChat reconnects when it's back, in about 15 seconds." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rádio se restartuje. MeshChat se znovu připojí, až bude zpět, asi za 15 sekund."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radio uruchamia się ponownie. MeshChat połączy się, gdy wróci, za około 15 sekund."
          }
        }
      }
    },
    "Radio status on the lock screen" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
