+  // GET /api/message-info?id=N: everything known about one message, for its Details view. Every copy
+  // the radio heard (same payload fingerprint: one per route it came by, or per repeater that passed
+  // ours on), with signal and raw bytes; the channel and its key kind; what the sender's flags say.
+  // Copies come from the packet log, which is in RAM: only since the last restart.
+  server.on("/api/message-info", HTTP_GET, [](AsyncWebServerRequest* r) {
+    if (!guard(r, false)) return;
+    uint32_t id = r->hasParam("id") ? (uint32_t)r->getParam("id")->value().toInt() : 0;
+    auto b = std::make_shared<Buf>();
+    Lock l;
+    Msg* m = findMsg(id);
+    if (!m || m->deleted) { r->send(404, "text/plain", "no such message"); return; }
+    static const char* KIND[] = {"channel", "dm", "listened"};
+    b->f("{\"id\":%u,\"kind\":\"%s\",\"dir\":\"%s\",\"ts\":%u,\"sender_ts\":%u,\"status\":\"%s\",\"attempts\":%u,\"repeats\":%u,\"sender\":",
+         m->id, KIND[m->kind <= 2 ? m->kind : 0], m->dir ? "out" : "in", m->ts, m->sender_ts, ST_NAME[m->status], m->attempts, m->repeats);
+    b->str(m->sender);
+    b->raw(",\"text\":"); b->str(m->text);
+    b->f(",\"hops\":%d,\"hash_size\":%u,\"path\":", m->hops, m->hash_size);
+    b->hex(m->path, m->path_n);
+    b->f(",\"has_rf\":%s,\"snr\":%.2f,\"rssi\":%d", m->has_rf ? "true" : "false", m->snr4 / 4.0, m->rssi);
+    if (m->fp) b->f(",\"fp\":\"%08x\"", m->fp); else b->raw(",\"fp\":null");
+
+    // the channel, and its key, to read the sender's flags from a copy
+    uint8_t secret[32] = {0}; bool have_secret = false;
+    if (m->kind == 0 || m->kind == 2) {
+      char name[32] = {0}; uint8_t hash = 0;
+      if (m->kind == 0) {
+        for (int k = 0; k < chan_count; k++) if (chans[k].idx == m->chan) {
+          strlcpy(name, chans[k].name, sizeof(name)); hash = chans[k].hash; memcpy(secret, chans[k].secret, 32); have_secret = true;
+        }
+      } else {
+        strlcpy(name, (const char*)m->key, sizeof(name));
+        mesh::Utils::sha256(secret, 16, (const uint8_t*)name, strlen(name));   // hashtag channel: key = SHA-256(name)[:16]
+        uint8_t h[1]; mesh::Utils::sha256(h, 1, secret, 16); hash = h[0]; have_secret = true;
+      }
+      const char* kind = name[0] == '#' ? "hashtag" : strcmp(name, "Public") == 0 ? "public" : "private";
+      b->f(",\"channel\":{\"idx\":%d,\"hash\":\"%02x\",\"key\":\"%s\",\"name\":", m->kind == 0 ? m->chan : -1, hash, kind);
+      b->str(name); b->raw("}");
+    } else {
+      b->raw(",\"peer\":"); b->hex(m->key, 32);
+    }
+
+    // every copy heard, oldest first
+    b->raw(",\"copies\":[");
+    const Pkt* first = nullptr;
+    uint32_t oldest = 0;
+    for (int i = 0; i < pkt_count; i++) {
+      const Pkt* p = &pkts[(pkt_head - pkt_count + i + MAX_PKTS) % MAX_PKTS];
+      if (!oldest) oldest = p->ts;
+      if (!m->fp || p->fp != m->fp) continue;
+      if (!first) first = p;
+      b->f("%s{\"id\":%u,\"ts\":%u,\"after_ms\":%u,\"route\":\"%s\",\"type\":\"%s\",\"hops\":%u,\"hash_size\":%u,\"path\":",
