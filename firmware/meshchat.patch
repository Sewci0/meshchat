+// ---------------------------------------------------------------- live events
+void broadcast(const char* kind, Buf& data) {
+  if (!ws.count()) return;
+  Buf b;
+  b.f("{\"kind\":\"%s\",\"data\":", kind);
+  b.raw(data.p ? data.p : "null", data.p ? data.n : 4);
+  b.raw("}");
+  ws.textAll(b.p, b.n);
+}
+void emitMsg(const Msg* m) { Buf b; msgJson(b, m); broadcast("message", b); }
+void emitStale() { Buf b; b.raw("\"state\""); broadcast("stale", b); }
+void emitWifi() { Buf b; b.raw("\"wifi\""); broadcast("stale", b); }   // the saved networks changed
+
+// ---------------------------------------------------------------- commands to the mesh (main task)
+void queueCmd(Kind kind, uint32_t ctx, const uint8_t* buf, size_t len) {
+  Cmd c;
+  c.kind = kind; c.ctx = ctx; c.len = len > MAX_FRAME_SIZE ? MAX_FRAME_SIZE : len;
+  memcpy(c.buf, buf, c.len);
+  cmds.push_back(c);
+}
+void sendDm(Msg* m, bool reset_path) {
+  ContactInfo* c = mesh->lookupContactByPubKey(m->key, 32);
+  if (!c) { m->status = ST_FAILED; persistUpdate(m); emitMsg(m); return; }
+  if (reset_path) {
+    uint8_t f[33] = {CMD_RESET_PATH};
+    memcpy(&f[1], m->key, 32);
+    queueCmd(K_OTHER, 0, f, 33);
+  }
+  uint8_t f[MAX_FRAME_SIZE];
+  size_t i = 0, tl = strlen(m->text);
+  f[i++] = CMD_SEND_TXT_MSG; f[i++] = 0; f[i++] = m->attempts;
+  memcpy(&f[i], &m->sender_ts, 4); i += 4;
+  memcpy(&f[i], m->key, 6); i += 6;
+  if (i + tl > sizeof(f)) tl = sizeof(f) - i;
+  memcpy(&f[i], m->text, tl); i += tl;
+  m->retry_at = 0;
+  queueCmd(K_SEND_DM, m->id, f, i);
+}
+void sendChan(Msg* m) {
+  uint8_t f[MAX_FRAME_SIZE];
+  size_t i = 0, tl = strlen(m->text);
+  f[i++] = CMD_SEND_CHANNEL_TXT_MSG; f[i++] = 0; f[i++] = m->chan;
+  memcpy(&f[i], &m->sender_ts, 4); i += 4;   // same timestamp on retries: identical packet
+  if (i + tl > sizeof(f)) tl = sizeof(f) - i;
+  memcpy(&f[i], m->text, tl); i += tl;
+  m->retry_at = 0;
+  queueCmd(K_SEND_CH, m->id, f, i);
+}
+
+// ---------------------------------------------------------------- frames from the mesh (main task)
+void reloadChannels() {
+  Lock l;
+  chan_count = 0;
+  for (int i = 0; i < MAX_GROUP_CHANNELS; i++) {
+    ChannelDetails cd;
+    if (!mesh->getChannel(i, cd) || !cd.name[0]) continue;
+    ChanInfo& c = chans[chan_count++];
+    c.idx = i; c.hash = cd.channel.hash[0];
+    memcpy(c.secret, cd.channel.secret, 32);
+    strlcpy(c.name, cd.name, sizeof(c.name));
+  }
+  chans_dirty = false;
+}
+const ChanInfo* chanByIdx(int idx) { for (int i = 0; i < chan_count; i++) if (chans[i].idx == idx) return &chans[i]; return nullptr; }
+
+bool seenAlready(uint8_t kind, uint8_t chan, const uint8_t* key, uint32_t sender_ts, const char* text) {
+  for (int i = msg_count - 1, n = 0; i >= 0 && n < 300; i--, n++) {
+    Msg* m = msgAt(i);
+    if (m->dir == 0 && m->sender_ts == sender_ts && sameConv(m, kind, chan, key) && strcmp(m->text, text) == 0) return true;
+  }
+  return false;
+}
+
+bool fpTaken(uint32_t fp);   // below, with the packet log
+
+bool roomLeft(const uint8_t* key);   // below, with the rooms
+
+void cliAnswer(const uint8_t* prefix, const uint8_t* text, size_t len);   // repeater admin, below
+
+void onContactMsg(const uint8_t* f, size_t len, bool v3) {
+  size_t i = 1;
+  int16_t snr4 = 0;
+  if (v3) { snr4 = (int8_t)f[i]; i += 3; }
+  if (len < i + 12) return;
+  const uint8_t* prefix = &f[i]; i += 6;
+  uint8_t plen = f[i++], txt_type = f[i++];
+  uint32_t ts; memcpy(&ts, &f[i], 4); i += 4;
+  if (txt_type == 1) { cliAnswer(prefix, &f[i], len - i); return; }   // a command's answer, not chat
+  const uint8_t* sig = nullptr;
+  if (txt_type == 2 && len >= i + 4) { sig = &f[i]; i += 4; }
+  char text[MAX_TEXT + 18];
+  copyText(text, sizeof(text), &f[i], len - i);
+  ContactInfo* c = mesh->lookupContactByPubKey(prefix, 6);
+  uint8_t key[32] = {0};
+  if (c) memcpy(key, c->id.pub_key, 32); else memcpy(key, prefix, 6);
+  Lock l;
+  if (seenAlready(1, 0, key, ts, text)) return;
+  Msg* m = newMsg();
+  m->ts = wallNow();
+  m->sender_ts = ts; m->kind = 1; m->dir = 0; memcpy(m->key, key, 32);
+  m->hops = plen == 255 ? -1 : (plen & 0x3F); m->hash_size = plen == 255 ? 1 : (plen >> 6) + 1;
+  m->status = ST_RECEIVED;
+  if (v3 && m->hops == 0) { m->snr4 = snr4; m->has_rf = 1; }
+  // Which packet was it? The companion doesn't say: find a TXT_MSG to us from that sender in the
+  // last 30 s, with the same hop count (and SNR, if direct), that no other message has claimed.
+  // That gives a DM its route and signal too, which the companion only reports for direct ones.
+  for (int q = 0; q < pkt_count && q < 64; q++) {
+    Pkt* p = &pkts[(pkt_head - 1 - q + MAX_PKTS) % MAX_PKTS];
+    if (millis() - p->ms > 30000) break;
+    size_t pn; const uint8_t* pay = rawPayload(p->raw, p->raw_len, pn);
+    if (p->type != 2 || pn < 4 || pay[0] != mesh->self_id.pub_key[0] || pay[1] != key[0]) continue;
+    if (m->hops >= 0 && p->hops != m->hops) continue;
+    if (v3 && m->hops == 0 && p->snr4 != snr4) continue;
+    if (fpTaken(p->fp)) continue;
+    m->fp = p->fp;
+    if (!m->has_rf || !m->path_n) {
+      m->path_n = p->path_n; memcpy(m->path, p->path, p->path_n); m->hash_size = p->hash_size;
+      m->snr4 = p->snr4; m->rssi = p->rssi; m->has_rf = 1;
+    }
+    break;
+  }
+  if (sig && roomLeft(key)) return;   // a room you left: it still pushes new posts (and the radio acknowledges them)
+  if (sig) contacts_dirty = true;     // the room's sync_since moved on: the contacts snapshot carries it
+  const char* who = c ? c->name : "?";
+  char au[9] = {0};
+  if (sig) {   // a room post: signed with the first 4 bytes of its author's key
+    memcpy(m->author, sig, 4); m->has_author = 1;
+    ContactInfo* a = mesh->lookupContactByPubKey(sig, 4);
+    if (a) who = a->name; else if (memcmp(sig, key, 4) == 0) who = c ? c->name : "room"; else { hexLower(au, sig, 4); who = au; }
+  }
+  strlcpy(m->sender, who, sizeof(m->sender));
+  strlcpy(m->text, text, sizeof(m->text));
+  persistMsg(m);
+  emitMsg(m);
+}
+
+void onChannelMsg(const uint8_t* f, size_t len, bool v3) {
+  size_t i = 1;
+  if (v3) i += 3;
+  if (len < i + 7) return;
+  uint8_t chan = f[i++], plen = f[i++];
+  i++;   // txt_type
+  uint32_t ts; memcpy(&ts, &f[i], 4); i += 4;
+  char full[MAX_TEXT + 40];
+  copyText(full, sizeof(full), &f[i], len - i);
+  const char* sep = strstr(full, ": ");
+  char sender[32] = {0};
+  const char* text = full;
+  if (sep && sep - full < 32) { memcpy(sender, full, sep - full); text = sep + 2; }
+  Lock l;
+  if (seenAlready(0, chan, nullptr, ts, text)) return;
+  Msg* m = newMsg();
+  m->ts = wallNow();
+  m->sender_ts = ts; m->kind = 0; m->chan = chan; m->dir = 0;
+  m->hops = plen == 255 ? -1 : (plen & 0x3F); m->hash_size = plen == 255 ? 1 : (plen >> 6) + 1;
+  m->status = ST_RECEIVED;
+  strlcpy(m->sender, sender, sizeof(m->sender));
+  strlcpy(m->text, text, sizeof(m->text));
+  uint32_t h = fnv(ts, full);   // route + signal from the RX log copy of this packet
+  for (int k = 0; k < RF_RING; k++) {
+    if (rf[k].h == h && rf[k].ts == ts) {
+      m->path_n = rf[k].path_n; memcpy(m->path, rf[k].path, rf[k].path_n);
+      m->hash_size = rf[k].hash_size; m->hops = rf[k].hops; m->snr4 = rf[k].snr4; m->rssi = rf[k].rssi; m->has_rf = 1; m->fp = rf[k].fp;
+      break;
+    }
+  }
+  persistMsg(m);
+  emitMsg(m);
+}
