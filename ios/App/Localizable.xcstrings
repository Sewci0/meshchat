    "Floods you send carry this region, so repeaters outside it don't pass them on. Leave it clear to reach everyone." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floody, které odešlete, nesou tento region, takže je repeatery mimo něj nepředávají dál. Chcete-li zastihnout všechny, nechte pole prázdné."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłane przez ciebie floody niosą ten region, więc repeatery spoza niego nie przekazują ich dalej. Zostaw puste, aby docierać do wszystkich."
          }
        }
      }
