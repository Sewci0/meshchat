+void loadSmallState() {
+  if (!SPIFFS.exists("/wu_state.json")) return;
+  File f = SPIFFS.open("/wu_state.json");
+  JsonDocument doc;
+  if (!deserializeJson(doc, f)) {
+    home_lat = doc["lat"] | home_lat; home_lon = doc["lon"] | home_lon;
+    advert_ts = doc["adv_ts"] | 0u; advert_flood = doc["adv_flood"] | false;
+    strlcpy(advert_name, doc["adv_name"] | "", sizeof(advert_name));
+    legacy_net = doc["legacy_net"] | 0;
+  }
+  f.close();
+}
+
+void saveSmallState() {
+  JsonDocument doc;
+  doc["lat"] = home_lat; doc["lon"] = home_lon;
+  doc["adv_ts"] = advert_ts; doc["adv_flood"] = advert_flood; doc["adv_name"] = advert_name;
+  doc["legacy_net"] = legacy_net;
+  File f = SPIFFS.open("/wu_state.json", FILE_WRITE);
+  if (f) { serializeJson(doc, f); f.close(); }
+}
