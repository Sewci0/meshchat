+void* palloc(size_t n) {
+  void* p = heap_caps_calloc(1, n, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+  return p ? p : calloc(1, n);
+}
+
+uint32_t now_s() { return mesh->getRTCClock()->getCurrentTime(); }
+/** Which network the radio is on: frequency, bandwidth and SF (radios on the same three hear each
+ *  other; the coding rate is in each packet's header). Channels, packets and heard nodes are kept
+ *  per network; DMs are shared, being with the same person whichever network carried them. */
+uint16_t curNet() {
+  NodePrefs* np = mesh->getNodePrefs();
+  uint32_t v[3] = {(uint32_t)(np->freq * 1000 + 0.5f), (uint32_t)(np->bw * 1000 + 0.5f), np->sf};
+  uint32_t h = 2166136261u;
+  for (uint32_t x : v) for (int i = 0; i < 4; i++) { h ^= (x >> (8 * i)) & 0xFF; h *= 16777619u; }
+  return (uint16_t)(h ^ (h >> 16));
+}
+uint16_t legacy_net = 0;   // history from before networks were recorded: the network the radio was on then
+
+/** Unix time: from SNTP once the radio is on WiFi, otherwise MeshCore's clock (set by the apps). */
+uint32_t wallNow() { time_t t = time(nullptr); return t > 1700000000 ? (uint32_t)t : now_s(); }
+
+uint32_t fnv(uint32_t ts, const char* text) {
+  uint32_t h = 2166136261u;
+  for (int i = 0; i < 4; i++) { h ^= (ts >> (8 * i)) & 0xFF; h *= 16777619u; }
+  for (const char* c = text; *c; c++) { h ^= (uint8_t)*c; h *= 16777619u; }
+  return h;
+}
+
+void copyText(char* dst, size_t cap, const uint8_t* src, size_t n) {
+  if (n > cap - 1) n = cap - 1;
+  memcpy(dst, src, n);
+  dst[n] = 0;
+  while (n && dst[n - 1] == 0) n--;   // channel text may be zero-padded
+}
+
+// ---------------------------------------------------------------- packets
+// A packet's fingerprint: SHA-256 of its payload (no header or path), first 4 bytes little-endian,
+// which the meshcore Python library calls pkt_hash. Every copy of a packet has the same one,
+// whichever repeaters it came through, so it links a message to all the copies heard.
+uint32_t payloadFp(const uint8_t* pay, size_t len) {
+  uint8_t h[4]; uint32_t v;
+  mesh::Utils::sha256(h, 4, pay, (int)len);
+  memcpy(&v, h, 4);
+  return v;
+}
+
+// Where the payload starts in a raw packet: header, 4 bytes of transport codes on TRANSPORT_*
+// routes, the path length byte, then hops x hash size bytes of path.
+const uint8_t* rawPayload(const uint8_t* raw, size_t n, size_t& plen) {
+  size_t i = 1;
+  if (n < 2) { plen = 0; return raw; }
+  uint8_t route = raw[0] & 3;
+  if (route == 0 || route == 3) i += 4;
+  if (i >= n) { plen = 0; return raw; }
+  uint8_t pl = raw[i++];
+  i += (size_t)(pl & 0x3F) * ((pl >> 6) + 1);
+  if (i > n) { plen = 0; return raw; }
+  plen = n - i;
+  return raw + i;
+}
+
+// ---------------------------------------------------------------- UTF-8
+// Length (1-4) of the well-formed UTF-8 character at s, or 0 if the bytes there aren't one
+// (stray continuation bytes, overlong forms, surrogates, past U+10FFFF, or cut short by the NUL).
+int utf8Len(const unsigned char* s) {
+  unsigned char c = s[0], lo = 0x80, hi = 0xBF;
+  int n;
+  if (c < 0x80) return 1;
+  if (c >= 0xC2 && c <= 0xDF) n = 2;
+  else if (c >= 0xE0 && c <= 0xEF) { n = 3; if (c == 0xE0) lo = 0xA0; else if (c == 0xED) hi = 0x9F; }
+  else if (c >= 0xF0 && c <= 0xF4) { n = 4; if (c == 0xF0) lo = 0x90; else if (c == 0xF4) hi = 0x8F; }
+  else return 0;
+  if (s[1] < lo || s[1] > hi) return 0;            // a NUL here fails too, so we never read past it
+  for (int i = 2; i < n; i++) if (s[i] < 0x80 || s[i] > 0xBF) return 0;
+  return n;
+}
+
+// True if s is the start of a character that the end of the string cut short.
+bool utf8Cut(const unsigned char* s) {
+  int need = s[0] >= 0xF0 && s[0] <= 0xF4 ? 4 : s[0] >= 0xE0 ? 3 : s[0] >= 0xC2 && s[0] <= 0xDF ? 2 : 0;
+  if (!need) return false;
+  int i = 1;
+  while (s[i]) { if (i >= need || s[i] < 0x80 || s[i] > 0xBF) return false; i++; }
+  return i < need;
+}
+
+// ---------------------------------------------------------------- JSON writer into PSRAM
+struct Buf {
+  char* p = nullptr; size_t n = 0, cap = 0;
+  ~Buf() { if (p) free(p); }
+  bool grow(size_t need) {
+    if (n + need + 1 <= cap) return true;
+    size_t nc = cap ? cap * 2 : 4096;
+    while (nc < n + need + 1) nc *= 2;
+    char* np = (char*)heap_caps_realloc(p, nc, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!np) np = (char*)realloc(p, nc);
+    if (!np) return false;
+    p = np; cap = nc;
+    return true;
+  }
+  void raw(const char* s, size_t len) { if (grow(len)) { memcpy(p + n, s, len); n += len; p[n] = 0; } }
+  void raw(const char* s) { raw(s, strlen(s)); }
+  void f(const char* fmt, ...) {
+    char tmp[192];
+    va_list a; va_start(a, fmt); int k = vsnprintf(tmp, sizeof(tmp), fmt, a); va_end(a);
+    if (k > 0) raw(tmp, (size_t)k < sizeof(tmp) ? (size_t)k : sizeof(tmp) - 1);
+  }
+  // Mesh text is untrusted, and not always valid UTF-8: names arrive cut off mid-emoji (the
+  // sender's 32-byte name field, or ours), and anyone can transmit arbitrary bytes. Escape what
+  // JSON requires and emit only well-formed UTF-8, or strict clients reject the whole response.
+  void str(const char* s) {
+    raw("\"", 1);
+    for (const unsigned char* c = (const unsigned char*)s; *c;) {
+      switch (*c) {
+        case '"': raw("\\\"", 2); c++; continue;
+        case '\\': raw("\\\\", 2); c++; continue;
+        case '\n': raw("\\n", 2); c++; continue;
+        case '\r': raw("\\r", 2); c++; continue;
+        case '\t': raw("\\t", 2); c++; continue;
+      }
+      if (*c < 0x20) { f("\\u%04x", *c); c++; continue; }
+      int n = utf8Len(c);
+      if (n) { raw((const char*)c, n); c += n; }
+      else if (utf8Cut(c)) break;               // a character cut off by truncation: drop it
+      else { raw("\xEF\xBF\xBD", 3); c++; }    // anything else: U+FFFD, one per bad byte
+    }
+    raw("\"", 1);
+  }
+  void hex(const uint8_t* b, size_t len) {
+    static const char* h = "0123456789abcdef";
+    raw("\"", 1);
+    for (size_t i = 0; i < len; i++) { char t[2] = {h[b[i] >> 4], h[b[i] & 15]}; raw(t, 2); }
+    raw("\"", 1);
+  }
+};
+
+// Keys go out in lowercase hex, like MeshChat's Python server, packet paths and the public map:
+// the browser matches path prefixes against them. (MeshCore's own toHex writes uppercase.)
+void hexLower(char* dest, const uint8_t* src, size_t len) {
+  static const char* h = "0123456789abcdef";
+  for (size_t i = 0; i < len; i++) { *dest++ = h[src[i] >> 4]; *dest++ = h[src[i] & 15]; }
+  *dest = 0;
+}
+
+bool hexToBytes(const char* s, uint8_t* out, size_t n) {
+  if (strlen(s) != n * 2) return false;
+  for (size_t i = 0; i < n; i++) {
+    auto v = [](char c) -> int { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; };
+    int hi = v(s[2 * i]), lo = v(s[2 * i + 1]);
+    if (hi < 0 || lo < 0) return false;
+    out[i] = (hi << 4) | lo;
+  }
+  return true;
+}
+
+// ---------------------------------------------------------------- message store
+Msg* msgAt(int i) { return &msgs[(msg_head - msg_count + i + MAX_MSGS) % MAX_MSGS]; }   // 0 = oldest
+Msg* findMsg(uint32_t id) {
+  for (int i = msg_count - 1; i >= 0; i--) if (msgAt(i)->id == id) return msgAt(i);
+  return nullptr;
+}
+Msg* newMsg() {
+  Msg* m = &msgs[msg_head];
+  memset(m, 0, sizeof(*m));
+  msg_head = (msg_head + 1) % MAX_MSGS;
+  if (msg_count < MAX_MSGS) msg_count++;
+  m->id = next_msg_id++;
+  m->hops = -1;
+  m->net = curNet();
+  return m;
+}
+/** shown in this network's views: not deleted, and DMs always, channels only from this network */
+bool visible(const Msg* m) { return !m->deleted && (m->kind == 1 || m->net == curNet()); }
+bool sameConv(const Msg* m, uint8_t kind, uint8_t chan, const uint8_t* key) {
+  return m->kind == kind && (kind == 0 ? m->chan == chan : memcmp(m->key, key, 32) == 0);
+}
+
+void convId(Buf& b, const Msg* m) {
+  if (m->kind == 0) b.f("\"chan:%u\"", m->chan);
+  else if (m->kind == 2) { char n[33]; memcpy(n, m->key, 32); n[32] = 0; b.f("\"watch:%s\"", n); }   // names are validated: no quotes
+  else { char h[65]; hexLower(h, m->key, 32); b.f("\"dm:%s\"", h); }
+}
+
+void msgJson(Buf& b, const Msg* m) {
+  b.f("{\"id\":%u,\"ts\":%u,\"sender_ts\":%u,\"conv\":", m->id, m->ts, m->sender_ts);
+  convId(b, m);
+  b.f(",\"direction\":\"%s\",\"sender\":", m->dir ? "out" : "in");
+  b.str(m->sender);
+  b.raw(",\"text\":");
+  b.str(m->text);
+  if (m->hops >= 0) b.f(",\"hops\":%d", m->hops); else b.raw(",\"hops\":null");
+  if (m->path_n) { b.raw(",\"path\":"); b.hex(m->path, m->path_n); b.f(",\"hash_size\":%u", m->hash_size); }
+  else b.f(",\"path\":%s,\"hash_size\":%u", m->has_rf && m->hops == 0 ? "\"\"" : "null", m->hash_size ? m->hash_size : 1);
+  if (m->has_rf) b.f(",\"snr\":%.2f,\"rssi\":%d", m->snr4 / 4.0, m->rssi); else b.raw(",\"snr\":null,\"rssi\":null");
+  if (m->kind == 1 && m->dir == 1 && (m->flood_mask & 0x70)) {   // our DMs: how each try went out, which the ACK answered, the round trip
+    b.raw(",\"tries_flood\":[");
+    for (int k = 0; k < 3 && (m->flood_mask >> (4 + k)) & 1; k++) b.f("%s%s", k ? "," : "", (m->flood_mask >> k) & 1 ? "true" : "false");
+    b.raw("]");
+    if (m->ack_try) b.f(",\"ack_try\":%u,\"rtt_ms\":%u", m->ack_try, m->rtt_ms);
+  }
+  if (m->has_author) { b.raw(",\"author\":"); b.hex(m->author, 4); }
+  b.f(",\"status\":\"%s\",\"repeats\":%u,\"attempts\":%u,\"msg_hash\":null}", ST_NAME[m->status], m->repeats, m->attempts ? m->attempts : 1);
+}
+
+// ---- persistence: two rotating JSON-lines files; updates are appended as small records
+const char* HIST[2] = {"/wu_hist0.jsonl", "/wu_hist1.jsonl"};
+int hist_cur = 0;
+
+void histAppend(const char* line, size_t n) {
+  File f = SPIFFS.open(HIST[hist_cur], FILE_APPEND);
+  if (!f) return;
+  if (f.size() + n > HIST_FILE_CAP) {   // rotate: the older file is dropped
+    f.close();
+    hist_cur ^= 1;
+    SPIFFS.remove(HIST[hist_cur]);
+    f = SPIFFS.open(HIST[hist_cur], FILE_APPEND);
+    if (!f) return;
+  }
+  f.write((const uint8_t*)line, n);
+  f.close();
+}
+
+void persistMsg(const Msg* m) {
+  Buf b;
+  b.f("{\"i\":%u,\"t\":%u,\"s\":%u,\"k\":%u,\"c\":%u,\"d\":%u,\"h\":%d,\"z\":%u,\"n\":%d,\"r\":%d,\"u\":%u,\"x\":%u,\"a\":%u,\"q\":%u,\"y\":",
+      m->id, m->ts, m->sender_ts, m->kind, m->chan, m->dir, m->hops, m->hash_size, m->snr4, m->rssi, m->status, m->repeats, m->attempts, m->has_rf);
+  b.hex(m->key, m->kind ? 32 : 0);
+  b.raw(",\"p\":"); b.hex(m->path, m->path_n);
+  b.raw(",\"f\":"); b.str(m->sender);
+  b.raw(",\"m\":"); b.str(m->text);
+  if (m->has_author) { b.raw(",\"A\":"); b.hex(m->author, 4); }
+  b.f(",\"w\":%u}\n", m->net);
+  histAppend(b.p, b.n);
+}
+void persistDelete(uint32_t id) { char l[32]; int n = snprintf(l, sizeof(l), "{\"X\":%u}\n", id); histAppend(l, n); }
+// a whole conversation: everything in it up to max_id (channels: on that network)
+void persistDeleteConv(uint8_t kind, uint8_t chan, const uint8_t* key, uint16_t net, uint32_t max_id) {
+  Buf b;
+  b.f("{\"XC\":%u,\"k\":%u,\"c\":%u,\"w\":%u,\"y\":", max_id, kind, chan, net);
+  b.hex(key, kind ? 32 : 0);
+  b.raw("}\n");
+  histAppend(b.p, b.n);
+}
+
+void persistUpdate(const Msg* m) {
+  Buf b;
+  b.f("{\"U\":%u,\"u\":%u,\"x\":%u,\"a\":%u,\"h\":%d,\"z\":%u,\"n\":%d,\"r\":%d,\"q\":%u,\"o\":%u,\"g\":%u,\"v\":%u,\"p\":",
+      m->id, m->status, m->repeats, m->attempts, m->hops, m->hash_size, m->snr4, m->rssi, m->has_rf, m->flood_mask, m->ack_try, m->rtt_ms);
+  b.hex(m->path, m->path_n);
+  b.raw("}\n");
+  histAppend(b.p, b.n);
+}
+
+void loadHistory() {
+  // older file first: the one that isn't being appended to
+  size_t s0 = 0, s1 = 0;
+  if (SPIFFS.exists(HIST[0])) { File f = SPIFFS.open(HIST[0]); s0 = f.size(); f.close(); }
+  if (SPIFFS.exists(HIST[1])) { File f = SPIFFS.open(HIST[1]); s1 = f.size(); f.close(); }
+  hist_cur = (s1 && (!s0 || s1 < HIST_FILE_CAP) && s0 >= HIST_FILE_CAP) ? 1 : (s0 ? 0 : (s1 ? 1 : 0));
+  int order[2] = {hist_cur ^ 1, hist_cur};
+  JsonDocument doc;
+  char line[640];
+  for (int o = 0; o < 2; o++) {
+    if (!SPIFFS.exists(HIST[order[o]])) continue;
+    File f = SPIFFS.open(HIST[order[o]]);
+    while (f.available()) {
+      size_t n = f.readBytesUntil('\n', line, sizeof(line) - 1);
+      line[n] = 0;
+      if (!n || deserializeJson(doc, line)) continue;
+      if (doc["X"].is<uint32_t>()) { Msg* m = findMsg(doc["X"]); if (m) m->deleted = 1; continue; }
+      if (doc["XC"].is<uint32_t>()) {
+        uint32_t max_id = doc["XC"]; uint8_t k = doc["k"], c = doc["c"]; uint16_t w = doc["w"];
+        uint8_t key[32] = {0};
+        if (k) hexToBytes(doc["y"] | "", key, 32);
+        for (int i = 0; i < msg_count; i++) {
+          Msg* m = msgAt(i);
+          if (m->id <= max_id && sameConv(m, k, c, key) && (k == 1 || m->net == w)) m->deleted = 1;
+        }
+        continue;
+      }
+      if (doc["U"].is<uint32_t>()) {
+        Msg* m = findMsg(doc["U"]);
+        if (!m) continue;
+        m->status = doc["u"]; m->repeats = doc["x"]; m->attempts = doc["a"]; m->hops = doc["h"]; m->hash_size = doc["z"];
+        m->snr4 = doc["n"]; m->rssi = doc["r"]; m->has_rf = doc["q"];
+        m->flood_mask = doc["o"] | 0; m->ack_try = doc["g"] | 0; m->rtt_ms = doc["v"] | 0u;
+        const char* p = doc["p"] | "";
+        m->path_n = strlen(p) / 2 <= 32 && hexToBytes(p, m->path, strlen(p) / 2) ? strlen(p) / 2 : 0;
+        continue;
+      }
+      Msg* m = newMsg();
+      m->id = doc["i"]; m->ts = doc["t"]; m->sender_ts = doc["s"]; m->kind = doc["k"]; m->chan = doc["c"]; m->dir = doc["d"];
+      m->hops = doc["h"]; m->hash_size = doc["z"]; m->snr4 = doc["n"]; m->rssi = doc["r"]; m->status = doc["u"];
+      m->repeats = doc["x"]; m->attempts = doc["a"]; m->has_rf = doc["q"];
+      m->net = doc["w"] | legacy_net;   // older records: the network the radio was on when this was added
+      const char* y = doc["y"] | "";
+      if (m->kind) hexToBytes(y, m->key, 32);
+      const char* p = doc["p"] | "";
+      size_t pn = strlen(p) / 2;
+      m->path_n = pn <= 32 && hexToBytes(p, m->path, pn) ? pn : 0;
+      strlcpy(m->sender, doc["f"] | "", sizeof(m->sender));
+      strlcpy(m->text, doc["m"] | "", sizeof(m->text));
+      const char* au = doc["A"] | "";
+      m->has_author = strlen(au) == 8 && hexToBytes(au, m->author, 4);
+      if (m->id >= next_msg_id) next_msg_id = m->id + 1;
+      if (m->status == ST_SENDING || m->status == ST_SENT) m->status = m->kind ? ST_NO_ACK : ST_NOT_HEARD;   // retries died with the reboot
+    }
+    f.close();
+  }
+}
